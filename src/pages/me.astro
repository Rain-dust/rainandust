---
import { Content as Readme } from "../content/me/readme.md";
import { meFavorites, meNow, meStack, meXp } from "../data/me";
import BaseLayout from "../layouts/BaseLayout.astro";

const tabs = [
  { id: "readme", label: "README.md" },
  { id: "now", label: "NOW" },
  { id: "favorites", label: "FAVORITES" },
  { id: "xp", label: "XP" },
  { id: "stack", label: "STACK" },
];
---

<BaseLayout
  title="ME / Rain_dust"
  description="寻辰沐雨 / Rain_dust 的个人设定集。"
>
  <main class="me-library" id="main" data-me-book>
    <div class="me-library__desk" aria-hidden="true"></div>

    <section class="me-book" aria-label="Rain_dust 的个人档案">
      <header class="me-book__header">
        <p>PERSONAL FILE / 01</p>
        <span>Rain_dust</span>
      </header>

      <nav class="me-book__tabs" aria-label="档案章节" role="tablist">
        {
          tabs.map((tab, index) => (
            <button
              type="button"
              role="tab"
              id={`me-tab-${tab.id}`}
              aria-controls={`me-panel-${tab.id}`}
              aria-selected={index === 0 ? "true" : "false"}
              tabindex={index === 0 ? "0" : "-1"}
              data-me-tab={tab.id}
            >
              {tab.label}
            </button>
          ))
        }
      </nav>

      <div class="me-book__pages">
        <article
          class="me-spread is-active"
          id="me-panel-readme"
          role="tabpanel"
          aria-labelledby="me-tab-readme"
          data-me-panel="readme"
        >
          <div class="me-page me-page--identity">
            <div class="me-portrait">
              <img
                src="/rain-dust/me/rain-dust-avatar.jpg"
                alt="Rain_dust 的头像"
                width="1262"
                height="1246"
              />
              <span aria-hidden="true">01</span>
            </div>
            <div>
              <p class="me-kicker">ABOUT THIS PERSON</p>
              <h1>寻辰沐雨</h1>
              <p class="me-handle">Rain_dust</p>
              <p class="me-meta">Vibe Coder · INTP · 白羊座</p>
            </div>
          </div>
          <div class="me-page me-page--readme">
            <div class="me-markdown">
              <Readme />
            </div>
            <nav class="me-contact" aria-label="个人链接">
              <a
                href="https://github.com/Rain-dust"
                target="_blank"
                rel="noreferrer"
              >
                GitHub <span>↗</span>
              </a>
              <a href="mailto:1223451146@qq.com">
                1223451146@qq.com <span>↗</span>
              </a>
            </nav>
          </div>
        </article>

        <article
          class="me-spread"
          id="me-panel-now"
          role="tabpanel"
          aria-labelledby="me-tab-now"
          hidden
          data-me-panel="now"
        >
          <div class="me-page me-page--chapter">
            <p class="me-kicker">CURRENT STATUS</p>
            <h2>NOW</h2>
            <p class="me-updated">UPDATED / {meNow.updated}</p>
            <p class="me-chapter-note">最近的状态，不写长期计划。</p>
          </div>
          <div class="me-page me-page--list">
            <ol class="me-now-list">
              {
                meNow.items.map((item, index) => (
                  <li>
                    <span>{String(index + 1).padStart(2, "0")}</span>
                    <div>
                      <strong>{item.label}</strong>
                      <p>{item.value}</p>
                    </div>
                  </li>
                ))
              }
            </ol>
          </div>
        </article>

        <article
          class="me-spread"
          id="me-panel-favorites"
          role="tabpanel"
          aria-labelledby="me-tab-favorites"
          hidden
          data-me-panel="favorites"
        >
          <div class="me-page me-page--favorites">
            <p class="me-kicker">ANIME</p>
            <h2>喜欢的番剧</h2>
            <div class="me-favorite-list">
              {
                meFavorites.anime.map((item) => (
                  <article>
                    <strong>{item.title}</strong>
                    <p>{item.note}</p>
                  </article>
                ))
              }
            </div>
          </div>
          <div class="me-page me-page--favorites">
            <p class="me-kicker">READING</p>
            <h2>小说与网文</h2>
            <div class="me-favorite-list">
              {
                meFavorites.reading.map((item) => (
                  <article>
                    <strong>{item.title}</strong>
                    <p>{item.note}</p>
                  </article>
                ))
              }
            </div>
          </div>
        </article>

        <article
          class="me-spread"
          id="me-panel-xp"
          role="tabpanel"
          aria-labelledby="me-tab-xp"
          hidden
          data-me-panel="xp"
        >
          <div class="me-page me-page--xp-art" aria-hidden="true">
            <span class="me-xp-eye"></span>
            <p>VISUAL<br />PREFERENCE</p>
          </div>
          <div class="me-page me-page--xp">
            <p class="me-kicker">XP / AESTHETIC</p>
            <h2>看着舒服，就够了。</h2>
            <div class="me-xp-words">
              {meXp.map((item, index) => <span>{item}<sup>0{index + 1}</sup></span>)}
            </div>
            <p class="me-xp-note">
              白发、红瞳、侧脸。安静，也有存在感。
            </p>
          </div>
        </article>

        <article
          class="me-spread"
          id="me-panel-stack"
          role="tabpanel"
          aria-labelledby="me-tab-stack"
          hidden
          data-me-panel="stack"
        >
          <div class="me-page me-page--stack">
            <p class="me-kicker">OFTEN USE</p>
            <h2>常用</h2>
            <ul>
              {meStack.often.map((item) => <li>{item}</li>)}
            </ul>
          </div>
          <div class="me-page me-page--stack me-page--stack-dark">
            <p class="me-kicker">EXPLORING</p>
            <h2>正在折腾</h2>
            <ul>
              {meStack.exploring.map((item) => <li>{item}</li>)}
            </ul>
          </div>
        </article>

        <div class="me-book__turn-sheet" aria-hidden="true"></div>
      </div>

      <footer class="me-book__footer">
        <span>ME / PROFILE</span>
        <span data-me-page-number>01 / 05</span>
      </footer>
    </section>
  </main>
</BaseLayout>

<script>
  const book = document.querySelector<HTMLElement>("[data-me-book]");
  const tabButtons = Array.from(
    book?.querySelectorAll<HTMLButtonElement>("[data-me-tab]") ?? [],
  );
  const panels = Array.from(
    book?.querySelectorAll<HTMLElement>("[data-me-panel]") ?? [],
  );
  const turnSheet = book?.querySelector<HTMLElement>(".me-book__turn-sheet");
  const pageNumber = book?.querySelector<HTMLElement>("[data-me-page-number]");
  const reduceMotion = window.matchMedia(
    "(prefers-reduced-motion: reduce)",
  ).matches;
  let activeIndex = 0;
  let isTurning = false;

  const panelIndexFromHash = () => {
    const hash = window.location.hash.slice(1).toLowerCase();
    const index = tabButtons.findIndex((tab) => tab.dataset.meTab === hash);
    return index >= 0 ? index : 0;
  };

  const commitPage = (nextIndex: number, updateHistory = true) => {
    const previousPanel = panels[activeIndex];
    const nextPanel = panels[nextIndex];
    const nextTab = tabButtons[nextIndex];

    previousPanel?.classList.remove("is-active");
    previousPanel?.setAttribute("hidden", "");
    nextPanel?.removeAttribute("hidden");
    nextPanel?.classList.add("is-active");

    tabButtons.forEach((tab, index) => {
      const selected = index === nextIndex;
      tab.setAttribute("aria-selected", String(selected));
      tab.tabIndex = selected ? 0 : -1;
    });

    activeIndex = nextIndex;
    if (pageNumber) {
      pageNumber.textContent = `${String(nextIndex + 1).padStart(2, "0")} / 05`;
    }

    if (updateHistory) {
      const id = nextTab?.dataset.meTab ?? "readme";
      history.pushState(null, "", id === "readme" ? "/me" : `/me#${id}`);
    }
  };

  const showPage = (nextIndex: number, updateHistory = true) => {
    if (nextIndex === activeIndex || isTurning || !panels[nextIndex]) return;

    if (reduceMotion || !turnSheet) {
      commitPage(nextIndex, updateHistory);
      return;
    }

    isTurning = true;
    const direction = nextIndex > activeIndex ? "forward" : "backward";
    turnSheet.className = `me-book__turn-sheet is-turning is-${direction}`;

    window.setTimeout(() => commitPage(nextIndex, updateHistory), 170);
    window.setTimeout(() => {
      turnSheet.className = "me-book__turn-sheet";
      isTurning = false;
    }, 390);
  };

  tabButtons.forEach((tab, index) => {
    tab.addEventListener("click", () => showPage(index));
    tab.addEventListener("keydown", (event) => {
      if (event.key !== "ArrowLeft" && event.key !== "ArrowRight") return;
      event.preventDefault();
      const direction = event.key === "ArrowRight" ? 1 : -1;
      const nextIndex =
        (index + direction + tabButtons.length) % tabButtons.length;
      tabButtons[nextIndex]?.focus();
      showPage(nextIndex);
    });
  });

  window.addEventListener("popstate", () => {
    const nextIndex = panelIndexFromHash();
    if (nextIndex !== activeIndex) showPage(nextIndex, false);
  });

  const initialIndex = panelIndexFromHash();
  if (initialIndex !== 0) commitPage(initialIndex, false);
</script>
