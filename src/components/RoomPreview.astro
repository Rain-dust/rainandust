---
interface Props {
  kind: "blog" | "works" | "me";
  label: string;
  note: string;
}

const { kind, label, note } = Astro.props;
---

<main class:list={["room-preview", `room-preview--${kind}`]} id="main">
  <div class="room-preview__atmosphere" aria-hidden="true"></div>
  <div class="room-preview__copy">
    <p>{label}</p>
    <h1>{note}</h1>
  </div>
</main>
