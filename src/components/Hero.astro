<section
  class="home-hero is-identity-visible"
  id="top"
  aria-labelledby="home-title"
>
  <video
    class="home-hero__video"
    muted
    loop
    autoplay
    playsinline
    preload="auto"
    poster="/rain-dust/home/shadow-home-poster.webp"
    aria-hidden="true"
  >
    <source src="/rain-dust/home/shadow-home-loop.mp4" type="video/mp4" />
  </video>

  <div class="home-hero__wash" aria-hidden="true"></div>

  <div class="home-identity">
    <h1 id="home-title">寻辰沐雨</h1>
    <p class="home-identity__name">Rain_dust</p>
    <p class="home-identity__role">
      <span aria-hidden="true"></span>
      Vibe Coder
    </p>
  </div>
</section>

<script>
  const hero = document.querySelector<HTMLElement>(".home-hero");
  const video = hero?.querySelector<HTMLVideoElement>(".home-hero__video");
  const reduceMotion = window.matchMedia(
    "(prefers-reduced-motion: reduce)",
  ).matches;

  if (hero && video) {
    const syncIdentity = () => {
      const showIdentity = video.currentTime < 2.05;
      hero.classList.toggle("is-identity-visible", showIdentity);
      hero.classList.toggle("is-identity-hidden", !showIdentity);
    };

    if (reduceMotion) {
      video.pause();
      video.currentTime = 0.9;
      hero.classList.add("is-media-static");
    } else {
      const revealVideo = () => {
        hero.classList.add("is-media-ready");
        void video.play().catch(() => {
          hero.classList.add("is-media-static");
        });
      };

      if (video.readyState >= HTMLMediaElement.HAVE_FUTURE_DATA) {
        revealVideo();
      } else {
        video.addEventListener("canplay", revealVideo, { once: true });
      }

      video.addEventListener("timeupdate", syncIdentity);
      video.addEventListener("error", () => {
        hero.classList.add("is-media-static");
      });
    }
  }
</script>
