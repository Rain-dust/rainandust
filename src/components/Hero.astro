<section
  class="home-hero is-identity-visible"
  id="top"
  aria-labelledby="home-title"
>
  <div class="home-hero__stage" aria-hidden="true">
    <video
      class="home-hero__video"
      muted
      loop
      autoplay
      playsinline
      preload="auto"
      poster="/rain-dust/home/shadow-home-poster.webp"
    >
      <source src="/rain-dust/home/shadow-home-loop.mp4" type="video/mp4" />
    </video>
  </div>

  <canvas class="home-hero__dust" aria-hidden="true"></canvas>
  <div class="home-hero__wash" aria-hidden="true"></div>

  <div class="home-identity">
    <h1 id="home-title">寻辰沐雨</h1>
    <p class="home-identity__name">Rain_dust</p>
    <p class="home-identity__role">
      <span aria-hidden="true"></span>
      Vibe Coder
    </p>
    <p class="home-terminal" aria-label="rain at home, npx vibe build">
      <span class="home-terminal__prefix">rain@home:~$</span>
      <span
        class="home-terminal__typing"
        data-terminal-text="npx vibe --build"
      ></span>
      <span class="home-terminal__cursor" aria-hidden="true"></span>
    </p>
  </div>

  <button
    class="home-motion-toggle"
    type="button"
    aria-pressed="false"
    aria-label="播放动态背景"
  >
    <span class="home-motion-toggle__mark" aria-hidden="true">▶</span>
    <span class="home-motion-toggle__label">播放动态</span>
  </button>
</section>

<script>
  const hero = document.querySelector<HTMLElement>(".home-hero");
  const video = hero?.querySelector<HTMLVideoElement>(".home-hero__video");
  const dust = hero?.querySelector<HTMLCanvasElement>(".home-hero__dust");
  const motionToggle = hero?.querySelector<HTMLButtonElement>(
    ".home-motion-toggle",
  );
  const motionMark = motionToggle?.querySelector<HTMLElement>(
    ".home-motion-toggle__mark",
  );
  const motionLabel = motionToggle?.querySelector<HTMLElement>(
    ".home-motion-toggle__label",
  );
  const terminalTyping = hero?.querySelector<HTMLElement>(
    ".home-terminal__typing",
  );
  const reduceMotion = window.matchMedia(
    "(prefers-reduced-motion: reduce)",
  ).matches;

  if (
    hero &&
    video &&
    motionToggle &&
    motionMark &&
    motionLabel &&
    terminalTyping
  ) {
    const syncIdentity = () => {
      const showIdentity = video.currentTime < 3.15;
      hero.classList.toggle("is-identity-visible", showIdentity);
      hero.classList.toggle("is-identity-hidden", !showIdentity);
    };

    const syncMotionControl = () => {
      const isPlaying = !video.paused && !video.ended;
      hero.classList.toggle("is-motion-active", isPlaying);
      hero.classList.toggle("is-motion-paused", !isPlaying);
      motionToggle.setAttribute("aria-pressed", String(isPlaying));
      motionToggle.setAttribute(
        "aria-label",
        isPlaying ? "暂停动态背景" : "播放动态背景",
      );
      motionMark.textContent = isPlaying ? "Ⅱ" : "▶";
      motionLabel.textContent = isPlaying ? "暂停动态" : "播放动态";
    };

    const playVideo = async () => {
      video.defaultMuted = true;
      video.muted = true;

      try {
        await video.play();
        hero.classList.add("is-media-ready");
        hero.classList.remove("is-media-static");
      } catch {
        hero.classList.add("is-media-static");
      }
      syncMotionControl();
    };

    video.defaultMuted = true;
    video.muted = true;
    void playVideo();
    video.addEventListener("canplay", playVideo, { once: true });
    window.addEventListener("pageshow", playVideo);
    document.addEventListener("visibilitychange", () => {
      if (!document.hidden && !hero.classList.contains("is-user-paused")) {
        void playVideo();
      }
    });

    motionToggle.addEventListener("click", () => {
      if (video.paused) {
        hero.classList.remove("is-user-paused");
        void playVideo();
      } else {
        hero.classList.add("is-user-paused");
        video.pause();
        syncMotionControl();
      }
    });

    video.addEventListener("play", syncMotionControl);
    video.addEventListener("pause", syncMotionControl);
    video.addEventListener("timeupdate", syncIdentity);
    video.addEventListener("error", () => {
      hero.classList.add("is-media-ready", "is-media-static");
      syncMotionControl();
    });

    syncMotionControl();

    const terminalText = terminalTyping.dataset.terminalText ?? "";

    if (reduceMotion) {
      terminalTyping.textContent = terminalText;
    } else {
      let terminalIndex = 0;
      const typeNextCharacter = () => {
        terminalIndex += 1;
        terminalTyping.textContent = terminalText.slice(0, terminalIndex);

        if (terminalIndex < terminalText.length) {
          window.setTimeout(typeNextCharacter, 64);
        }
      };

      window.setTimeout(typeNextCharacter, 520);
    }
  }

  if (dust) {
    const context = dust.getContext("2d");

    if (context) {
      const particleCount = window.innerWidth < 680 ? 22 : 42;
      const particles = Array.from({ length: particleCount }, () => ({
        x: Math.random(),
        y: Math.random(),
        radius: 0.45 + Math.random() * 1.15,
        speed: 0.05 + Math.random() * 0.12,
        drift: Math.random() * Math.PI * 2,
        warmth: Math.random() > 0.72,
      }));
      let frameId = 0;
      let width = 0;
      let height = 0;

      const resizeDust = () => {
        const density = Math.min(window.devicePixelRatio || 1, 2);
        width = dust.clientWidth;
        height = dust.clientHeight;
        dust.width = Math.round(width * density);
        dust.height = Math.round(height * density);
        context.setTransform(density, 0, 0, density, 0, 0);
      };

      const drawDust = (time = 0) => {
        context.clearRect(0, 0, width, height);

        for (const particle of particles) {
          const x =
            particle.x * width + Math.sin(time * 0.00018 + particle.drift) * 8;
          const y = particle.y * height;
          context.beginPath();
          context.arc(x, y, particle.radius, 0, Math.PI * 2);
          context.fillStyle = particle.warmth
            ? "rgba(180, 154, 104, 0.36)"
            : "rgba(241, 239, 233, 0.28)";
          context.fill();

          if (!reduceMotion) {
            particle.y -= particle.speed / Math.max(height, 1);
            if (particle.y < -0.02) {
              particle.y = 1.02;
              particle.x = Math.random();
            }
          }
        }

        if (!reduceMotion) {
          frameId = window.requestAnimationFrame(drawDust);
        }
      };

      resizeDust();
      drawDust();
      window.addEventListener("resize", resizeDust);
      window.addEventListener(
        "pagehide",
        () => {
          window.cancelAnimationFrame(frameId);
        },
        { once: true },
      );
    }
  }
</script>
