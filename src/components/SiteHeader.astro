---
const currentPath = Astro.url.pathname.replace(/\/+$/, "") || "/";
const items = [
  { href: "/", icon: "⌂", label: "HOME", note: "front page" },
  { href: "/blog", icon: "▤", label: "BLOG", note: "notes" },
  { href: "/works", icon: "◇", label: "WORKS", note: "projects" },
  { href: "/me", icon: "◎", label: "ME", note: "profile" },
];
---

<header class="portal-shell" data-portal-shell>
  <div class="portal-sensor">
    <button
      class="portal-pull"
      type="button"
      aria-expanded="false"
      aria-controls="portal-navigation"
    >
      <span aria-hidden="true"></span>
      <span class="sr-only">打开页面导航</span>
    </button>

    <nav class="portal-nav" id="portal-navigation" aria-label="页面导航">
      {
        items.map((item) => {
          const isCurrent =
            item.href === "/"
              ? currentPath === "/"
              : currentPath === item.href ||
                currentPath.startsWith(`${item.href}/`);

          return (
            <a
              class:list={["portal-link", { "is-current": isCurrent }]}
              href={item.href}
              aria-current={isCurrent ? "page" : undefined}
            >
              <span class="portal-link__icon" aria-hidden="true">
                {item.icon}
              </span>
              <span class="portal-link__copy">
                <strong>{item.label}</strong>
                <small>{item.note}</small>
              </span>
            </a>
          );
        })
      }
    </nav>
  </div>
</header>

<script>
  const shell = document.querySelector<HTMLElement>("[data-portal-shell]");

  if (shell && shell.dataset.ready !== "true") {
    shell.dataset.ready = "true";

    const pull = shell.querySelector<HTMLButtonElement>(".portal-pull");
    const links = Array.from(
      shell.querySelectorAll<HTMLAnchorElement>(".portal-link"),
    );
    const reduceMotion = window.matchMedia(
      "(prefers-reduced-motion: reduce)",
    ).matches;
    const finePointer = window.matchMedia(
      "(hover: hover) and (pointer: fine)",
    ).matches;
    let closeTimer = 0;
    let touchStartY = 0;

    const open = () => {
      window.clearTimeout(closeTimer);
      shell.classList.add("is-open");
      pull?.setAttribute("aria-expanded", "true");
    };

    const close = () => {
      window.clearTimeout(closeTimer);
      shell.classList.remove("is-open");
      pull?.setAttribute("aria-expanded", "false");
    };

    const closeLater = () => {
      window.clearTimeout(closeTimer);
      closeTimer = window.setTimeout(close, 500);
    };

    if (finePointer) {
      shell.addEventListener("pointerenter", open);
      shell.addEventListener("pointerleave", closeLater);
    }

    pull?.addEventListener("click", () => {
      shell.classList.contains("is-open") ? close() : open();
    });

    shell.addEventListener("focusin", open);
    shell.addEventListener("focusout", (event) => {
      if (!shell.contains(event.relatedTarget as Node | null)) {
        closeLater();
      }
    });

    shell.addEventListener(
      "touchstart",
      (event) => {
        touchStartY = event.changedTouches[0]?.clientY ?? 0;
      },
      { passive: true },
    );

    shell.addEventListener(
      "touchend",
      (event) => {
        const touchEndY = event.changedTouches[0]?.clientY ?? touchStartY;
        if (touchStartY - touchEndY > 28) {
          close();
        }
      },
      { passive: true },
    );

    document.addEventListener("pointerdown", (event) => {
      if (
        shell.classList.contains("is-open") &&
        !shell.contains(event.target as Node)
      ) {
        close();
      }
    });

    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape") {
        close();
        pull?.focus();
      }
    });

    links.forEach((link) => {
      link.addEventListener("click", (event) => {
        const destination = new URL(link.href, window.location.href);
        const current =
          window.location.pathname.replace(/\/+$/, "") || "/";
        const next = destination.pathname.replace(/\/+$/, "") || "/";

        if (current === next) {
          event.preventDefault();
          close();
          return;
        }

        if (
          destination.origin !== window.location.origin ||
          event.metaKey ||
          event.ctrlKey ||
          event.shiftKey ||
          event.altKey
        ) {
          return;
        }

        event.preventDefault();
        close();

        try {
          sessionStorage.setItem("rain-dust:route-transition", "pending");
        } catch {}

        document.documentElement.classList.add("route-transition-leaving");
        window.setTimeout(
          () => window.location.assign(destination.href),
          reduceMotion ? 120 : 270,
        );
      });
    });

    try {
      if (!localStorage.getItem("rain-dust:nav-seen") && !reduceMotion) {
        shell.classList.add("is-first-visit");
        localStorage.setItem("rain-dust:nav-seen", "true");
        window.setTimeout(
          () => shell.classList.remove("is-first-visit"),
          1700,
        );
      }
    } catch {}
  }
</script>
