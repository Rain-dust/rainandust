---
import type { CollectionEntry } from "astro:content";

interface Props {
  projects: CollectionEntry<"projects">[];
}

const { projects } = Astro.props;
---

<section id="works" class="works" aria-labelledby="works-title">
  <header class="works__header">
    <h2 id="works-title">Selected work</h2>
    <p>三件正在留下痕迹的作品。</p>
  </header>

  <div class="project-field" data-project-field>
    <canvas class="project-field__signal" data-signal-canvas aria-hidden="true"></canvas>

    {
      projects.map((project, index) => (
        <article
          class={`project project--${project.data.placement}`}
          data-project
          data-project-index={index}
        >
          <a
            class="project__link"
            href={project.data.url}
            target="_blank"
            rel="noreferrer"
            aria-label={`在 GitHub 打开 ${project.data.title}`}
          >
            <figure class="project__image">
              <img
                src={project.data.image}
                alt={project.data.alt}
                width="1600"
                height="900"
                loading={index === 0 ? "eager" : "lazy"}
                decoding="async"
              />
            </figure>
            <div class="project__copy">
              <h3>{project.data.title}</h3>
              <p>{project.data.description}</p>
            </div>
            <span class="project__node" data-project-node aria-hidden="true"></span>
          </a>
        </article>
      ))
    }

    <p class="project-field__aside">
      作品在这里被看见，细节留在它们自己的世界里。
    </p>
  </div>

  <div class="quiet-index">
    <span>Also made</span>
    <a
      href="https://github.com/Rain-dust/campus-reimburse-kit"
      target="_blank"
      rel="noreferrer"
    >
      Campus Reimburse Kit
    </a>
    <p>校园报销流程工具</p>
  </div>
</section>

<script>
  import { mountSignalFields } from "../scripts/signal-field";

  mountSignalFields();
</script>
