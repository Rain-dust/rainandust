---
import BaseLayout from "./BaseLayout.astro";
import { categoryLabel } from "@/lib/site";

const { frontmatter } = Astro.props;
const title = `${frontmatter.title} | Rain_dust`;
const date = new Intl.DateTimeFormat("zh-CN", {
  year: "numeric",
  month: "2-digit",
  day: "2-digit"
}).format(frontmatter.pubDate);
const updatedDate = frontmatter.updatedDate
  ? new Intl.DateTimeFormat("zh-CN", {
      year: "numeric",
      month: "2-digit",
      day: "2-digit"
    }).format(frontmatter.updatedDate)
  : null;
const headings = (Astro.props.headings ?? [])
  .filter((heading) => heading.depth >= 2 && heading.depth <= 3)
  .map((heading) => ({ ...heading, text: heading.text.replace(/\s*#\s*$/, "").trim() }));
---

<BaseLayout title={title} description={frontmatter.description} isArticlePage>
  <div class="article-shell blog-article-page">
    <article class="article" data-pagefind-body>
      <a class="back-link" href="/blog/">← 回到文章列表</a>
      <header class="article-header">
        <div class="meta-row">
          <span>{categoryLabel[frontmatter.category]}</span>
          <time datetime={frontmatter.pubDate.toISOString()}>{date}</time>
          {updatedDate && <span>更新于 {updatedDate}</span>}
        </div>
        <h1>{frontmatter.title}</h1>
        <p>{frontmatter.description}</p>
        <div class="tag-row" aria-label="Tags">
          {frontmatter.tags.map((tag: string) => <span>#{tag}</span>)}
        </div>
      </header>
      {
        frontmatter.cover && (
          <figure class="article-cover">
            <img
              src={frontmatter.cover}
              alt={frontmatter.coverAlt ?? `${frontmatter.title} 的封面`}
              loading="eager"
            />
          </figure>
        )
      }
      <div class="prose">
        <slot />
      </div>
    </article>
    {
      headings.length > 0 && (
        <aside class="article-toc" aria-label="文章导航" data-pagefind-ignore>
          <p>ON THIS PAGE</p>
          <nav>
            {headings.map((heading) => (
              <a class={`toc-depth-${heading.depth}`} href={`#${heading.slug}`}>
                {heading.text}
              </a>
            ))}
          </nav>
        </aside>
      )
    }
  </div>

  <style>
    .blog-article-page {
      --article-paper: #c9ccca;
      --article-ink: #222625;
      --article-muted: #58605d;
      --article-line: rgba(34, 38, 37, 0.2);
      --article-signal: #763b3f;
      align-items: start;
      color: var(--article-ink);
    }

    .blog-article-page .article {
      min-width: 0;
      background: rgba(218, 221, 218, 0.34);
      border: 1px solid var(--article-line);
      border-radius: 0;
      box-shadow: 18px 22px 0 rgba(46, 52, 50, 0.08);
      backdrop-filter: none;
      -webkit-backdrop-filter: none;
    }

    .blog-article-page .back-link {
      color: var(--article-muted);
      font-family: "Cascadia Code", "Fira Code", Consolas, monospace;
      letter-spacing: 0.06em;
    }

    .blog-article-page .article-header {
      padding-bottom: 34px;
      border-bottom: 1px solid var(--article-line);
    }

    .blog-article-page .article-header h1 {
      max-width: 18ch;
      color: var(--article-ink);
      font-family: "Noto Serif SC", "Songti SC", STSong, SimSun, Georgia, serif;
      font-size: clamp(2.8rem, 4.2vw, 3.8rem);
      font-weight: 400;
      line-height: 1.08;
      letter-spacing: -0.035em;
      text-wrap: balance;
      overflow-wrap: anywhere;
    }

    .blog-article-page .article-header > p {
      max-width: 46rem;
      color: var(--article-muted);
      font-size: 1.02rem;
      line-height: 1.8;
    }

    .blog-article-page :global(.meta-row),
    .blog-article-page :global(.tag-row) {
      color: var(--article-muted);
    }

    .blog-article-page :global(.tag-row span) {
      color: var(--article-muted);
      background: transparent;
      border: 0;
      border-left: 2px solid var(--article-signal);
      border-radius: 0;
    }

    .article-cover {
      margin: 36px 0 52px;
      padding: 9px 9px 0;
      background: rgba(235, 237, 234, 0.32);
      border: 1px solid var(--article-line);
      box-shadow: 12px 14px 0 rgba(46, 52, 50, 0.08);
      transform: rotate(-0.35deg);
    }

    .article-cover img {
      display: block;
      width: 100%;
      max-height: min(68vh, 720px);
      object-fit: cover;
      filter: grayscale(0.86) contrast(0.94);
    }

    .blog-article-page :global(.prose) {
      color: var(--article-ink);
    }

    .blog-article-page :global(.prose p),
    .blog-article-page :global(.prose li) {
      color: #353b39;
      font-family: "Noto Serif SC", "Songti SC", STSong, SimSun, Georgia, serif;
      font-size: 1.02rem;
      line-height: 1.86;
      overflow-wrap: anywhere;
    }

    .blog-article-page :global(.prose h2),
    .blog-article-page :global(.prose h3) {
      color: var(--article-ink);
      font-family: "Noto Serif SC", "Songti SC", STSong, SimSun, Georgia, serif;
      font-weight: 500;
      overflow-wrap: anywhere;
    }

    .blog-article-page :global(.prose img) {
      display: block;
      width: min(100%, 860px);
      height: auto;
      margin: 42px auto;
      padding: 7px;
      background: rgba(236, 238, 235, 0.4);
      border: 1px solid var(--article-line);
      box-shadow: 12px 14px 0 rgba(46, 52, 50, 0.08);
    }

    .blog-article-page :global(.prose blockquote) {
      color: var(--article-muted);
      background: rgba(234, 236, 233, 0.24);
      border-left-color: var(--article-signal);
      border-radius: 0;
    }

    .blog-article-page .article-toc {
      min-width: 0;
      max-height: calc(100dvh - 136px);
      overflow-y: auto;
      color: var(--article-muted);
      background: rgba(211, 214, 211, 0.5);
      border: 1px solid var(--article-line);
      border-radius: 0;
      box-shadow: none;
      backdrop-filter: none;
      -webkit-backdrop-filter: none;
    }

    .blog-article-page .article-toc > p,
    .blog-article-page .article-toc a:hover {
      color: var(--article-signal);
    }

    :global(body:has(.blog-article-page)) {
      color: var(--article-ink);
      background:
        linear-gradient(90deg, transparent 0 9.5%, rgba(36, 40, 39, 0.05) 9.5% calc(9.5% + 1px), transparent calc(9.5% + 1px)),
        #c9ccca;
    }

    :global(body:has(.blog-article-page)::before) {
      opacity: 0;
    }

    :global(body:has(.blog-article-page) .site-footer) {
      color: #343837;
      background: #b9bdbb;
      border-top: 1px solid var(--article-line);
    }

    @media (max-width: 980px) {
      .blog-article-page .article-toc {
        display: none;
      }
    }

    @media (max-width: 760px) {
      .blog-article-page .article {
        box-shadow: 8px 10px 0 rgba(46, 52, 50, 0.07);
      }

      .blog-article-page .article-header h1 {
        max-width: none;
        font-size: clamp(2.2rem, 9.5vw, 2.85rem);
        line-height: 1.12;
        letter-spacing: -0.025em;
      }

      .blog-article-page :global(.prose p),
      .blog-article-page :global(.prose li) {
        font-size: 1rem;
        line-height: 1.78;
      }

      .article-cover {
        margin: 28px 0 38px;
      }

      .blog-article-page :global(.prose img) {
        margin: 32px auto;
      }

      .blog-article-page :global(.heading-anchor) {
        display: none;
      }
    }
  </style>
</BaseLayout>
