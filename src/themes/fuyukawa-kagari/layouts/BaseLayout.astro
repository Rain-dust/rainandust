---
import "../styles/theme.css";
import { site } from "@/lib/site";
import { Icon } from "astro-icon/components";
import { ClientRouter } from "astro:transitions";
import ThemePreferenceGate from "@/core/themes/ThemePreferenceGate.astro";
import ThemeLongPressMenu from "@/core/themes/ThemeLongPressMenu.astro";
import ConsoleEasterEgg from "@/core/ConsoleEasterEgg.astro";
import PerformanceProfile from "@/core/PerformanceProfile.astro";
import { kagariAssets } from "../assets";

const ShadowInkDebug = import.meta.env.DEV
  ? (await import("../components/ShadowInkDebug.astro")).default
  : null;
const PageTransitionPrototype = import.meta.env.DEV
  ? (await import("../components/PageTransitionPrototype.astro")).default
  : null;

interface Props {
  title?: string;
  description?: string;
  honorThemePreference?: boolean;
  isArticlePage?: boolean;
}

const {
  title = site.title,
  description = site.description,
  honorThemePreference = true,
  isArticlePage = false
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url);
const pageTone = Astro.url.pathname.startsWith("/projects") || Astro.url.pathname.startsWith("/works")
  ? "architecture"
  : Astro.url.pathname.startsWith("/about") || Astro.url.pathname.startsWith("/me")
    ? "profile"
    : "paper";
const currentNavHref = pageTone === "architecture"
  ? "/projects/"
  : pageTone === "profile"
    ? "/about/"
    : "/";
---

<!doctype html>
<html lang="zh-CN" data-page-tone={pageTone}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <PerformanceProfile />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#fff8ec" />
    <link rel="canonical" href={canonical} />
    <ThemePreferenceGate currentTheme="fuyukawa-kagari" honorPreference={honorThemePreference} />
    <title>{title}</title>
    <ClientRouter />
    <ConsoleEasterEgg />
  </head>
  <body
    data-yuimi-selection-lock={isArticlePage ? undefined : "true"}
    data-yuimi-article-page={isArticlePage ? "true" : undefined}
  >
    <div class="sakura-rain" aria-hidden="true">
      {Array.from({ length: 34 }).map(() => <span></span>)}
    </div>
    <div class="pig-scrollbar" data-pig-scrollbar aria-hidden="true">
      <div class="pig-scrollbar-track">
        <div class="pig-scrollbar-fill"></div>
      </div>
      <div class="pig-scrollbar-pig">
        <span class="pig-scrollbar-snort">哼~ 哼~</span>
        <img src={kagariAssets.scrollPig} alt="" width="56" height="48" />
        <span class="scroll-chibi-layer scroll-chibi-hair" aria-hidden="true"></span>
        <span class="scroll-chibi-layer scroll-chibi-grass" aria-hidden="true"></span>
      </div>
    </div>
    <nav class="custom-context-menu" data-context-menu aria-label="&#x5FEB;&#x6377;&#x83DC;&#x5355;">
      <button type="button" data-context-action="top">&#x2191; &#x56DE;&#x5230;&#x9876;&#x90E8;</button>
      <button type="button" data-context-action="refresh">&#x21BB; &#x5237;&#x65B0;&#x9875;&#x9762;</button>
      <button type="button" data-context-action="home">&#x2302; &#x8FD4;&#x56DE;&#x9996;&#x9875;</button>
      <button type="button" data-context-action="back">&#x2190; &#x540E;&#x9000;</button>
      <button type="button" data-context-action="forward">&#x2192; &#x524D;&#x8FDB;</button>
      <button type="button" data-context-action="copy">&#x29C9; &#x590D;&#x5236;&#x94FE;&#x63A5;</button>
      <button type="button" data-context-action="title">T &#x590D;&#x5236;&#x6807;&#x9898;</button>
      <button type="button" data-context-action="sakura" aria-pressed="true">&#x273F; 樱花雨：开</button>
    </nav>
    <div class="site-shell">
      <header class="site-header" aria-label="Primary">
        <a class="brand" href="/" aria-label={`${site.name} home`}>
          <span>{site.name}</span>
        </a>
        <nav class="nav-links" aria-label="Main navigation">
          {
            site.nav.map((item) => (
              <a
                href={item.href}
                aria-label={`${item.label}: ${item.hint}`}
                aria-current={item.href === currentNavHref ? "page" : undefined}
                data-nav-key={item.label.toLowerCase()}
              >
                <span class="nav-icon" aria-hidden="true"><Icon name={item.icon} /></span>
                <span class="nav-label">{item.label}</span>
                <span class="nav-hint">{item.hint}</span>
              </a>
            ))
          }
        </nav>
      </header>
      <main>
        <slot />
      </main>
      <footer class="site-footer">
        <div class="footer-inner">
          <p class="footer-signature-line">© 2026 BY 寻辰沐雨 / Rain_dust</p>
        </div>
      </footer>
    </div>
    <ThemeLongPressMenu />
    {ShadowInkDebug && <ShadowInkDebug />}
    {PageTransitionPrototype && <PageTransitionPrototype />}

    <script>
      if (import.meta.env.DEV) {
        void import("../lib/page-transition/controller");
      }
    </script>

    <script>
      const pageShellGlobal = window as typeof window & {
        __rainDustPageShellAbort?: AbortController;
      };

      pageShellGlobal.__rainDustPageShellAbort?.abort();
      const pageShellAbort = new AbortController();
      pageShellGlobal.__rainDustPageShellAbort = pageShellAbort;

      const resolvePageTone = (pathname: string) => {
        if (pathname.startsWith("/projects") || pathname.startsWith("/works")) return "architecture";
        if (pathname.startsWith("/about") || pathname.startsWith("/me")) return "profile";
        return "paper";
      };

      const pageShellCriticalCss = `
        .nav-links {
          display: grid !important;
          grid-template-columns: repeat(3, minmax(0, 1fr)) !important;
          width: min(860px, calc(100vw - 84px)) !important;
        }
        .nav-links a {
          justify-content: start !important;
          width: 100% !important;
          min-width: 0 !important;
        }
        .nav-links a:hover:not([aria-current="page"])::after {
          opacity: 0 !important;
          transform: scaleX(0.2) !important;
        }
        @media (max-width: 940px) {
          .nav-links {
            width: min(100%, 520px) !important;
            max-width: calc(100vw - 24px) !important;
            overflow: hidden !important;
          }
        }
        @media (max-width: 520px) {
          .nav-links a {
            justify-content: center !important;
            min-height: 46px !important;
            padding-inline: 4px !important;
          }
        }
      `;

      const ensurePageShellCriticalStyle = () => {
        let style = document.querySelector<HTMLStyleElement>("#rain-dust-page-shell-critical");
        if (!style) {
          style = document.createElement("style");
          style.id = "rain-dust-page-shell-critical";
          style.dataset.astroTransitionPersist = "rain-dust-page-shell-critical";
          document.head.append(style);
        }
        if (style.textContent !== pageShellCriticalCss) style.textContent = pageShellCriticalCss;
      };

      const syncPageShell = () => {
        ensurePageShellCriticalStyle();
        const tone = resolvePageTone(window.location.pathname);
        const currentHref = tone === "architecture"
          ? "/projects/"
          : tone === "profile"
            ? "/about/"
            : "/";

        document.documentElement.dataset.pageTone = tone;
        document.querySelectorAll<HTMLAnchorElement>(".nav-links a[href]").forEach((link) => {
          if (link.getAttribute("href") === currentHref) {
            link.setAttribute("aria-current", "page");
          } else {
            link.removeAttribute("aria-current");
          }
        });
      };

      syncPageShell();
      document.addEventListener("astro:after-swap", syncPageShell, { signal: pageShellAbort.signal });
      document.addEventListener("astro:page-load", syncPageShell, { signal: pageShellAbort.signal });
    </script>

    <script>
      let pigScrollTimer = 0;
      let pigScrollFrame = 0;

      const updatePigScrollbar = () => {
        const pigScrollbar = document.querySelector("[data-pig-scrollbar]");
        if (!pigScrollbar) return;

        const scrollable = document.documentElement.scrollHeight - window.innerHeight;
        const progress = scrollable > 0 ? window.scrollY / scrollable : 0;
        const track = pigScrollbar.querySelector(".pig-scrollbar-track");
        const trackHeight = track?.getBoundingClientRect().height ?? 0;
        const pigY = 20 + progress * trackHeight;
        pigScrollbar.style.setProperty("--scroll-progress", `${Math.min(1, Math.max(0, progress))}`);
        pigScrollbar.style.setProperty("--scroll-percent", `${Math.min(1, Math.max(0, progress)) * 100}%`);
        pigScrollbar.style.setProperty("--pig-y", `${pigY}px`);
        pigScrollbar.classList.add("is-moving");
        window.clearTimeout(pigScrollTimer);
        pigScrollTimer = window.setTimeout(() => {
          pigScrollbar.classList.remove("is-moving");
        }, 260);
      };

      const schedulePigScrollbar = () => {
        if (pigScrollFrame) return;
        pigScrollFrame = window.requestAnimationFrame(() => {
          pigScrollFrame = 0;
          updatePigScrollbar();
        });
      };

      schedulePigScrollbar();
      window.addEventListener("scroll", schedulePigScrollbar, { passive: true });
      window.addEventListener("resize", schedulePigScrollbar);
      document.addEventListener("astro:page-load", schedulePigScrollbar);
      document.addEventListener("astro:after-swap", schedulePigScrollbar);
      window.addEventListener("pageshow", schedulePigScrollbar);

      const musicCacheKey = "yuimi-radio-state-v1";
      const musicAutoplayKey = "yuimi-radio-autoplay-v1";
      const musicSessionAutoplayKey = "yuimi-radio-session-autoplay-v1";
      const createYuimiRadio = () => {
        const audio = new Audio();
        const player = {
          audio,
          tracks: [],
          index: 0,
          seeking: false,
          initialized: false,
          restoreAutoplay: false,
          pendingAutoplay: false,
          elements: {},
          controlAbort: null,
          audioAbort: null,
          unlockAbort: null
        };

        const formatAudioTime = (seconds) => {
          if (!Number.isFinite(seconds)) return "00:00";
          const minute = Math.floor(seconds / 60);
          const second = Math.floor(seconds % 60);
          return `${String(minute).padStart(2, "0")}:${String(second).padStart(2, "0")}`;
        };

        const getMusicState = () => {
          try {
            return JSON.parse(localStorage.getItem(musicCacheKey) ?? "{}");
          } catch {
            return {};
          }
        };

        const isMusicAutoplayEnabled = () => localStorage.getItem(musicAutoplayKey) === "1";
        const isMusicSessionAutoplayEnabled = () => sessionStorage.getItem(musicSessionAutoplayKey) === "1";
        const setMusicSessionAutoplayEnabled = (enabled) => {
          sessionStorage.setItem(musicSessionAutoplayKey, enabled ? "1" : "0");
        };

        const setMusicAutoplayEnabled = (enabled) => {
          localStorage.setItem(musicAutoplayKey, enabled ? "1" : "0");
          window.dispatchEvent(new CustomEvent("yuimi:music-autoplay-change", { detail: { enabled } }));
        };

        const clampVolume = (value, fallback = 0.28) => {
          const volume = Number(value);
          if (!Number.isFinite(volume)) return fallback;
          return Math.min(1, Math.max(0, volume));
        };

        const saveMusicState = () => {
          const currentTrack = player.tracks[player.index];
          if (!currentTrack) return;
          localStorage.setItem(
            musicCacheKey,
            JSON.stringify({
              trackId: currentTrack.id,
              currentTime: audio.currentTime || 0,
              volume: audio.volume,
              paused: player.pendingAutoplay ? false : audio.paused,
              updatedAt: Date.now()
            })
          );
        };

        const queryElements = () => {
          player.elements = {
            toggle: document.querySelector("[data-music-toggle]"),
            prev: document.querySelector("[data-music-prev]"),
            next: document.querySelector("[data-music-next]"),
            volume: document.querySelector("[data-music-volume]"),
            seek: document.querySelector("[data-music-seek]"),
            track: document.querySelector(".music-track"),
            current: document.querySelector("[data-music-current]"),
            duration: document.querySelector("[data-music-duration]"),
            note: document.querySelector("[data-music-note]")
          };
        };

        const updateMusicUi = () => {
          queryElements();
          const { toggle, volume, seek, track, current, duration, note } = player.elements;
          const currentTrack = player.tracks[player.index];
          if (track) track.textContent = currentTrack?.title ?? "Rain_dust Radio";
          if (current) current.textContent = formatAudioTime(audio.currentTime);
          if (duration) duration.textContent = formatAudioTime(audio.duration);
          if (seek && !player.seeking) {
            const progress = audio.duration ? (audio.currentTime / audio.duration) * 100 : 0;
            seek.value = String(progress || 0);
          }
          if (volume) volume.value = String(audio.volume || 0.28);
          if (toggle) toggle.textContent = audio.paused ? "▶" : "Ⅱ";
          if (note && player.tracks.length) note.textContent = `${player.index + 1} / ${player.tracks.length}`;
          document.body.classList.toggle("is-music-playing", !audio.paused);
        };

        const loadMusicTrack = (index, { keepTime = 0, autoplay = false, persist = true } = {}) => {
          if (!player.tracks.length) return;
          player.index = (index + player.tracks.length) % player.tracks.length;
          const track = player.tracks[player.index];
          const nextSrc = new URL(track.src, window.location.origin).href;
          if (audio.src !== nextSrc) {
            audio.src = track.src;
            audio.load();
          }
          const cached = getMusicState();
          audio.volume = Number.isFinite(cached.volume)
            ? clampVolume(cached.volume)
            : clampVolume(player.elements.volume?.value, audio.volume || 0.28);
          audio.addEventListener(
            "loadedmetadata",
            async () => {
              if (keepTime > 0 && keepTime < audio.duration - 1) audio.currentTime = keepTime;
              updateMusicUi();
              if (autoplay) {
                try {
                  await audio.play();
                  player.pendingAutoplay = false;
                } catch {
                  player.pendingAutoplay = true;
                  if (player.elements.note) player.elements.note.textContent = "浏览器需要你点一下播放。";
                }
                updateMusicUi();
              }
            },
            { once: true }
          );
          updateMusicUi();
          if (persist) saveMusicState();
        };

        const initMusicPlayer = async () => {
          queryElements();
          if (player.initialized) {
            updateMusicUi();
            return;
          }

          try {
            const response = await fetch("/themes/fuyukawa-kagari/music/manifest.json", { cache: "no-cache" });
            player.tracks = await response.json();
          } catch {
            player.tracks = [];
          }

          if (!player.tracks.length) {
            if (player.elements.track) player.elements.track.textContent = "暂无歌曲";
            if (player.elements.note) player.elements.note.textContent = "请把 MP3 放入 MUSIC 文件夹。";
            return;
          }

          const cached = getMusicState();
          const cachedIndex = player.tracks.findIndex((track) => track.id === cached.trackId);
          player.index = cachedIndex >= 0 ? cachedIndex : 0;
          audio.volume = Number.isFinite(cached.volume) ? clampVolume(cached.volume) : clampVolume(player.elements.volume?.value);
          player.restoreAutoplay = cached.paused === false && (isMusicAutoplayEnabled() || isMusicSessionAutoplayEnabled());
          player.pendingAutoplay = player.restoreAutoplay;
          loadMusicTrack(player.index, {
            keepTime: Number(cached.currentTime ?? 0),
            autoplay: false,
            persist: false
          });
          if (player.restoreAutoplay && player.elements.note) {
            player.elements.note.textContent = "已恢复进度，点击播放继续。";
          }
          player.initialized = true;
        };

        player.bind = () => {
          queryElements();
          player.controlAbort?.abort();
          player.controlAbort = new AbortController();
          const listenerOptions = { signal: player.controlAbort.signal };

          player.elements.toggle?.addEventListener("click", async () => {
            if (!player.tracks.length) return;
            if (audio.paused) {
              try {
                await audio.play();
                setMusicSessionAutoplayEnabled(true);
                player.pendingAutoplay = false;
              } catch {
                player.pendingAutoplay = true;
                if (player.elements.note) player.elements.note.textContent = "浏览器拦截了自动播放，请再点一次。";
              }
            } else {
              audio.pause();
              setMusicSessionAutoplayEnabled(false);
              player.pendingAutoplay = false;
            }
            updateMusicUi();
            saveMusicState();
          }, listenerOptions);

          player.elements.prev?.addEventListener("click", () => {
            loadMusicTrack(player.index - 1, { autoplay: !audio.paused });
          }, listenerOptions);

          player.elements.next?.addEventListener("click", () => {
            loadMusicTrack(player.index + 1, { autoplay: !audio.paused });
          }, listenerOptions);

          player.elements.volume?.addEventListener("input", () => {
            audio.volume = Number(player.elements.volume.value);
            saveMusicState();
            updateMusicUi();
          }, listenerOptions);

          player.elements.seek?.addEventListener("input", () => {
            player.seeking = true;
            if (!audio.duration) return;
            const target = (Number(player.elements.seek.value) / 100) * audio.duration;
            if (player.elements.current) player.elements.current.textContent = formatAudioTime(target);
          }, listenerOptions);

          player.elements.seek?.addEventListener("change", () => {
            if (audio.duration) {
              audio.currentTime = (Number(player.elements.seek.value) / 100) * audio.duration;
            }
            player.seeking = false;
            updateMusicUi();
            saveMusicState();
          }, listenerOptions);

          player.audioAbort?.abort();
          player.audioAbort = new AbortController();
          const audioListenerOptions = { signal: player.audioAbort.signal };

          const tryResumeAfterRefresh = async () => {
            if (!player.pendingAutoplay || !audio.paused || !player.tracks.length) return;
            try {
              await audio.play();
              setMusicSessionAutoplayEnabled(true);
              player.pendingAutoplay = false;
              player.unlockAbort?.abort();
              updateMusicUi();
              saveMusicState();
            } catch {
              if (player.elements.note) player.elements.note.textContent = "浏览器需要一次交互后才能续播。";
            }
          };

          player.unlockAbort?.abort();
          player.unlockAbort = new AbortController();
          const unlockOptions = { signal: player.unlockAbort.signal, passive: true };
          ["pointerdown", "keydown", "wheel", "touchstart"].forEach((eventName) => {
            window.addEventListener(eventName, tryResumeAfterRefresh, unlockOptions);
          });

          audio.addEventListener("timeupdate", () => {
            updateMusicUi();
            saveMusicState();
          }, audioListenerOptions);
          audio.addEventListener("play", () => {
            setMusicSessionAutoplayEnabled(true);
            player.pendingAutoplay = false;
            updateMusicUi();
            saveMusicState();
          }, audioListenerOptions);
          audio.addEventListener("pause", () => {
            if (!player.pendingAutoplay) setMusicSessionAutoplayEnabled(false);
            updateMusicUi();
            saveMusicState();
          }, audioListenerOptions);
          audio.addEventListener("ended", () => {
            loadMusicTrack(player.index + 1, { autoplay: true });
          }, audioListenerOptions);
          window.addEventListener("pagehide", saveMusicState, listenerOptions);
          updateMusicUi();
        };

        player.init = initMusicPlayer;
        player.update = updateMusicUi;
        player.isAutoplayEnabled = isMusicAutoplayEnabled;
        player.setAutoplayEnabled = setMusicAutoplayEnabled;
        return player;
      };

      const sakuraStateKey = "yuimi-sakura-enabled-v1";
      const getContextMenu = () => document.querySelector("[data-context-menu]");
      let contextMenuReturnFocus = null;
      const hideContextMenu = () => {
        const contextMenu = getContextMenu();
        const shouldRestoreFocus = contextMenu?.contains(document.activeElement);
        contextMenu?.classList.remove("is-open");
        if (shouldRestoreFocus && contextMenuReturnFocus instanceof HTMLElement) {
          contextMenuReturnFocus.focus({ preventScroll: true });
        }
      };
      const isSakuraEnabled = () => localStorage.getItem(sakuraStateKey) !== "0";
      const setSakuraEnabled = (enabled) => {
        localStorage.setItem(sakuraStateKey, enabled ? "1" : "0");
        document.body.classList.toggle("hide-sakura", !enabled);
      };
      const updateContextToggleLabels = () => {
        const contextMenu = getContextMenu();
        const sakuraButton = contextMenu?.querySelector('[data-context-action="sakura"]');
        const sakuraEnabled = isSakuraEnabled();
        if (sakuraButton) {
          sakuraButton.textContent = sakuraEnabled ? "✿ 樱花雨：开" : "✿ 樱花雨：关";
          sakuraButton.setAttribute("aria-pressed", String(sakuraEnabled));
        }
      };

      setSakuraEnabled(isSakuraEnabled());
      updateContextToggleLabels();

      const showContextMenuAt = (clientX, clientY, focusFirst = false) => {
        const contextMenu = getContextMenu();
        if (!contextMenu) return false;
        if (!contextMenu.contains(document.activeElement)) {
          const activeElement = document.activeElement;
          contextMenuReturnFocus = activeElement instanceof HTMLElement && activeElement !== document.body
            ? activeElement
            : null;
        }
        updateContextToggleLabels();
        const menuWidth = contextMenu.offsetWidth;
        const menuHeight = contextMenu.offsetHeight;
        const x = Math.min(clientX, window.innerWidth - menuWidth - 12);
        const y = Math.min(clientY, window.innerHeight - menuHeight - 12);
        contextMenu.style.setProperty("--menu-x", `${Math.max(12, x)}px`);
        contextMenu.style.setProperty("--menu-y", `${Math.max(12, y)}px`);
        contextMenu.classList.add("is-open");
        if (focusFirst) contextMenu.querySelector("button")?.focus({ preventScroll: true });
        return true;
      };

      window.addEventListener("contextmenu", (event) => {
        event.preventDefault();
        showContextMenuAt(event.clientX, event.clientY);
      });
      window.addEventListener("yuimi:context-menu-request", (event) => {
        if (!(event instanceof CustomEvent)) return;
        const x = Number(event.detail?.clientX);
        const y = Number(event.detail?.clientY);
        showContextMenuAt(
          Number.isFinite(x) ? x : window.innerWidth / 2,
          Number.isFinite(y) ? y : window.innerHeight / 2
        );
      });
      window.addEventListener("keydown", (event) => {
        if (event.key === "Escape") hideContextMenu();
        if (event.key === "ContextMenu" || (event.key === "F10" && event.shiftKey)) {
          event.preventDefault();
          const activeRect = document.activeElement?.getBoundingClientRect?.();
          const x = activeRect ? activeRect.left + Math.min(activeRect.width, 28) : window.innerWidth / 2;
          const y = activeRect ? activeRect.top + Math.min(activeRect.height, 28) : window.innerHeight / 2;
          showContextMenuAt(x, y, true);
        }
      });
      window.addEventListener("click", async (event) => {
        const contextMenu = getContextMenu();
        const target = event.target instanceof Element ? event.target : null;
        const button = target?.closest("[data-context-action]");
        if (!button || !contextMenu?.contains(button)) {
          hideContextMenu();
          return;
        }

        event.stopPropagation();
        const action = button.dataset.contextAction;
        if (action === "top") window.scrollTo({ top: 0, behavior: "smooth" });
        if (action === "refresh") window.location.reload();
        if (action === "home") window.location.href = "/";
        if (action === "back") history.back();
        if (action === "forward") history.forward();
        if (action === "copy") {
          await navigator.clipboard?.writeText(window.location.href);
          button.textContent = "\u2713 \u94fe\u63a5\u5df2\u590d\u5236";
          window.setTimeout(() => {
            button.textContent = "\u29c9 \u590d\u5236\u94fe\u63a5";
          }, 1200);
        }
        if (action === "title") {
          await navigator.clipboard?.writeText(document.title);
          button.textContent = "\u2713 \u6807\u9898\u5df2\u590d\u5236";
          window.setTimeout(() => {
            button.textContent = "T \u590d\u5236\u6807\u9898";
          }, 1200);
        }
        if (action === "sakura") {
          setSakuraEnabled(!isSakuraEnabled());
          updateContextToggleLabels();
        }
        hideContextMenu();
      });

      const enhanceCodeBlocks = () => {
        document.querySelectorAll(".prose pre:not(.expressive-code pre)").forEach((pre) => {
          if (pre.querySelector(".code-block-copy")) return;
          const button = document.createElement("button");
          button.type = "button";
          button.className = "code-block-copy";
          button.textContent = "⧉ Copy";
          button.setAttribute("aria-label", "复制代码");
          button.addEventListener("click", async () => {
            const code = pre.querySelector("code");
            if (!code) return;
            try {
              await navigator.clipboard.writeText(code.textContent ?? "");
              button.textContent = "✓ Copied";
              button.classList.add("copied");
              window.setTimeout(() => {
                button.textContent = "⧉ Copy";
                button.classList.remove("copied");
              }, 1200);
            } catch {
              button.textContent = "Failed";
              window.setTimeout(() => {
                button.textContent = "⧉ Copy";
              }, 1200);
            }
          });
          pre.appendChild(button);
        });
      };

      enhanceCodeBlocks();
      window.addEventListener("load", enhanceCodeBlocks);
      document.addEventListener("astro:page-load", enhanceCodeBlocks);
    </script>
  </body>
</html>
