---
import "../styles/theme.css";
import { site } from "@/lib/site";
import { Icon } from "astro-icon/components";
import { ClientRouter } from "astro:transitions";
import ThemePreferenceGate from "@/core/themes/ThemePreferenceGate.astro";
import ThemeLongPressMenu from "@/core/themes/ThemeLongPressMenu.astro";
import ConsoleEasterEgg from "@/core/ConsoleEasterEgg.astro";
import PerformanceProfile from "@/core/PerformanceProfile.astro";
import { kagariAssets } from "../assets";

const ShadowInkDebug = import.meta.env.DEV
  ? (await import("../components/ShadowInkDebug.astro")).default
  : null;
const PageTransitionPrototype = import.meta.env.DEV
  ? (await import("../components/PageTransitionPrototype.astro")).default
  : null;

interface Props {
  title?: string;
  description?: string;
  honorThemePreference?: boolean;
  isArticlePage?: boolean;
}

const {
  title = site.title,
  description = site.description,
  honorThemePreference = true,
  isArticlePage = false
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url);
const pageTone = Astro.url.pathname.startsWith("/projects") || Astro.url.pathname.startsWith("/works")
  ? "architecture"
  : Astro.url.pathname.startsWith("/about") || Astro.url.pathname.startsWith("/me")
    ? "profile"
    : "paper";
const currentNavHref = pageTone === "architecture"
  ? "/projects/"
  : pageTone === "profile"
    ? "/about/"
    : "/";
---

<!doctype html>
<html lang="zh-CN" data-page-tone={pageTone}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <PerformanceProfile />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#fff8ec" />
    <link rel="icon" type="image/png" href={kagariAssets.favicon} />
    <link rel="apple-touch-icon" href={kagariAssets.appleTouchIcon} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(kagariAssets.profile, canonical)} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <link rel="canonical" href={canonical} />
    <ThemePreferenceGate currentTheme="fuyukawa-kagari" honorPreference={honorThemePreference} />
    <title>{title}</title>
    <ClientRouter />
    <ConsoleEasterEgg />
  </head>
  <body
    data-yuimi-selection-lock={isArticlePage ? undefined : "true"}
    data-yuimi-article-page={isArticlePage ? "true" : undefined}
  >
    <div class="sakura-rain" aria-hidden="true">
      {Array.from({ length: 34 }).map(() => <span></span>)}
    </div>
    <div class="pig-scrollbar" data-pig-scrollbar aria-hidden="true">
      <div class="pig-scrollbar-track">
        <div class="pig-scrollbar-fill"></div>
      </div>
      <div class="pig-scrollbar-pig">
        <span class="pig-scrollbar-snort">哼~ 哼~</span>
        <img src={kagariAssets.scrollPig} alt="" width="56" height="48" />
        <span class="scroll-chibi-layer scroll-chibi-hair" aria-hidden="true"></span>
        <span class="scroll-chibi-layer scroll-chibi-grass" aria-hidden="true"></span>
      </div>
    </div>
    <nav class="custom-context-menu" data-context-menu aria-label="&#x5FEB;&#x6377;&#x83DC;&#x5355;">
      <button type="button" data-context-action="top">&#x2191; &#x56DE;&#x5230;&#x9876;&#x90E8;</button>
      <button type="button" data-context-action="refresh">&#x21BB; &#x5237;&#x65B0;&#x9875;&#x9762;</button>
      <button type="button" data-context-action="home">&#x2302; &#x8FD4;&#x56DE;&#x9996;&#x9875;</button>
      <button type="button" data-context-action="back">&#x2190; &#x540E;&#x9000;</button>
      <button type="button" data-context-action="forward">&#x2192; &#x524D;&#x8FDB;</button>
      <button type="button" data-context-action="copy">&#x29C9; &#x590D;&#x5236;&#x94FE;&#x63A5;</button>
      <button type="button" data-context-action="title">T &#x590D;&#x5236;&#x6807;&#x9898;</button>
      <button type="button" data-context-action="sakura" aria-pressed="true">&#x273F; 樱花雨：开</button>
    </nav>
    <div class="site-shell">
      <header class="site-header" aria-label="Primary">
        <a class="brand" href="/" aria-label={`${site.name} home`}>
          <span>{site.name}</span>
        </a>
        <nav class="nav-links" aria-label="Main navigation">
          {
            site.nav.map((item) => (
              <a
                href={item.href}
                aria-label={`${item.label}: ${item.hint}`}
                aria-current={item.href === currentNavHref ? "page" : undefined}
              >
                <span class="nav-icon" aria-hidden="true"><Icon name={item.icon} /></span>
                <span class="nav-label">{item.label}</span>
                <span class="nav-hint">{item.hint}</span>
              </a>
            ))
          }
        </nav>
      </header>
      <main>
        <slot />
      </main>
      <footer class="site-footer">
        <div class="footer-inner">
          <p class="footer-signature-line">© 2026 BY 寻辰沐雨 / Rain_dust</p>
        </div>
      </footer>
    </div>
    <ThemeLongPressMenu />
    {ShadowInkDebug && <ShadowInkDebug />}
    {PageTransitionPrototype && <PageTransitionPrototype />}

    <script>
      if (import.meta.env.DEV) {
        void import("../lib/page-transition/controller");
      }
    </script>

    <script>
      const pageShellGlobal = window as typeof window & {
        __rainDustPageShellAbort?: AbortController;
      };

      pageShellGlobal.__rainDustPageShellAbort?.abort();
      const pageShellAbort = new AbortController();
      pageShellGlobal.__rainDustPageShellAbort = pageShellAbort;

      const resolvePageTone = (pathname: string) => {
        if (pathname.startsWith("/projects") || pathname.startsWith("/works")) return "architecture";
        if (pathname.startsWith("/about") || pathname.startsWith("/me")) return "profile";
        return "paper";
      };

      const pageShellCriticalCss = `
        .nav-links {
          display: grid !important;
          grid-template-columns: repeat(3, minmax(0, 1fr)) !important;
          width: min(860px, calc(100vw - 84px)) !important;
        }
        .nav-links a {
          justify-content: start !important;
          width: 100% !important;
          min-width: 0 !important;
        }
        .nav-links a:hover:not([aria-current="page"])::after {
          opacity: 0 !important;
          transform: scaleX(0.2) !important;
        }
        @media (max-width: 940px) {
          .nav-links {
            width: min(100%, 520px) !important;
            max-width: calc(100vw - 24px) !important;
            overflow: hidden !important;
          }
        }
        @media (max-width: 520px) {
          .nav-links a {
            justify-content: center !important;
            min-height: 46px !important;
            padding-inline: 4px !important;
          }
        }
      `;

      const ensurePageShellCriticalStyle = () => {
        let style = document.querySelector<HTMLStyleElement>("#rain-dust-page-shell-critical");
        if (!style) {
          style = document.createElement("style");
          style.id = "rain-dust-page-shell-critical";
          style.dataset.astroTransitionPersist = "rain-dust-page-shell-critical";
          document.head.append(style);
        }
        if (style.textContent !== pageShellCriticalCss) style.textContent = pageShellCriticalCss;
      };

      const syncPageShell = () => {
        ensurePageShellCriticalStyle();
        const tone = resolvePageTone(window.location.pathname);
        const currentHref = tone === "architecture"
          ? "/projects/"
          : tone === "profile"
            ? "/about/"
            : "/";

        document.documentElement.dataset.pageTone = tone;
        document.querySelectorAll<HTMLAnchorElement>(".nav-links a[href]").forEach((link) => {
          if (link.getAttribute("href") === currentHref) {
            link.setAttribute("aria-current", "page");
          } else {
            link.removeAttribute("aria-current");
          }
        });
      };

      syncPageShell();
      document.addEventListener("astro:after-swap", syncPageShell, { signal: pageShellAbort.signal });
      document.addEventListener("astro:page-load", syncPageShell, { signal: pageShellAbort.signal });
    </script>

    <script>
      let pigScrollTimer = 0;
      let pigScrollFrame = 0;

      const updatePigScrollbar = () => {
        const pigScrollbar = document.querySelector("[data-pig-scrollbar]");
        if (!pigScrollbar) return;

        const scrollable = document.documentElement.scrollHeight - window.innerHeight;
        const progress = scrollable > 0 ? window.scrollY / scrollable : 0;
        const track = pigScrollbar.querySelector(".pig-scrollbar-track");
        const trackHeight = track?.getBoundingClientRect().height ?? 0;
        const pigY = 20 + progress * trackHeight;
        pigScrollbar.style.setProperty("--scroll-progress", `${Math.min(1, Math.max(0, progress))}`);
        pigScrollbar.style.setProperty("--scroll-percent", `${Math.min(1, Math.max(0, progress)) * 100}%`);
        pigScrollbar.style.setProperty("--pig-y", `${pigY}px`);
        pigScrollbar.classList.add("is-moving");
        window.clearTimeout(pigScrollTimer);
        pigScrollTimer = window.setTimeout(() => {
          pigScrollbar.classList.remove("is-moving");
        }, 260);
      };

      const schedulePigScrollbar = () => {
        if (pigScrollFrame) return;
        pigScrollFrame = window.requestAnimationFrame(() => {
          pigScrollFrame = 0;
          updatePigScrollbar();
        });
      };

      schedulePigScrollbar();
      window.addEventListener("scroll", schedulePigScrollbar, { passive: true });
      window.addEventListener("resize", schedulePigScrollbar);
      document.addEventListener("astro:page-load", schedulePigScrollbar);
      document.addEventListener("astro:after-swap", schedulePigScrollbar);
      window.addEventListener("pageshow", schedulePigScrollbar);

      const sakuraStateKey = "yuimi-sakura-enabled-v1";
      const getContextMenu = () => document.querySelector("[data-context-menu]");
      let contextMenuReturnFocus = null;
      const hideContextMenu = () => {
        const contextMenu = getContextMenu();
        const shouldRestoreFocus = contextMenu?.contains(document.activeElement);
        contextMenu?.classList.remove("is-open");
        if (shouldRestoreFocus && contextMenuReturnFocus instanceof HTMLElement) {
          contextMenuReturnFocus.focus({ preventScroll: true });
        }
      };
      const isSakuraEnabled = () => localStorage.getItem(sakuraStateKey) !== "0";
      const setSakuraEnabled = (enabled) => {
        localStorage.setItem(sakuraStateKey, enabled ? "1" : "0");
        document.body.classList.toggle("hide-sakura", !enabled);
      };
      const updateContextToggleLabels = () => {
        const contextMenu = getContextMenu();
        const sakuraButton = contextMenu?.querySelector('[data-context-action="sakura"]');
        const sakuraEnabled = isSakuraEnabled();
        if (sakuraButton) {
          sakuraButton.textContent = sakuraEnabled ? "✿ 樱花雨：开" : "✿ 樱花雨：关";
          sakuraButton.setAttribute("aria-pressed", String(sakuraEnabled));
        }
      };

      setSakuraEnabled(isSakuraEnabled());
      updateContextToggleLabels();

      const showContextMenuAt = (clientX, clientY, focusFirst = false) => {
        const contextMenu = getContextMenu();
        if (!contextMenu) return false;
        if (!contextMenu.contains(document.activeElement)) {
          const activeElement = document.activeElement;
          contextMenuReturnFocus = activeElement instanceof HTMLElement && activeElement !== document.body
            ? activeElement
            : null;
        }
        updateContextToggleLabels();
        const menuWidth = contextMenu.offsetWidth;
        const menuHeight = contextMenu.offsetHeight;
        const x = Math.min(clientX, window.innerWidth - menuWidth - 12);
        const y = Math.min(clientY, window.innerHeight - menuHeight - 12);
        contextMenu.style.setProperty("--menu-x", `${Math.max(12, x)}px`);
        contextMenu.style.setProperty("--menu-y", `${Math.max(12, y)}px`);
        contextMenu.classList.add("is-open");
        if (focusFirst) contextMenu.querySelector("button")?.focus({ preventScroll: true });
        return true;
      };

      window.addEventListener("contextmenu", (event) => {
        event.preventDefault();
        showContextMenuAt(event.clientX, event.clientY);
      });
      window.addEventListener("yuimi:context-menu-request", (event) => {
        if (!(event instanceof CustomEvent)) return;
        const x = Number(event.detail?.clientX);
        const y = Number(event.detail?.clientY);
        showContextMenuAt(
          Number.isFinite(x) ? x : window.innerWidth / 2,
          Number.isFinite(y) ? y : window.innerHeight / 2
        );
      });
      window.addEventListener("keydown", (event) => {
        if (event.key === "Escape") hideContextMenu();
        if (event.key === "ContextMenu" || (event.key === "F10" && event.shiftKey)) {
          event.preventDefault();
          const activeRect = document.activeElement?.getBoundingClientRect?.();
          const x = activeRect ? activeRect.left + Math.min(activeRect.width, 28) : window.innerWidth / 2;
          const y = activeRect ? activeRect.top + Math.min(activeRect.height, 28) : window.innerHeight / 2;
          showContextMenuAt(x, y, true);
        }
      });
      window.addEventListener("click", async (event) => {
        const contextMenu = getContextMenu();
        const target = event.target instanceof Element ? event.target : null;
        const button = target?.closest("[data-context-action]");
        if (!button || !contextMenu?.contains(button)) {
          hideContextMenu();
          return;
        }

        event.stopPropagation();
        const action = button.dataset.contextAction;
        if (action === "top") window.scrollTo({ top: 0, behavior: "smooth" });
        if (action === "refresh") window.location.reload();
        if (action === "home") window.location.href = "/";
        if (action === "back") history.back();
        if (action === "forward") history.forward();
        if (action === "copy") {
          await navigator.clipboard?.writeText(window.location.href);
          button.textContent = "\u2713 \u94fe\u63a5\u5df2\u590d\u5236";
          window.setTimeout(() => {
            button.textContent = "\u29c9 \u590d\u5236\u94fe\u63a5";
          }, 1200);
        }
        if (action === "title") {
          await navigator.clipboard?.writeText(document.title);
          button.textContent = "\u2713 \u6807\u9898\u5df2\u590d\u5236";
          window.setTimeout(() => {
            button.textContent = "T \u590d\u5236\u6807\u9898";
          }, 1200);
        }
        if (action === "sakura") {
          setSakuraEnabled(!isSakuraEnabled());
          updateContextToggleLabels();
        }
        hideContextMenu();
      });

      const enhanceCodeBlocks = () => {
        document.querySelectorAll(".prose pre:not(.expressive-code pre)").forEach((pre) => {
          if (pre.querySelector(".code-block-copy")) return;
          const button = document.createElement("button");
          button.type = "button";
          button.className = "code-block-copy";
          button.textContent = "⧉ Copy";
          button.setAttribute("aria-label", "复制代码");
          button.addEventListener("click", async () => {
            const code = pre.querySelector("code");
            if (!code) return;
            try {
              await navigator.clipboard.writeText(code.textContent ?? "");
              button.textContent = "✓ Copied";
              button.classList.add("copied");
              window.setTimeout(() => {
                button.textContent = "⧉ Copy";
                button.classList.remove("copied");
              }, 1200);
            } catch {
              button.textContent = "Failed";
              window.setTimeout(() => {
                button.textContent = "⧉ Copy";
              }, 1200);
            }
          });
          pre.appendChild(button);
        });
      };

      enhanceCodeBlocks();
      window.addEventListener("load", enhanceCodeBlocks);
      document.addEventListener("astro:page-load", enhanceCodeBlocks);
    </script>
  </body>
</html>
