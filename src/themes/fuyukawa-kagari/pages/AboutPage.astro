---
import BaseLayout from "../layouts/BaseLayout.astro";
import { Icon } from "astro-icon/components";
import { kagariAssets } from "../assets";
import {
  animeFavorites,
  currentSignals,
  favoriteReading,
  profileIdentity,
  profileStatus,
  profileTech,
  xpFavorites
} from "@/core/data/profile";

const statusItems = profileStatus;
const techPresentation = {
  threejs: { icon: "simple-icons:threedotjs", tone: "blue" },
  python: { icon: "simple-icons:python", tone: "ink" },
  nextjs: { icon: "simple-icons:nextdotjs", tone: "pink" },
  solidworks: { icon: "tabler:box-model-2", tone: "blue" },
  creo: { icon: "tabler:cube-3d-sphere", tone: "orange" },
  autocad: { icon: "tabler:ruler-measure-2", tone: "ink" },
  bambu3d: { icon: "tabler:printer", tone: "mint" },
  opencv: { icon: "simple-icons:opencv", tone: "pink" },
  yolo: { icon: "tabler:scan", tone: "orange" }
} as const;
const techStack = profileTech.map((tech) => ({ ...tech, ...techPresentation[tech.key] }));
const animeShelf = animeFavorites;
const xpTags = xpFavorites;
const readingShelf = favoriteReading;
const nowDoing = currentSignals;
---

<BaseLayout title="About | Rain_dust" description="关于寻辰沐雨 / Rain_dust 的兴趣、作品与个人资料。">
  <section class="about-profile-shell" aria-labelledby="about-title">
    <aside class="about-sidebar" aria-label="Rain_dust profile card">
      <div class="about-avatar-card">
        <span class="about-tape about-tape--left" aria-hidden="true"></span>
        <img src={kagariAssets.profile} alt="寻辰沐雨 / Rain_dust 的头像" width="220" height="220" />
        <span class="about-avatar-flower" aria-hidden="true">✦</span>
      </div>

      <div class="about-id-card">
        <p class="about-kicker">Profile README</p>
        <h1 id="about-title">{profileIdentity.displayName}</h1>
        <p class="about-handle">{profileIdentity.handle} · {profileIdentity.siteName}</p>
        <p class="about-bio">{profileIdentity.bio}</p>

        <div class="about-link-row" aria-label="profile links">
          <a href={profileIdentity.github} target="_blank" rel="noreferrer">
            <Icon name="simple-icons:github" aria-hidden="true" />
            GitHub
          </a>
          <button type="button" data-copy-email={profileIdentity.emailAddress}>
            <Icon name="tabler:mail" aria-hidden="true" />
            <span data-copy-email-label>Email</span>
            <span class="about-sr-only" role="status" aria-live="polite" data-copy-email-status></span>
          </button>
        </div>
      </div>

      <div class="about-status-card">
        <p class="about-mini-title">Now status</p>
        <ul>
          {statusItems.map((item, index) => (
            <li class:list={{ "is-now": index === 0 }}>
              <Icon name="tabler:pin" aria-hidden="true" />
              <span>{item}</span>
            </li>
          ))}
        </ul>
      </div>
    </aside>

    <section class="about-readme" aria-label="Rain_dust README">
      <div class="about-readme-hero">
        <div>
          <p class="section-kicker">README.md</p>
          <h2>Hi, I am Rain_dust</h2>
          <p>
            INTP、智能制造工程专业、机械与视觉双修的 RMer。<br />
            小说迷、玄学爱好者、玩 AstrBot 的。<br />
            想到什么，就做点什么。
          </p>
        </div>
        <div class="about-readme-badge" aria-hidden="true">
          <Icon name="tabler:scan" />
          <span>MECH × VISION</span>
        </div>
      </div>

      <section class="about-section" aria-labelledby="tech-line-title">
        <div class="about-section-heading">
          <Icon name="tabler:terminal-2" aria-hidden="true" />
          <div>
            <p>Tech line</p>
            <h2 id="tech-line-title">技术线</h2>
          </div>
        </div>

        <div class="about-tech-grid">
          {techStack.map((tech, index) => (
            <article
              class={`about-tech-card about-tech-card--${tech.tone}`}
              data-about-reveal
              style={`--reveal-index: ${index};`}
            >
              <span class="about-tech-icon" aria-hidden="true">
                <Icon name={tech.icon} />
              </span>
              <div>
                <h3>{tech.name}</h3>
                <p>{tech.note}</p>
              </div>
            </article>
          ))}
        </div>
      </section>

      <section class="about-section" aria-labelledby="anime-shelf-title">
        <div class="about-section-heading">
          <Icon name="tabler:movie" aria-hidden="true" />
          <div>
            <p>Anime shelf</p>
            <h2 id="anime-shelf-title">喜欢看的番剧</h2>
          </div>
        </div>

        <div class="about-media-grid about-media-grid--anime">
          {animeShelf.map((item, index) => (
            <article
              class="about-media-card"
              data-about-reveal
              style={`--reveal-index: ${index};`}
            >
              <img src={item.image} alt={`${item.title} 视觉海报`} loading="lazy" width="900" height="506" />
              <div>
                <h3>{item.title}</h3>
                <p>{item.subtitle}</p>
              </div>
            </article>
          ))}
        </div>
      </section>

      <section class="about-section about-section--split" aria-label="XP and reading">
        <div>
          <div class="about-section-heading">
            <Icon name="tabler:heart" aria-hidden="true" />
            <div>
              <p>XP tags</p>
              <h2>XP</h2>
            </div>
          </div>

          <div class="about-xp-grid">
            {xpTags.map((item, index) => (
              <article
                class={`about-xp-card about-xp-card--${item.key}`}
                data-about-reveal
                style={`--reveal-index: ${index};`}
              >
                <figure class="about-xp-visual">
                  <img
                    src={item.image}
                    alt={item.imageAlt}
                    loading="lazy"
                    decoding="async"
                    style={`object-position: ${item.imagePosition};`}
                  />
                </figure>
                <div>
                  <h3>{item.title}</h3>
                  <p>{item.subtitle}</p>
                </div>
              </article>
            ))}
          </div>
        </div>

        <div>
          <div class="about-section-heading">
            <Icon name="tabler:book-2" aria-hidden="true" />
            <div>
              <p>Reading</p>
              <h2>阅读</h2>
            </div>
          </div>

          <div class="about-game-list">
            {readingShelf.map((item, index) => (
              <article
                class={`about-game-card about-game-card--${item.key}`}
                data-about-reveal
                style={`--reveal-index: ${index};`}
              >
                <figure class="about-reading-cover">
                  <img
                    src={item.image}
                    alt={item.imageAlt}
                    loading="lazy"
                    decoding="async"
                    style={`object-position: ${item.imagePosition};`}
                  />
                </figure>
                <div>
                  <span aria-hidden="true">
                    <Icon name="tabler:bookmark" />
                  </span>
                  <h3>{item.title}</h3>
                  <p>{item.subtitle}</p>
                </div>
              </article>
            ))}
          </div>
        </div>
      </section>

      <section class="about-section" aria-labelledby="now-doing-title">
        <div class="about-section-heading">
          <Icon name="tabler:flower" aria-hidden="true" />
          <div>
            <p>Light activity</p>
            <h2 id="now-doing-title">最近的电波</h2>
          </div>
        </div>

        <div class="about-activity-grid">
          {nowDoing.map((item, index) => (
            <article data-about-reveal style={`--reveal-index: ${index};`}>
              <span>{item.label}</span>
              <p>{item.text}</p>
            </article>
          ))}
        </div>
      </section>
    </section>
  </section>

  <style>
    .about-profile-shell {
      width: min(1360px, calc(100% - 32px));
      margin: 0 auto;
      padding: 96px 0 72px;
      display: grid;
      grid-template-columns: minmax(250px, 288px) minmax(0, 1fr);
      gap: 22px;
      align-items: start;
    }

    .about-sidebar {
      position: sticky;
      top: 112px;
      display: grid;
      gap: 16px;
    }

    .about-avatar-card,
    .about-id-card,
    .about-status-card,
    .about-readme-hero,
    .about-section {
      position: relative;
      isolation: isolate;
      overflow: visible;
      border: 2px solid var(--glass-line);
      border-radius: 8px;
      background:
        linear-gradient(135deg, rgba(255, 255, 255, 0.1), rgba(255, 226, 234, 0.05) 44%, rgba(220, 238, 250, 0.08)),
        rgba(255, 252, 246, 0.18);
      box-shadow:
        inset 0 0 0 1px var(--glass-edge),
        var(--glass-shadow);
      backdrop-filter: blur(2px) saturate(1.03);
      -webkit-backdrop-filter: blur(2px) saturate(1.03);
    }

    .about-avatar-card {
      display: grid;
      place-items: center;
      min-height: 250px;
      padding: 20px;
      background:
        radial-gradient(circle at 18% 18%, rgba(255, 226, 234, 0.54), transparent 32%),
        radial-gradient(circle at 78% 72%, rgba(220, 238, 250, 0.5), transparent 34%),
        rgba(255, 252, 246, 0.18);
    }

    .about-avatar-card img {
      width: min(188px, 72vw);
      height: min(188px, 72vw);
      aspect-ratio: 1;
      object-fit: cover;
      border: 4px solid rgba(255, 255, 255, 0.82);
      border-radius: 50%;
      box-shadow:
        0 18px 34px rgba(67, 82, 106, 0.16),
        0 0 0 10px rgba(255, 226, 234, 0.32);
    }

    .about-tape {
      position: absolute;
      top: -10px;
      left: 26px;
      z-index: 2;
      width: 78px;
      height: 24px;
      border: 1px solid rgba(255, 255, 255, 0.58);
      border-radius: 999px;
      background:
        repeating-linear-gradient(90deg, rgba(255, 255, 255, 0.5) 0 5px, transparent 5px 10px),
        rgba(255, 222, 139, 0.7);
      box-shadow: 0 8px 16px rgba(91, 110, 139, 0.12);
      transform: rotate(-9deg);
    }

    .about-avatar-flower {
      position: absolute;
      right: 34px;
      bottom: 34px;
      display: grid;
      place-items: center;
      width: 42px;
      height: 42px;
      color: #fffaf1;
      background: linear-gradient(135deg, var(--pink), var(--blue));
      border: 2px solid rgba(255, 255, 255, 0.82);
      border-radius: 50%;
      box-shadow: 0 10px 22px rgba(91, 110, 139, 0.16);
    }

    .about-id-card,
    .about-status-card,
    .about-readme-hero,
    .about-section {
      padding: 24px;
    }

    .about-kicker,
    .about-mini-title,
    .about-section-heading p {
      margin: 0;
      color: var(--pink);
      font-family: "Cascadia Code", "Fira Code", Consolas, monospace;
      font-size: 0.75rem;
      font-weight: 800;
      letter-spacing: 0.08em;
      text-transform: uppercase;
    }

    .about-id-card h1,
    .about-readme-hero h2,
    .about-section-heading h2 {
      margin: 6px 0 0;
      color: var(--ink);
      letter-spacing: 0;
    }

    .about-id-card h1 {
      font-size: clamp(2.1rem, 8vw, 3.15rem);
      line-height: 1;
    }

    .about-handle {
      margin: 8px 0 0;
      color: var(--ink);
      font-family: "Cascadia Code", "Fira Code", Consolas, monospace;
      font-size: 0.88rem;
      font-weight: 800;
      letter-spacing: 0.05em;
    }

    .about-bio,
    .about-readme-hero p,
    .about-activity-grid p {
      color: var(--ink-soft);
      line-height: 1.85;
    }

    .about-bio {
      margin: 10px 0 0;
      max-width: 24rem;
    }

    .about-readme-hero p {
      margin: 14px 0 0;
      max-width: 40rem;
      font-size: 0.98rem;
    }

    .about-readme-hero h2 {
      letter-spacing: -0.02em;
    }

    .about-id-card h1 {
      letter-spacing: -0.01em;
    }

    .about-section-heading h2 {
      letter-spacing: -0.015em;
    }

    .about-avatar-card img {
      transition: transform 0.5s cubic-bezier(0.2, 0.8, 0.2, 1);
    }

    .about-avatar-card:hover img {
      transform: scale(1.04);
    }

    .about-link-row :is(a, button):focus-visible {
      outline: 2px solid var(--pink);
      outline-offset: 2px;
    }

    .about-link-row {
      display: flex;
      flex-wrap: wrap;
      gap: 10px;
      margin-top: 18px;
    }

    .about-link-row :is(a, button) {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      min-height: 38px;
      padding: 8px 13px;
      color: var(--ink);
      font-size: 0.92rem;
      font-weight: 800;
      text-decoration: none;
      background: rgba(255, 255, 255, 0.54);
      border: 1px solid rgba(93, 113, 145, 0.18);
      border-radius: 999px;
      box-shadow: 0 10px 20px rgba(67, 82, 106, 0.08);
      appearance: none;
      cursor: pointer;
      font-family: inherit;
      transition:
        color 180ms ease,
        background 180ms ease,
        border-color 180ms ease,
        transform 180ms ease;
    }

    .about-link-row :is(a, button):hover {
      color: #314b68;
      background: rgba(220, 238, 250, 0.74);
      border-color: rgba(93, 113, 145, 0.3);
      transform: translateY(-1px);
    }

    .about-link-row button.is-copied {
      color: #496c5b;
      background: rgba(222, 242, 230, 0.82);
      border-color: rgba(73, 108, 91, 0.28);
    }

    .about-link-row svg,
    .about-section-heading svg,
    .about-tech-icon svg,
    .about-game-card div > span svg {
      width: 1.2em;
      height: 1.2em;
    }

    .about-status-card ul {
      display: grid;
      gap: 10px;
      padding: 0;
      margin: 14px 0 0;
      list-style: none;
    }

    .about-status-card li {
      display: grid;
      grid-template-columns: 20px minmax(0, 1fr);
      gap: 8px;
      align-items: start;
      color: var(--ink);
      font-size: 0.94rem;
      font-weight: 700;
      line-height: 1.55;
    }

    .about-status-card svg {
      width: 18px;
      height: 18px;
      margin-top: 2px;
      color: var(--pink);
    }

    .about-readme {
      display: grid;
      gap: 18px;
      min-width: 0;
    }

    .about-readme-hero {
      display: grid;
      grid-template-columns: minmax(0, 1fr) 136px;
      gap: 18px;
      align-items: center;
      min-height: 220px;
    }

    .about-readme-hero h2 {
      font-size: clamp(2.4rem, 4.2vw, 4.85rem);
      line-height: 1.02;
    }

    .about-readme-badge {
      display: grid;
      place-items: center;
      align-content: center;
      width: 136px;
      height: 136px;
      color: var(--ink);
      text-align: center;
      background:
        radial-gradient(circle at 36% 28%, rgba(255, 255, 255, 0.9), transparent 24%),
        linear-gradient(135deg, var(--pink-soft), var(--blue-soft));
      border: 2px solid rgba(255, 255, 255, 0.76);
      border-radius: 50%;
      box-shadow: 0 18px 34px rgba(67, 82, 106, 0.12);
      transform: rotate(4deg);
    }

    .about-readme-badge svg {
      width: 36px;
      height: 36px;
      color: var(--pink);
    }

    .about-readme-badge span {
      margin-top: 8px;
      font-family: "Cascadia Code", "Fira Code", Consolas, monospace;
      font-size: 0.72rem;
      font-weight: 800;
      line-height: 1.3;
    }

    .about-section {
      display: grid;
      gap: 18px;
    }

    .about-section::before {
      position: absolute;
      top: -9px;
      right: 24px;
      width: 86px;
      height: 22px;
      content: "";
      background:
        repeating-linear-gradient(90deg, rgba(255, 255, 255, 0.54) 0 4px, transparent 4px 8px),
        rgba(220, 238, 250, 0.72);
      border: 1px solid rgba(255, 255, 255, 0.58);
      border-radius: 999px;
      box-shadow: 0 8px 16px rgba(91, 110, 139, 0.12);
      transform: rotate(5deg);
    }

    .about-section-heading {
      display: flex;
      gap: 12px;
      align-items: center;
    }

    .about-section-heading > svg {
      flex: 0 0 auto;
      width: 38px;
      height: 38px;
      padding: 8px;
      color: var(--ink);
      background: rgba(255, 255, 255, 0.62);
      border: 1px solid rgba(93, 113, 145, 0.18);
      border-radius: 8px;
      box-shadow: 0 10px 20px rgba(67, 82, 106, 0.08);
    }

    .about-tech-grid {
      display: grid;
      grid-template-columns: repeat(5, minmax(140px, 1fr));
      gap: 12px;
    }

    .about-tech-card {
      display: grid;
      gap: 12px;
      min-height: 168px;
      padding: 16px;
      color: var(--ink);
      background: rgba(255, 255, 255, 0.5);
      border: 1px solid rgba(93, 113, 145, 0.18);
      border-radius: 8px;
      box-shadow: 0 12px 24px rgba(67, 82, 106, 0.08);
    }

    .about-tech-icon {
      display: grid;
      place-items: center;
      width: 46px;
      height: 46px;
      background: var(--blue-soft);
      border-radius: 8px;
    }

    .about-tech-card--orange .about-tech-icon {
      color: #e2762d;
      background: #ffe8cf;
    }

    .about-tech-card--ink .about-tech-icon {
      color: #fffaf1;
      background: #31425f;
    }

    .about-tech-card--pink .about-tech-icon {
      color: #c85278;
      background: var(--pink-soft);
    }

    .about-tech-card--mint .about-tech-icon {
      color: #3c8067;
      background: rgba(184, 219, 201, 0.58);
    }

    .about-tech-card h3,
    .about-media-card h3,
    .about-xp-card h3,
    .about-game-card h3 {
      margin: 0;
      color: var(--ink);
      font-size: 1rem;
      line-height: 1.35;
    }

    .about-media-card h3,
    .about-xp-card h3,
    .about-game-card h3 {
      font-size: 0.96rem;
    }

    .about-tech-card p,
    .about-media-card p,
    .about-xp-card p,
    .about-game-card p {
      margin: 5px 0 0;
      color: var(--ink-soft);
      font-size: 0.82rem;
      line-height: 1.45;
    }

    .about-media-grid {
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 14px;
    }

    .about-media-card,
    .about-xp-card,
    .about-game-card {
      overflow: hidden;
      background: rgba(255, 255, 255, 0.52);
      border: 1px solid rgba(93, 113, 145, 0.18);
      border-radius: 8px;
      box-shadow: 0 12px 24px rgba(67, 82, 106, 0.08);
    }

    .about-media-card img,
    .about-xp-visual,
    .about-reading-cover {
      display: block;
      width: 100%;
      aspect-ratio: 16 / 9;
      background: var(--paper-soft);
    }

    .about-media-card img {
      height: auto;
      object-fit: contain;
      padding: 8px;
      background:
        radial-gradient(circle at 40% 34%, rgba(255, 226, 234, 0.58), transparent 38%),
        linear-gradient(135deg, rgba(255, 250, 241, 0.72), rgba(220, 238, 250, 0.38));
    }

    .about-xp-visual,
    .about-reading-cover {
      position: relative;
      overflow: hidden;
      margin: 0;
    }

    .about-xp-visual {
      aspect-ratio: 4 / 3;
      background:
        radial-gradient(circle at 42% 32%, rgba(255, 226, 234, 0.7), transparent 38%),
        linear-gradient(135deg, rgba(255, 250, 241, 0.88), rgba(220, 238, 250, 0.58));
    }

    .about-xp-visual::after,
    .about-reading-cover::after {
      position: absolute;
      inset: 0;
      pointer-events: none;
      content: "";
      background:
        linear-gradient(180deg, rgba(255, 250, 241, 0.03), rgba(35, 45, 62, 0.1)),
        repeating-linear-gradient(0deg, rgba(35, 45, 62, 0.025) 0 1px, transparent 1px 4px);
      mix-blend-mode: multiply;
    }

    .about-xp-visual img,
    .about-reading-cover img {
      display: block;
      width: 100%;
      height: 100%;
      object-fit: cover;
      filter: saturate(0.72) contrast(0.96) brightness(1.02);
      transform: scale(1.01);
      transition:
        filter 300ms ease,
        transform 420ms cubic-bezier(0.18, 0.8, 0.2, 1);
    }

    .about-xp-card:hover .about-xp-visual img,
    .about-game-card:hover .about-reading-cover img {
      filter: saturate(0.9) contrast(1) brightness(1.03);
      transform: scale(1.035);
    }

    .about-media-card div,
    .about-xp-card div {
      padding: 12px;
    }

    .about-media-card div {
      min-height: 72px;
      padding: 10px 12px 12px;
    }

    .about-section--split {
      grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
      gap: 22px;
    }

    .about-section--split > div {
      min-width: 0;
      display: grid;
      align-content: start;
      gap: 14px;
    }

    .about-xp-grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 12px;
    }

    .about-game-list {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 12px;
    }

    .about-game-card {
      min-height: 0;
    }

    .about-reading-cover {
      aspect-ratio: 16 / 9;
      background:
        linear-gradient(135deg, rgba(255, 226, 234, 0.54), rgba(220, 238, 250, 0.52)),
        rgba(255, 255, 255, 0.5);
    }

    .about-game-card--novel .about-reading-cover img,
    .about-game-card--web-fiction .about-reading-cover img {
      object-fit: contain;
      padding: 8px;
      background: rgba(240, 237, 228, 0.9);
    }

    .about-game-card--metaphysics .about-reading-cover img {
      object-fit: cover;
    }

    .about-game-card div {
      display: grid;
      grid-template-columns: 30px minmax(0, 1fr);
      column-gap: 8px;
      align-items: start;
      min-height: 78px;
      padding: 10px 12px 12px;
    }

    .about-game-card div > span {
      display: inline-grid;
      place-items: center;
      width: 28px;
      height: 28px;
      grid-row: span 2;
      margin-bottom: 0;
      color: var(--ink);
      background: var(--blue-soft);
      border-radius: 8px;
    }

    .about-activity-grid {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 12px;
    }

    .about-activity-grid article {
      min-height: 132px;
      padding: 16px;
      background: rgba(255, 255, 255, 0.52);
      border: 1px solid rgba(93, 113, 145, 0.18);
      border-radius: 8px;
      box-shadow: 0 12px 24px rgba(67, 82, 106, 0.08);
    }

    .about-activity-grid span {
      display: inline-flex;
      padding: 5px 10px;
      color: var(--ink);
      font-size: 0.78rem;
      font-weight: 800;
      background: var(--pink-soft);
      border-radius: 999px;
    }

    @media (max-width: 1080px) {
      .about-profile-shell {
        grid-template-columns: 1fr;
        padding-top: 82px;
      }

      .about-sidebar {
        position: static;
        grid-template-columns: minmax(240px, 0.8fr) minmax(0, 1fr);
        align-items: stretch;
      }

      .about-status-card {
        grid-column: 1 / -1;
      }

      .about-status-card ul {
        grid-template-columns: repeat(3, minmax(0, 1fr));
      }

      .about-tech-grid {
        grid-template-columns: repeat(3, minmax(0, 1fr));
      }

      .about-media-grid {
        grid-template-columns: repeat(3, minmax(0, 1fr));
      }
    }

    @media (max-width: 760px) {
      .about-profile-shell {
        width: min(100% - 24px, 1280px);
        padding-top: 72px;
      }

      .about-sidebar,
      .about-readme-hero,
      .about-section--split,
      .about-status-card ul,
      .about-activity-grid {
        grid-template-columns: 1fr;
      }

      .about-readme-badge {
        width: 118px;
        height: 118px;
        justify-self: start;
      }

      .about-readme-hero h2 {
        font-size: clamp(2.1rem, 12vw, 3.2rem);
        overflow-wrap: anywhere;
      }

      .about-tech-grid,
      .about-xp-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }

      .about-media-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }

      .about-section--split {
        grid-template-columns: 1fr;
      }

      .about-game-card {
        grid-template-columns: 1fr;
      }
    }

    @media (max-width: 520px) {
      .about-id-card,
      .about-status-card,
      .about-readme-hero,
      .about-section {
        padding: 18px;
      }

      .about-tech-grid,
      .about-xp-grid {
        grid-template-columns: 1fr;
      }

      .about-media-card {
        grid-template-columns: 1fr;
      }

      .about-tech-card {
        min-height: 124px;
      }

      .about-game-list,
      .about-xp-grid,
      .about-media-grid {
        grid-template-columns: 1fr;
      }

      .about-id-card h1 {
        font-size: clamp(2rem, 16vw, 2.8rem);
      }
    }

    /* ---- Reveal-on-scroll (armed by JS only, so no-JS stays fully visible) ---- */
    [data-about-reveal] {
      transition:
        opacity .55s ease calc(var(--reveal-index, 0) * 45ms),
        transform .65s cubic-bezier(.2, .8, .25, 1) calc(var(--reveal-index, 0) * 45ms);
    }

    .about-reveal-active [data-about-reveal] {
      opacity: 0;
      transform: translateY(14px);
    }

    .about-reveal-active [data-about-reveal].is-revealed {
      opacity: 1;
      transform: none;
    }

    @media (prefers-reduced-motion: reduce) {
      .about-reveal-active [data-about-reveal] {
        opacity: 1;
        transform: none;
        transition: none;
      }
    }

    /* ---- Card hover feel ---- */
    .about-tech-card,
    .about-media-card,
    .about-xp-card,
    .about-game-card,
    .about-activity-grid article {
      transition:
        transform .34s cubic-bezier(.2, .8, .25, 1),
        box-shadow .34s ease,
        border-color .34s ease,
        background .34s ease;
    }

    .about-tech-card:hover,
    .about-media-card:hover,
    .about-xp-card:hover,
    .about-game-card:hover,
    .about-activity-grid article:hover {
      transform: translateY(-4px);
      background: rgba(255, 255, 255, 0.68);
      border-color: rgba(93, 113, 145, 0.3);
      box-shadow:
        0 20px 38px rgba(67, 82, 106, 0.14),
        0 4px 10px rgba(67, 82, 106, 0.06);
    }

    .about-tech-icon {
      transition: transform .4s cubic-bezier(.2, 1.4, .3, 1), box-shadow .4s ease;
    }

    .about-tech-card:hover .about-tech-icon {
      transform: scale(1.08) rotate(-3deg);
      box-shadow: 0 10px 18px rgba(67, 82, 106, 0.14);
    }

    .about-media-card img {
      transition: transform .5s cubic-bezier(.2, .8, .2, 1);
    }

    .about-media-card:hover img {
      transform: scale(1.025);
    }

    .about-activity-grid article {
      position: relative;
    }

    .about-activity-grid article::before {
      position: absolute;
      top: 0;
      right: 14px;
      left: 14px;
      height: 3px;
      content: "";
      background: linear-gradient(90deg, var(--pink), var(--blue));
      border-radius: 0 0 3px 3px;
      opacity: 0;
      transform: scaleX(.4);
      transition: opacity .3s ease, transform .4s ease;
    }

    .about-activity-grid article:hover::before {
      opacity: .9;
      transform: scaleX(1);
    }

    /* ---- Ambient life (only when motion is allowed) ---- */
    @media (prefers-reduced-motion: no-preference) {
      .about-readme-badge {
        animation: about-badge-float 6s ease-in-out infinite;
      }

      .about-avatar-flower {
        animation: about-flower-pulse 3.4s ease-in-out infinite;
      }

      .about-status-card li.is-now svg {
        animation: about-pin-pulse 2.6s ease-in-out infinite;
      }
    }

    @keyframes about-pin-pulse {
      0%, 100% { opacity: 1; transform: scale(1); }
      50% { opacity: 0.5; transform: scale(1.18); }
    }

    @keyframes about-badge-float {
      0%, 100% { transform: rotate(4deg) translateY(0); }
      50% { transform: rotate(4deg) translateY(-6px); }
    }

    @keyframes about-flower-pulse {
      0%, 100% { box-shadow: 0 10px 22px rgba(91, 110, 139, 0.16); }
      50% { box-shadow: 0 10px 26px rgba(215, 130, 156, 0.38); }
    }

    /* ---- Screen-reader-only copy feedback ---- */
    .about-sr-only {
      position: absolute;
      width: 1px;
      height: 1px;
      padding: 0;
      margin: -1px;
      overflow: hidden;
      clip: rect(0, 0, 0, 0);
      white-space: nowrap;
      border: 0;
    }
  </style>

  <script>
    type AboutEmailWindow = Window & {
      __rainDustAboutEmailHandler?: (event: MouseEvent) => void;
    };

    const appWindow = window as AboutEmailWindow;
    if (appWindow.__rainDustAboutEmailHandler) {
      document.removeEventListener("click", appWindow.__rainDustAboutEmailHandler);
    }

    const copyEmail = async (email: string) => {
      try {
        await navigator.clipboard.writeText(email);
      } catch {
        const input = document.createElement("textarea");
        input.value = email;
        input.setAttribute("readonly", "");
        input.style.position = "fixed";
        input.style.opacity = "0";
        document.body.append(input);
        input.select();
        document.execCommand("copy");
        input.remove();
      }
    };

    const handleEmailCopy = async (event: MouseEvent) => {
      const target = event.target;
      if (!(target instanceof Element)) return;

      const button = target.closest<HTMLButtonElement>("[data-copy-email]");
      if (!button) return;

      const email = button.dataset.copyEmail;
      if (!email) return;

      await copyEmail(email);
      const label = button.querySelector<HTMLElement>("[data-copy-email-label]");
      const status = button.querySelector<HTMLElement>("[data-copy-email-status]");
      if (status) {
        status.textContent = "邮箱地址已复制到剪贴板";
        window.setTimeout(() => {
          status.textContent = "";
        }, 2400);
      }
      if (!label) return;

      window.clearTimeout(Number(button.dataset.restoreTimer ?? 0));
      label.textContent = "已复制";
      button.classList.add("is-copied");
      const timer = window.setTimeout(() => {
        label.textContent = "Email";
        button.classList.remove("is-copied");
      }, 1600);
      button.dataset.restoreTimer = String(timer);
    };

    appWindow.__rainDustAboutEmailHandler = handleEmailCopy;
    document.addEventListener("click", handleEmailCopy);

    // Reveal-on-scroll: armed only when JS runs and motion is allowed, so
    // the page stays fully visible for no-JS and reduced-motion visitors.
    const revealTargets = Array.from(document.querySelectorAll<HTMLElement>("[data-about-reveal]"));
    const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    if (!reducedMotion && "IntersectionObserver" in window) {
      document.documentElement.classList.add("about-reveal-active");
      const revealObserver = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (!entry.isIntersecting) continue;
            entry.target.classList.add("is-revealed");
            revealObserver.unobserve(entry.target);
          }
        },
        { rootMargin: "0px 0px -8% 0px", threshold: 0.08 },
      );
      revealTargets.forEach((element) => revealObserver.observe(element));
    } else {
      revealTargets.forEach((element) => element.classList.add("is-revealed"));
    }
  </script>
</BaseLayout>
