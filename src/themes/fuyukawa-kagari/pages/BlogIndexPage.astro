---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getPublishedPosts } from "@/core/content/blog";
import { categoryLabel } from "@/lib/site";
import { Icon } from "astro-icon/components";
import { kagariAssets } from "../assets";

const posts = (await getPublishedPosts())
  .map((post) => {
    const rawText = post.body
      .replace(/```[\s\S]*?```/g, "")
      .replace(/<[^>]+>/g, "")
      .replace(/[#>*_\-[\]()`~]/g, "")
      .trim();
    const cjk = rawText.match(/[\u4e00-\u9fff]/g)?.length ?? 0;
    const words = rawText.replace(/[\u4e00-\u9fff]/g, " ").match(/[A-Za-z0-9]+/g)?.length ?? 0;
    return {
      ...post,
      wordCount: cjk + words,
      updatedAt: post.data.updatedDate ?? post.data.pubDate,
      cover: post.data.cover ?? kagariAssets.heroWallpaper
    };
  });
const hasPosts = posts.length > 0;

const formatter = new Intl.DateTimeFormat("zh-CN", {
  year: "numeric",
  month: "2-digit",
  day: "2-digit"
});

const coverFocus: Record<string, string> = {
  "/blog-covers/cover-03.webp": "50% 32%",
  "/blog-covers/cover-08.webp": "50% 30%",
  "/blog-covers/cover-09.webp": "50% 28%",
  "/blog-covers/cover-10.webp": "50% 30%"
};
---

<BaseLayout title="Blog | Rain_dust" description="Rain_dust 的文章与笔记。">
  <div class="blog-archive-page">
    <section class="page-title blog-hero-card">
      <div class="blog-hero-heading">
        <p class="section-kicker">Reading Archive</p>
        <h1>Blog</h1>
      </div>
      <div class="blog-hero-note">
        <span>{posts.length.toString().padStart(2, "0")} NOTES</span>
      </div>
    </section>

    <section class="blog-search-card" data-pagefind-ignore>
      <div class="blog-search-heading">
        <Icon name="tabler:search" aria-hidden="true" />
        <div>
          <p class="section-kicker">Search</p>
          <h2>翻找笔记</h2>
        </div>
      </div>
      <label class="blog-search-box">
        <span>关键词</span>
        <input
          type="search"
          data-blog-search
          placeholder={hasPosts ? "输入关键词..." : "暂无文章"}
          autocomplete="off"
          disabled={!hasPosts}
        />
      </label>
      <div class="blog-search-results" data-blog-search-results aria-live="polite"></div>
    </section>

    {
      !hasPosts && (
        <section class="blog-empty-state" aria-label="Blog empty state">
          <div class="blog-empty-copy">
            <p>NO NOTES YET</p>
            <h2>这里暂时没有文章。</h2>
            <span>有想写的再写。</span>
          </div>
          <figure class="blog-empty-plate" aria-hidden="true">
            <img src={kagariAssets.heroWallpaper} alt="" loading="eager" />
            <figcaption>
              <span>IMAGE / TEXT</span>
              <span>RAIN_DUST ARCHIVE</span>
            </figcaption>
          </figure>
        </section>
      )
    }

    {hasPosts && <section class="blog-timeline" aria-label="Blog timeline">
      {
        posts.map((post) => (
          <article class="blog-timeline-item">
            <div class="timeline-date">
              <time datetime={post.updatedAt.toISOString()}>{formatter.format(post.updatedAt)}</time>
              <span>updated</span>
            </div>
            <a class="post-row blog-post-row" href={`/blog/${post.id}/`}>
              <div class="post-cover-frame">
                <img src={post.cover} alt="" loading="lazy" style={`object-position: ${coverFocus[post.cover] ?? "50% 32%"}`} />
              </div>
              <div class="blog-post-copy">
                <div class="meta-row">
                  <span>{categoryLabel[post.data.category]}</span>
                  <time datetime={post.data.pubDate.toISOString()}>发布 {formatter.format(post.data.pubDate)}</time>
                  <time datetime={post.updatedAt.toISOString()}>更新 {formatter.format(post.updatedAt)}</time>
                  <span>{post.wordCount.toLocaleString("zh-CN")} 字</span>
                </div>
                <h2>{post.data.title}</h2>
                <p>{post.data.description}</p>
                <div class="tag-row">
                  {post.data.tags.map((tag) => <span>#{tag}</span>)}
                </div>
              </div>
            </a>
          </article>
        ))
      }
    </section>}

    {hasPosts && <section class="post-list">
      {
        posts.map((post) => (
          <a class="post-row compact-post-row" href={`/blog/${post.id}/`}>
            <div>
              <div class="meta-row">
                <span>{categoryLabel[post.data.category]}</span>
                <time datetime={post.data.pubDate.toISOString()}>{formatter.format(post.data.pubDate)}</time>
                <span>{post.wordCount.toLocaleString("zh-CN")} 字</span>
              </div>
              <h2>{post.data.title}</h2>
              <p>{post.data.description}</p>
            </div>
            <div class="tag-row">
              {post.data.tags.map((tag) => <span>#{tag}</span>)}
            </div>
          </a>
        ))
      }
    </section>}
  </div>

  <script>
    const searchInput = document.querySelector("[data-blog-search]");
    const searchResults = document.querySelector("[data-blog-search-results]");
    let pagefindReady;

    const escapeHtml = (value) =>
      value.replace(/[&<>"']/g, (char) => ({
        "&": "&amp;",
        "<": "&lt;",
        ">": "&gt;",
        '"': "&quot;",
        "'": "&#039;"
      })[char] ?? char);

    const loadPagefind = async () => {
      if (!pagefindReady) {
        const importRuntime = new Function("path", "return import(path)");
        pagefindReady = importRuntime("/pagefind/pagefind.js").then(async (pagefind) => {
          await pagefind.options({
            excerptLength: 18
          });
          return pagefind;
        });
      }
      return pagefindReady;
    };

    const renderSearchState = (message) => {
      if (!searchResults) return;
      searchResults.innerHTML = `<p class="blog-search-empty">${message}</p>`;
    };

    const fallbackLocalSearch = (query) => {
      const cards = [...document.querySelectorAll(".blog-post-row")];
      const lowerQuery = query.toLowerCase();
      const matches = cards
        .map((card) => ({
          href: card.getAttribute("href") ?? "#",
          title: card.querySelector("h2")?.textContent?.trim() ?? "Untitled",
          excerpt: card.querySelector("p")?.textContent?.trim() ?? "",
          text: card.textContent?.toLowerCase() ?? ""
        }))
        .filter((item) => item.text.includes(lowerQuery))
        .slice(0, 5);

      if (!matches.length) {
        renderSearchState("没有找到相关笔记。");
        return;
      }

      if (!searchResults) return;
      searchResults.innerHTML = matches.map((item) => `
        <a class="blog-search-result" href="${item.href}">
          <strong>${escapeHtml(item.title)}</strong>
          <span>${escapeHtml(item.excerpt)}</span>
        </a>
      `).join("");
    };

    let searchTimer = 0;
    searchInput?.addEventListener("input", () => {
      window.clearTimeout(searchTimer);
      const query = searchInput.value.trim();
      if (!query) {
        if (searchResults) searchResults.innerHTML = "";
        return;
      }

      searchTimer = window.setTimeout(async () => {
        renderSearchState("正在翻页...");
        try {
          const pagefind = await loadPagefind();
          const search = await pagefind.search(query);
          const data = await Promise.all(search.results.slice(0, 5).map((result) => result.data()));

          if (!data.length) {
            renderSearchState("没有找到相关笔记。");
            return;
          }

          if (!searchResults) return;
          searchResults.innerHTML = data.map((item) => `
            <a class="blog-search-result" href="${item.url}">
              <strong>${escapeHtml(item.meta.title || "Untitled")}</strong>
              <span>${item.excerpt || ""}</span>
            </a>
          `).join("");
        } catch {
          fallbackLocalSearch(query);
        }
      }, 180);
    });
  </script>
  <style>
    .blog-archive-page {
      --blog-paper: #c9ccca;
      --blog-paper-deep: #b9bdbb;
      --blog-ink: #222625;
      --blog-muted: #58605d;
      --blog-line: rgba(36, 40, 39, 0.22);
      --blog-signal: #763b3f;
      min-height: 100svh;
      padding: clamp(112px, 13vw, 168px) 0 clamp(76px, 10vw, 120px);
      color: var(--blog-ink);
      background:
        linear-gradient(90deg, transparent 0 9.5%, rgba(36, 40, 39, 0.05) 9.5% calc(9.5% + 1px), transparent calc(9.5% + 1px)),
        var(--blog-paper);
    }

    .blog-archive-page :global(.section-kicker) {
      color: var(--blog-signal);
      font-family: "Cascadia Code", "Fira Code", Consolas, monospace;
      letter-spacing: 0.16em;
    }

    .blog-hero-card {
      display: grid;
      grid-template-columns: minmax(0, 0.72fr) minmax(280px, 0.28fr);
      gap: 18px 48px;
      align-items: end;
      width: min(1120px, calc(100% - 48px));
      max-width: none;
      margin: 0 auto;
      padding: 0 0 42px;
      color: var(--blog-ink);
      background: transparent;
      border: 0;
      border-bottom: 1px solid var(--blog-line);
      border-radius: 0;
      box-shadow: none;
      backdrop-filter: none;
      -webkit-backdrop-filter: none;
    }

    .blog-hero-heading {
      min-width: 0;
    }

    .blog-hero-heading h1 {
      margin: 0;
      color: var(--blog-ink);
      font-family: Georgia, "Times New Roman", "Noto Serif SC", serif;
      font-size: clamp(4rem, 8vw, 7.4rem);
      font-weight: 400;
      line-height: 0.88;
      letter-spacing: -0.055em;
    }

    .blog-hero-note {
      align-self: stretch;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      gap: 28px;
      padding-left: 24px;
      border-left: 1px solid var(--blog-line);
    }

    .blog-hero-note > span {
      color: var(--blog-signal);
      font-family: "Cascadia Code", "Fira Code", Consolas, monospace;
      font-size: 0.72rem;
      font-weight: 700;
      letter-spacing: 0.14em;
    }

    .blog-hero-note p {
      margin: 0;
      color: var(--blog-muted);
      font-size: 0.98rem;
      line-height: 1.8;
    }

    .blog-search-card {
      display: grid;
      grid-template-columns: minmax(210px, 0.34fr) minmax(280px, 0.66fr);
      gap: 28px 48px;
      align-items: center;
      width: min(1120px, calc(100% - 48px));
      margin: 0 auto;
      padding: 30px 0;
      background: transparent;
      border: 0;
      border-bottom: 1px solid var(--blog-line);
      border-radius: 0;
      box-shadow: none;
      backdrop-filter: none;
      -webkit-backdrop-filter: none;
    }

    .blog-search-heading {
      gap: 16px;
    }

    .blog-search-heading svg {
      width: 30px;
      height: 30px;
      padding: 5px;
      color: var(--blog-signal);
      background: transparent;
      border: 1px solid var(--blog-line);
      border-radius: 0;
    }

    .blog-search-heading h2,
    .blog-search-box span {
      color: var(--blog-ink);
    }

    .blog-search-box span {
      font-family: "Cascadia Code", "Fira Code", Consolas, monospace;
      font-size: 0.72rem;
      font-weight: 700;
      letter-spacing: 0.12em;
      text-transform: uppercase;
    }

    .blog-search-box input {
      min-height: 48px;
      padding: 8px 0;
      color: var(--blog-ink);
      background: transparent;
      border: 0;
      border-bottom: 1px solid rgba(36, 40, 39, 0.38);
      border-radius: 0;
      box-shadow: none;
    }

    .blog-search-box input:focus {
      border-color: var(--blog-signal);
      box-shadow: 0 2px 0 rgba(118, 59, 63, 0.24);
    }

    .blog-search-result,
    .blog-search-empty {
      color: var(--blog-muted);
      background: rgba(231, 232, 229, 0.32);
      border: 1px solid var(--blog-line);
      border-radius: 0;
    }

    .blog-empty-state {
      display: grid;
      grid-template-columns: minmax(260px, 0.42fr) minmax(360px, 0.58fr);
      gap: clamp(38px, 6vw, 76px);
      align-items: center;
      width: min(1120px, calc(100% - 48px));
      min-height: 460px;
      margin: 0 auto;
      padding: 58px 0 66px;
      text-align: left;
      background: transparent;
      border: 0;
      border-bottom: 1px solid var(--blog-line);
      border-radius: 0;
      box-shadow: none;
    }

    .blog-empty-copy {
      display: grid;
      gap: 14px;
    }

    .blog-empty-copy p,
    .blog-empty-copy h2,
    .blog-empty-copy span {
      display: block;
      margin: 0;
    }

    .blog-empty-copy p {
      color: var(--blog-signal);
      font-family: "Cascadia Code", "Fira Code", Consolas, monospace;
      font-size: 0.72rem;
      font-weight: 700;
      letter-spacing: 0.16em;
    }

    .blog-empty-copy h2 {
      color: var(--blog-ink);
      font-family: "Noto Serif SC", "Songti SC", SimSun, serif;
      font-size: clamp(2rem, 4.4vw, 4rem);
      font-weight: 500;
      line-height: 1.18;
    }

    .blog-empty-copy > span {
      color: var(--blog-muted);
    }

    .blog-empty-plate {
      position: relative;
      min-width: 0;
      margin: 0;
      padding: 10px 10px 0;
      background: rgba(231, 233, 230, 0.3);
      border: 1px solid var(--blog-line);
      box-shadow: 18px 20px 0 rgba(57, 64, 61, 0.08);
      transform: rotate(1.2deg);
    }

    .blog-empty-plate::before {
      content: "";
      position: absolute;
      inset: 20px -15px -15px 20px;
      z-index: -1;
      border: 1px solid rgba(36, 40, 39, 0.16);
    }

    .blog-empty-plate img {
      display: block;
      width: 100%;
      aspect-ratio: 16 / 10;
      object-fit: cover;
      object-position: 50% 27%;
      filter: grayscale(1) contrast(0.92) brightness(0.84);
      opacity: 0.78;
    }

    .blog-empty-plate figcaption {
      display: flex;
      justify-content: space-between;
      gap: 16px;
      padding: 12px 2px 11px;
      color: var(--blog-muted);
      font-family: "Cascadia Code", "Fira Code", Consolas, monospace;
      font-size: 0.62rem;
      letter-spacing: 0.1em;
    }

    .blog-archive-page :global(.blog-timeline) {
      width: min(1120px, calc(100% - 48px));
      padding-top: 38px;
    }

    .blog-archive-page :global(.blog-timeline::before) {
      width: 1px;
      background: var(--blog-line);
      opacity: 1;
    }

    .blog-archive-page :global(.blog-timeline-item::before) {
      width: 11px;
      height: 11px;
      background: var(--blog-signal);
      border: 2px solid var(--blog-paper);
      box-shadow: 0 0 0 1px var(--blog-line);
    }

    .blog-archive-page :global(.blog-post-row) {
      background: transparent;
      border: 0;
      border-bottom: 1px solid var(--blog-line);
      border-radius: 0;
      box-shadow: none;
      backdrop-filter: none;
      -webkit-backdrop-filter: none;
    }

    .blog-archive-page :global(.post-cover-frame img) {
      filter: grayscale(1) contrast(0.9);
    }

    .blog-archive-page :global(.tag-row span) {
      color: var(--blog-muted);
      background: transparent;
      border: 0;
      border-left: 2px solid var(--blog-signal);
      border-radius: 0;
    }

    .blog-archive-page :global(.post-list) {
      display: none;
    }

    :global(body:has(.blog-archive-page)) {
      --blog-paper: #c9ccca;
      --blog-paper-deep: #b9bdbb;
      --blog-ink: #222625;
      --blog-muted: #58605d;
      --blog-line: rgba(36, 40, 39, 0.22);
      --blog-signal: #763b3f;
      color: var(--blog-ink);
      background: var(--blog-paper);
    }

    :global(body:has(.blog-archive-page)::before) {
      opacity: 0;
    }

    :global(body:has(.blog-archive-page) .site-footer) {
      padding-top: 60px;
      padding-bottom: 74px;
      color: #343837;
      background: var(--blog-paper-deep);
      border-top: 1px solid var(--blog-line);
    }

    :global(body:has(.blog-archive-page) .footer-inner) {
      border-top: 1px solid var(--blog-line);
    }

    @media (max-width: 760px) {
      .blog-archive-page {
        padding-top: 96px;
      }

      .blog-hero-card,
      .blog-search-card,
      .blog-empty-state {
        grid-template-columns: 1fr;
        width: min(100% - 32px, 1120px);
      }

      .blog-hero-card {
        padding-bottom: 32px;
      }

      .blog-hero-note {
        gap: 14px;
        padding: 18px 0 0;
        border-top: 1px solid var(--blog-line);
        border-left: 0;
      }

      .blog-search-card {
        gap: 22px;
      }

      .blog-empty-state {
        min-height: 300px;
        gap: 34px;
      }

      .blog-empty-plate {
        width: calc(100% - 12px);
      }
    }

    @media (prefers-reduced-motion: reduce) {
      .blog-archive-page :global(*) {
        scroll-behavior: auto;
      }
    }
  </style>
</BaseLayout>
