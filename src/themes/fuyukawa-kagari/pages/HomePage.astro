---
import BaseLayout from "../layouts/BaseLayout.astro";
import { kagariAssets } from "../assets";
import { profileIdentity } from "@/core/data/profile";
import { portfolioRoleLine } from "@/core/data/portfolio";
import { site } from "@/lib/site";

const forceMotionPreview = Astro.url.searchParams.get("motion") === "force";
---

<BaseLayout>
  <section
    class="hero-stage"
    data-hero-stage
    data-dev-motion-preview={forceMotionPreview ? "force" : undefined}
  >
    <div class="hero">
      <div class="hero-overlay"></div>
      <div class="hero-copy">
        <p class="eyebrow">{portfolioRoleLine}</p>
        <h1 data-title={site.name}>{site.name}</h1>
        <p class="hero-text terminal-line" aria-label="typing subtitle">
          <span class="hero-terminal-stack">
            <span class="hero-terminal-status" aria-hidden="true">
              <span></span>
              <span></span>
              <span></span>
            </span>
            <span class="hero-terminal-command">
              <span class="terminal-prefix">rain@home:~$</span>
              <span class="terminal-typing" data-terminal-typing></span>
            </span>
          </span>
          <span class="terminal-cursor" aria-hidden="true"></span>
        </p>
      </div>

      <div class="hero-profile identity-card" data-hero-profile aria-label="Profile">
        <div class="identity-avatar" data-poke-avatar>
          <img src={kagariAssets.profile} alt={`${profileIdentity.displayName} 的头像`} width="168" height="168" />
          <span class="avatar-poke-bubble" data-poke-bubble>&#x64CD;&#x4F5C;&#x592A;&#x5FEB;&#x5566;&#xFF0C;&#x4F11;&#x606F;&#x4E00;&#x4E0B;&#x5427;</span>
        </div>
        <div class="identity-terminal" role="group" aria-label="identity terminal card">
          <div class="identity-terminal-bar">
            <div class="terminal-dots" aria-hidden="true">
              <span></span>
              <span></span>
              <span></span>
            </div>
            <span class="terminal-title">rain-dust-profile.exe</span>
          </div>
          <p class="identity-path">C:\Users\Rain_dust\profile</p>
          <p class="identity-command">
            <span class="terminal-prefix">profile@rain-dust:~$</span>
            <span data-name-typing></span>
            <span class="terminal-cursor" aria-hidden="true"></span>
          </p>
          <p class="identity-caption">{profileIdentity.displayName} / {profileIdentity.handle}</p>
          <section class="identity-status" aria-labelledby="identity-status-title">
            <div class="identity-status-heading">
              <span id="identity-status-title">STATUS</span>
              <span class="identity-status-signal" aria-hidden="true">ACTIVE</span>
            </div>
            <ul>
              <li><span aria-hidden="true">›</span> 推进自瞄算法迭代</li>
              <li><span aria-hidden="true">›</span> 优化 Earth Online</li>
              <li><span aria-hidden="true">›</span> 为 AstrBot 编写插件</li>
              <li><span aria-hidden="true">›</span> 利用 Obsidian 搭建自我预测模型</li>
            </ul>
          </section>
          <div class="social-links" aria-label="Social links">
            <a href={profileIdentity.github} target="_blank" rel="noreferrer" aria-label="GitHub profile">
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path d="M12 .5C5.65.5.5 5.65.5 12c0 5.1 3.29 9.4 7.86 10.93.58.1.79-.25.79-.56v-2.16c-3.2.7-3.87-1.38-3.87-1.38-.52-1.33-1.27-1.68-1.27-1.68-1.04-.71.08-.7.08-.7 1.15.08 1.76 1.18 1.76 1.18 1.02 1.75 2.68 1.24 3.34.95.1-.74.4-1.24.72-1.53-2.56-.29-5.25-1.28-5.25-5.7 0-1.26.45-2.29 1.18-3.1-.12-.29-.51-1.47.11-3.06 0 0 .97-.31 3.16 1.18A10.9 10.9 0 0 1 12 5.98c.98 0 1.96.13 2.88.39 2.19-1.49 3.15-1.18 3.15-1.18.63 1.59.24 2.77.12 3.06.74.81 1.18 1.84 1.18 3.1 0 4.43-2.7 5.41-5.27 5.7.41.36.77 1.06.77 2.14v3.18c0 .31.21.67.8.56A11.51 11.51 0 0 0 23.5 12C23.5 5.65 18.35.5 12 .5Z" />
              </svg>
              GitHub
            </a>
            <a href={profileIdentity.email} aria-label="Email">
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path d="M3.5 5.5h17v13h-17zM4 6l8 7 8-7" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" />
              </svg>
              Email
            </a>
          </div>
          <section class="hero-story identity-terminal-extension" data-hero-story aria-hidden="true">
            <div class="identity-terminal-extension__body">
              <p class="identity-terminal-extension__command">
                <span class="terminal-prefix">profile@rain-dust:~$</span>
                <span>identify --profile</span>
              </p>
              <div class="identity-terminal-extension__output">
                <div class="identity-terminal-extension__headline">
                  <span>IDENTITY</span>
                  <strong>19-YEAR-OLD</strong>
                  <b>CREATIVE VIBECODER</b>
                </div>
                <dl class="identity-terminal-extension__facts">
                  <div>
                    <dt>ROLE</dt>
                    <dd>CREATIVE ENGINEER</dd>
                  </div>
                  <div>
                    <dt>MODE</dt>
                    <dd>INDEPENDENT BUILDER</dd>
                  </div>
                  <div>
                    <dt>MISSION</dt>
                    <dd>GUIKE HACKATHON 2026</dd>
                  </div>
                </dl>
                <p class="identity-terminal-extension__focus">
                  <span>FOCUS</span>
                  <strong>AI PROTOTYPES</strong>
                  <i aria-hidden="true">/</i>
                  <strong>INTERACTIVE WEB</strong>
                  <i aria-hidden="true">/</i>
                  <strong>AUTOMATION</strong>
                </p>
              </div>
            </div>
          </section>
        </div>
          <a
            class="identity-rift"
            data-identity-rift
            href="/projects/"
            aria-label="Execute Works"
          >
            <span class="identity-rift__fracture" aria-hidden="true">
              <canvas class="identity-rift__canvas" data-identity-rift-canvas></canvas>
              <span class="identity-rift__fallback"></span>
            </span>
            <span class="identity-rift__prompt">
              <small>&gt; EXECUTE</small>
              <strong>/WORKS</strong>
            </span>
          </a>
      </div>

    </div>
  </section>


  <script data-astro-rerun define:vars={{ heroWallpaper: kagariAssets.heroWallpaper }}>
    (() => {
    window.__yuimiHeroCleanup?.();
    const heroCleanupTasks = [];
    window.__yuimiHeroCleanup = () => {
      heroCleanupTasks.splice(0).forEach((cleanup) => cleanup());
    };

    const stage = document.querySelector("[data-hero-stage]");
    const hero = stage?.querySelector(".hero");
    const typingTarget = document.querySelector("[data-terminal-typing]");
    const nameTarget = document.querySelector("[data-name-typing]");
    const story = document.querySelector("[data-hero-story]");
    const rift = document.querySelector("[data-identity-rift]");
    const profile = document.querySelector("[data-hero-profile]");
    const avatar = profile?.querySelector(".identity-avatar");
    const terminal = profile?.querySelector(".identity-terminal");
    const riftCanvas = rift?.querySelector("[data-identity-rift-canvas]");

    const createRiftRenderer = (canvas, riftRoot, stageRoot) => {
      if (!(canvas instanceof HTMLCanvasElement) || !(riftRoot instanceof HTMLElement) || !(stageRoot instanceof HTMLElement)) {
        return null;
      }

      const context = canvas.getContext("2d", { alpha: true });
      const fallback = riftRoot.querySelector(".identity-rift__fallback");
      if (!context) {
        fallback?.classList.add("is-visible");
        return null;
      }

      const source = new Image();
      source.decoding = "async";
      source.src = heroWallpaper;

      let frame = 0;
      let active = false;
      let ready = false;
      let hovered = false;
      let destroyed = false;
      let formationStartedAt = 0;
      let executeStartedAt = 0;
      let glitchUntil = 0;
      let nextGlitchAt = Number.POSITIVE_INFINITY;
      let glitchTimer = 0;
      let width = 0;
      let height = 0;
      let dpr = 1;

      const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
      const motionAllowed = () => !reducedMotion.matches || stageRoot.dataset.devMotionPreview === "force";
      const smoothstep = (value) => value * value * (3 - 2 * value);
      const clampUnit = (value) => Math.min(1, Math.max(0, value));
      const seeded = (seed) => {
        const value = Math.sin(seed * 12.9898 + 78.233) * 43758.5453;
        return value - Math.floor(value);
      };

      const resize = () => {
        const rect = canvas.getBoundingClientRect();
        if (!rect.width || !rect.height) return;
        dpr = Math.min(window.devicePixelRatio || 1, 2);
        width = rect.width;
        height = rect.height;
        const pixelWidth = Math.max(1, Math.round(width * dpr));
        const pixelHeight = Math.max(1, Math.round(height * dpr));
        if (canvas.width !== pixelWidth || canvas.height !== pixelHeight) {
          canvas.width = pixelWidth;
          canvas.height = pixelHeight;
        }
      };

      const crackCenter = (y) => {
        const normalized = y / Math.max(height, 1);
        return width * 0.5
          + Math.sin(normalized * 7.2 + 0.5) * 3.2
          + Math.sin(normalized * 17.4 + 1.8) * 1.6
          + Math.sin(normalized * 3.4 - 0.7) * 2.4;
      };

      const crackHalfWidth = (y, opening) => {
        const normalized = y / Math.max(height, 1);
        const taper = Math.pow(Math.max(0, Math.sin(Math.PI * normalized)), 0.58);
        const texture = 0.82 + 0.18 * Math.sin(normalized * 21 + 0.4);
        return Math.max(0.35, opening * taper * texture);
      };

      const traceCrack = (opening) => {
        context.beginPath();
        for (let y = 0; y <= height; y += 3) {
          const x = crackCenter(y) - crackHalfWidth(y, opening);
          if (y === 0) context.moveTo(x, y);
          else context.lineTo(x, y);
        }
        for (let y = height; y >= 0; y -= 3) {
          context.lineTo(crackCenter(y) + crackHalfWidth(y, opening), y);
        }
        context.closePath();
      };

      const drawWorksSliver = (opening) => {
        context.save();
        traceCrack(opening);
        context.clip();

        const wall = context.createLinearGradient(width * 0.2, 0, width * 0.8, height);
        wall.addColorStop(0, "#0d0f0e");
        wall.addColorStop(0.52, "#171713");
        wall.addColorStop(1, "#25221e");
        context.fillStyle = wall;
        context.fillRect(0, 0, width, height);

        const warmLight = context.createRadialGradient(width * 0.72, height * 0.25, 0, width * 0.72, height * 0.25, height * 0.56);
        warmLight.addColorStop(0, "rgba(151, 126, 102, 0.52)");
        warmLight.addColorStop(0.42, "rgba(102, 87, 72, 0.18)");
        warmLight.addColorStop(1, "rgba(15, 16, 14, 0)");
        context.fillStyle = warmLight;
        context.fillRect(0, 0, width, height);

        context.fillStyle = "rgba(5, 6, 6, 0.62)";
        context.beginPath();
        context.moveTo(width * 0.58, 0);
        context.lineTo(width, 0);
        context.lineTo(width * 0.46, height);
        context.lineTo(width * 0.12, height);
        context.closePath();
        context.fill();

        context.strokeStyle = "rgba(205, 190, 174, 0.12)";
        context.lineWidth = 1;
        for (let y = 20; y < height; y += 38) {
          context.beginPath();
          context.moveTo(0, y + 0.5);
          context.lineTo(width, y + 0.5);
          context.stroke();
        }
        context.restore();
      };

      const drawEdge = (opening, offset, color, alpha, lineWidth = 1) => {
        context.save();
        context.globalAlpha = alpha;
        context.strokeStyle = color;
        context.lineWidth = lineWidth;
        context.beginPath();
        for (let y = 1; y < height; y += 3) {
          const x = crackCenter(y) + crackHalfWidth(y, opening) * offset;
          if (y === 1) context.moveTo(x, y);
          else context.lineTo(x, y);
        }
        context.stroke();
        context.restore();
      };

      const drawSourceBand = (y, bandHeight, offset, tint, alpha) => {
        if (!source.complete || !source.naturalWidth) return;
        const stageRect = stageRoot.getBoundingClientRect();
        const canvasRect = canvas.getBoundingClientRect();
        const coverScale = Math.max(stageRect.width / source.naturalWidth, stageRect.height / source.naturalHeight);
        const renderedWidth = source.naturalWidth * coverScale;
        const renderedHeight = source.naturalHeight * coverScale;
        const imageLeft = stageRect.left + (stageRect.width - renderedWidth) / 2;
        const imageTop = stageRect.top + (stageRect.height - renderedHeight) / 2;
        const sampleWidth = Math.min(112, width * 0.76);
        const destinationX = (width - sampleWidth) / 2 + offset;
        const sourceX = (canvasRect.left + (width - sampleWidth) / 2 - imageLeft) / coverScale;
        const sourceY = (canvasRect.top + y - imageTop) / coverScale;
        const sourceWidth = sampleWidth / coverScale;
        const sourceHeight = bandHeight / coverScale;

        context.save();
        context.globalAlpha = alpha;
        context.drawImage(source, sourceX, sourceY, sourceWidth, sourceHeight, destinationX, y, sampleWidth, bandHeight);
        context.globalCompositeOperation = "screen";
        context.fillStyle = tint;
        context.fillRect(destinationX, y, sampleWidth, bandHeight);
        context.restore();
      };

      const drawGlitch = (now, intensity) => {
        const tick = Math.floor(now / 32);
        const colors = [
          "rgba(255, 10, 62, 0.64)",
          "rgba(0, 221, 255, 0.62)",
          "rgba(255, 28, 211, 0.56)",
          "rgba(70, 255, 139, 0.48)",
          "rgba(246, 235, 54, 0.46)"
        ];
        for (let index = 0; index < 7; index += 1) {
          const y = seeded(tick * 17 + index * 31) * height;
          const bandHeight = 1 + seeded(tick * 23 + index * 11) * 7;
          const direction = seeded(tick * 29 + index * 7) > 0.5 ? 1 : -1;
          const displacement = direction * (16 + seeded(tick * 41 + index) * 68) * intensity;
          drawSourceBand(y, bandHeight, displacement, colors[index % colors.length], 0.48 + intensity * 0.36);
        }
      };

      const render = (now) => {
        frame = 0;
        if (!active || destroyed) return;
        resize();
        context.setTransform(dpr, 0, 0, dpr, 0, 0);
        context.clearRect(0, 0, width, height);

        const formationElapsed = formationStartedAt ? now - formationStartedAt : 900;
        const formation = smoothstep(clampUnit(formationElapsed / 820));
        const executing = executeStartedAt ? smoothstep(clampUnit((now - executeStartedAt) / 320)) : 0;
        const baseOpening = (7.5 + hovered * 5.5) * formation;
        const opening = baseOpening + executing * Math.max(width * 0.48, 42);
        const glitching = now < glitchUntil;

        drawWorksSliver(opening);
        drawEdge(opening, -1, "#d6d8d3", 0.42, 0.9);
        drawEdge(opening, 1, "#aeb3b2", 0.54, 1.05);
        drawEdge(opening + 2.2, -1, "#242a2d", 0.28, 0.7);
        drawEdge(opening + 2.2, 1, "#242a2d", 0.34, 0.7);

        if (glitching) {
          const remaining = clampUnit((glitchUntil - now) / 150);
          drawGlitch(now, Math.max(0.42, remaining));
          drawEdge(opening + 3, -1, "#ff164f", 0.58, 1.4);
          drawEdge(opening + 4, 1, "#00e1ff", 0.62, 1.4);
        }

        // The hero narrative is the site's core interaction: the crack
        // formation and execution always animate, regardless of
        // reduced-motion. Ambient glitches still respect the preference.
        if (formation < 1 || glitching || executeStartedAt) {
          frame = window.requestAnimationFrame(render);
          return;
        }
        frame = 0;

        // The crack is static between glitches: stop the loop and wake up
        // only for the next glitch instead of redrawing at 60fps forever.
        if (motionAllowed() && ready && !hovered && !executeStartedAt && nextGlitchAt !== Number.POSITIVE_INFINITY) {
          window.clearTimeout(glitchTimer);
          glitchTimer = window.setTimeout(() => {
            glitchTimer = 0;
            glitchUntil = performance.now() + 80 + Math.random() * 80;
            nextGlitchAt = performance.now() + 2400 + Math.random() * 3400;
            schedule();
          }, Math.max(140, nextGlitchAt - now));
        }
      };

      const schedule = () => {
        if (!frame && active && !destroyed) frame = window.requestAnimationFrame(render);
      };

      const startFormation = () => {
        active = true;
        ready = false;
        executeStartedAt = 0;
        formationStartedAt = performance.now();
        glitchUntil = formationStartedAt + 520;
        nextGlitchAt = formationStartedAt + 2800 + Math.random() * 2200;
        fallback?.classList.remove("is-visible");
        canvas.classList.add("is-ready");
        schedule();
      };

      const settle = () => {
        active = true;
        ready = true;
        nextGlitchAt = performance.now() + 2200 + Math.random() * 3200;
        schedule();
      };

      const reset = () => {
        active = false;
        ready = false;
        hovered = false;
        formationStartedAt = 0;
        executeStartedAt = 0;
        glitchUntil = 0;
        nextGlitchAt = Number.POSITIVE_INFINITY;
        window.clearTimeout(glitchTimer);
        glitchTimer = 0;
        window.cancelAnimationFrame(frame);
        frame = 0;
        context.setTransform(1, 0, 0, 1, 0, 0);
        context.clearRect(0, 0, canvas.width, canvas.height);
      };

      const execute = () => {
        executeStartedAt = performance.now();
        glitchUntil = executeStartedAt + 260;
        schedule();
      };

      const handleEnter = () => {
        hovered = true;
        glitchUntil = performance.now() + 110;
        schedule();
      };
      const handleLeave = () => {
        hovered = false;
        schedule();
      };
      const handleFocus = () => handleEnter();
      const handleBlur = () => handleLeave();

      riftRoot.addEventListener("pointerenter", handleEnter);
      riftRoot.addEventListener("pointerleave", handleLeave);
      riftRoot.addEventListener("focus", handleFocus);
      riftRoot.addEventListener("blur", handleBlur);
      source.addEventListener("load", schedule, { once: true });
      source.addEventListener("error", () => fallback?.classList.add("is-visible"), { once: true });

      return {
        startFormation,
        settle,
        reset,
        resize: schedule,
        execute,
        destroy() {
          destroyed = true;
          reset();
          riftRoot.removeEventListener("pointerenter", handleEnter);
          riftRoot.removeEventListener("pointerleave", handleLeave);
          riftRoot.removeEventListener("focus", handleFocus);
          riftRoot.removeEventListener("blur", handleBlur);
        }
      };
    };

    const riftRenderer = createRiftRenderer(riftCanvas, rift, stage);

    const clamp = (value, min = 0, max = 1) => Math.min(max, Math.max(min, value));
    const pullDistance = 260;
    const dockThreshold = 0.56;
    const resetDelay = 260;
    const releaseDelay = 120;
    const terminalLines = [
      "echo \"把模糊想法快速构建成可运行原型\"",
      "vibe --build",
      "collect \"blue moments\" && write",
      "npm run scrapbook"
    ];
    const nameLines = ["寻辰沐雨", "Rain_dust"];

    let pull = 0;
    let targetPull = 0;
    let pullFrame = 0;
    let storyPull = 0;
    let state = "idle";
    let resetTimer = 0;
    let releaseTimer = 0;
    let riftTimer = 0;
    let riftNavigationTimer = 0;
    let riftNavigationArmed = false;
    const typingTimers = new Set();

    // Frame-animated interpolation between the wheel target and the rendered
    // pull so discrete wheel notches read as one fluid motion.
    const animatePull = () => {
      const delta = targetPull - pull;
      if (Math.abs(delta) < 0.6) {
        pull = targetPull;
        setProgress(pull / pullDistance);
        pullFrame = 0;
        return;
      }
      pull += delta * 0.16;
      setProgress(pull / pullDistance);
      pullFrame = window.requestAnimationFrame(animatePull);
    };
    const startPullAnimation = () => {
      if (!pullFrame) pullFrame = window.requestAnimationFrame(animatePull);
    };

    const setTypingTimer = (callback, delay) => {
      const timer = window.setTimeout(() => {
        typingTimers.delete(timer);
        callback();
      }, delay);
      typingTimers.add(timer);
    };

    const runTypingLoop = (target, lines, writeDelay = 58, eraseDelay = 32, holdDelay = 1250) => {
      if (!target) return;

      let lineIndex = 0;
      let charIndex = 0;
      let deleting = false;

      const tick = () => {
        const line = lines[lineIndex];
        target.textContent = line.slice(0, charIndex);

        if (!deleting && charIndex < line.length) {
          charIndex += 1;
          setTypingTimer(tick, writeDelay);
          return;
        }

        if (!deleting && charIndex === line.length) {
          deleting = true;
          setTypingTimer(tick, holdDelay);
          return;
        }

        if (deleting && charIndex > 0) {
          charIndex -= 1;
          setTypingTimer(tick, eraseDelay);
          return;
        }

        deleting = false;
        lineIndex = (lineIndex + 1) % lines.length;
        setTypingTimer(tick, 360);
      };

      tick();
    };

    if ("scrollRestoration" in history) {
      history.scrollRestoration = "manual";
    }

    if (!location.hash) {
      requestAnimationFrame(() => window.scrollTo({ top: 0, left: 0 }));
    }

    const setProgress = (progress) => {
      if (!hero) return;

      const value = clamp(progress);
      hero.style.setProperty("--avatar-y", `${(1 - value) * 56}vh`);
      hero.style.setProperty("--avatar-scale", `${0.78 + value * 0.22}`);
      hero.style.setProperty("--profile-opacity", `${clamp((value - 0.08) / 0.48)}`);
      hero.style.setProperty("--copy-opacity", `${1 - clamp((value - 0.12) / 0.42)}`);
      hero.style.setProperty("--cue-opacity", `${1 - clamp(value / 0.48)}`);
    };

    const setStoryProgress = (progress) => {
      if (!hero || !story) return;

      const value = clamp(progress);
      const extensionProgress = value;
      const identityOpacity = value;
      const concealed = 1 - extensionProgress;

      hero.style.setProperty("--story-progress", `${value}`);
      hero.style.setProperty("--story-extension-progress", `${extensionProgress}`);
      hero.style.setProperty("--story-extension-clip", `${concealed * 100}%`);
      hero.style.setProperty("--story-extension-y", `${concealed * -22}px`);
      hero.style.setProperty("--story-extension-scale", `${0.78 + extensionProgress * 0.22}`);
      hero.style.setProperty("--story-extension-bend", "0deg");
      hero.style.setProperty("--story-identity-opacity", `${identityOpacity}`);
      hero.classList.toggle("is-story-active", value > 0.01);
      hero.classList.toggle("is-story-identity", identityOpacity > 0.08);
      story.setAttribute("aria-hidden", value > 0.01 ? "false" : "true");
    };

    const clearRiftState = () => {
      window.clearTimeout(riftTimer);
      riftTimer = 0;
      riftRenderer?.reset();
      hero?.classList.remove("is-rift-forming", "is-rift-ready", "is-rift-executing");
      hero?.style.removeProperty("--rift-terminal-x");
      hero?.style.removeProperty("--rift-terminal-y");
      hero?.style.removeProperty("--rift-terminal-origin-y");
      hero?.style.removeProperty("--rift-avatar-x");
      hero?.style.removeProperty("--rift-avatar-y");
      rift?.setAttribute("aria-hidden", "true");
      rift?.setAttribute("tabindex", "-1");
    };

    const completeRift = () => {
      if (!hero || state !== "rift" || !hero.classList.contains("is-rift-forming")) return;
      hero.classList.remove("is-rift-forming");
      hero.classList.add("is-rift-ready");
      riftRenderer?.settle();
      window.clearTimeout(riftTimer);
      riftTimer = 0;
    };

    const handleRiftAnimationEnd = (event) => {
      if (event.target === rift && event.animationName === "identity-rift-data-form") completeRift();
    };
    rift?.addEventListener("animationend", handleRiftAnimationEnd);
    heroCleanupTasks.push(() => rift?.removeEventListener("animationend", handleRiftAnimationEnd));

    const formRift = () => {
      if (!hero || !rift || state !== "story") return;
      const heroRect = hero.getBoundingClientRect();
      const profileRect = profile?.getBoundingClientRect();
      const targetX = heroRect.left + heroRect.width * 0.5;
      const targetY = heroRect.top + heroRect.height * 0.56;
      if (terminal && profileRect) {
        const socialLinks = terminal.querySelector(".social-links");
        const mainHeight = socialLinks
          ? socialLinks.offsetTop + socialLinks.offsetHeight
          : Math.min(terminal.offsetHeight, 294);
        const originY = mainHeight / 2;
        const centerX = profileRect.left + terminal.offsetLeft + terminal.offsetWidth / 2;
        const centerY = profileRect.top + terminal.offsetTop + originY;
        hero.style.setProperty("--rift-terminal-x", `${targetX - centerX}px`);
        hero.style.setProperty("--rift-terminal-y", `${targetY - centerY}px`);
        hero.style.setProperty("--rift-terminal-origin-y", `${originY}px`);
      }
      if (avatar && profileRect) {
        const centerX = profileRect.left + avatar.offsetLeft + avatar.offsetWidth / 2;
        const centerY = profileRect.top + avatar.offsetTop + avatar.offsetHeight / 2;
        hero.style.setProperty("--rift-avatar-x", `${targetX - centerX}px`);
        hero.style.setProperty("--rift-avatar-y", `${targetY - centerY}px`);
      }
      state = "rift";
      hero.classList.remove("is-rift-ready", "is-rift-executing");
      hero.classList.add("is-rift-forming");
      riftRenderer?.startFormation();
      rift.setAttribute("aria-hidden", "false");
      rift.setAttribute("tabindex", "0");
      window.clearTimeout(riftTimer);
      riftTimer = window.setTimeout(completeRift, 900);
    };

    const resetPull = () => {
      if (state === "passed") return;
      window.clearTimeout(resetTimer);
      window.clearTimeout(releaseTimer);
      targetPull = 0;
      storyPull = 0;
      state = "idle";
      clearRiftState();
      hero?.classList.remove("is-docked", "is-pulling", "is-story-active", "is-story-identity");
      startPullAnimation();
    };

    const settlePull = () => {
      if (state !== "pulling") return;

      if (targetPull / pullDistance >= dockThreshold) {
        dockProfile();
      } else {
        resetPull();
      }
    };

    const schedulePullSettle = () => {
      window.clearTimeout(resetTimer);
      resetTimer = window.setTimeout(settlePull, resetDelay);
    };

    const dockProfile = () => {
      targetPull = pullDistance;
      state = "docked";
      hero?.classList.remove("is-pulling");
      hero?.classList.add("is-docked");
      startPullAnimation();

      window.clearTimeout(releaseTimer);
      releaseTimer = window.setTimeout(() => {
        state = "docked";
      }, releaseDelay);
    };

    const handleHeroWheel = (event) => {
      if (!stage || !hero) return;
      if (state === "passed") return;

      const atHeroTop = window.scrollY <= 2 && stage.getBoundingClientRect().top >= -2;
      if (!atHeroTop) {
        return;
      }

      if (event.deltaY < 0) {
        event.preventDefault();
        window.clearTimeout(releaseTimer);

        if (state === "rift") {
          clearRiftState();
          state = "story";
          storyPull = 1;
          setStoryProgress(1);
          return;
        }

        if (storyPull > 0) {
          storyPull = 0;
          state = "docked";
          setStoryProgress(0);
          return;
        }

        if (state === "docked" || state === "story") {
          pull = 0;
          state = "idle";
          hero.classList.remove("is-docked", "is-pulling");
          setProgress(0);
          setStoryProgress(0);
          return;
        }

        targetPull = clamp(targetPull + event.deltaY * 0.82, 0, pullDistance);
        state = targetPull > 0 ? "pulling" : "idle";
        hero.classList.toggle("is-pulling", state === "pulling");
        hero.classList.remove("is-docked");
        startPullAnimation();
        if (state === "pulling") {
          schedulePullSettle();
        } else {
          window.clearTimeout(resetTimer);
        }
        return;
      }

      if (state === "docked") {
        event.preventDefault();
        storyPull = 1;
        state = "story";
        setStoryProgress(1);
        return;
      }
      if (state === "story") {
        event.preventDefault();
        formRift();
        return;
      }
      if (state === "rift") {
        // The rift is ready; let the wheel scroll the page normally.
        return;
      }

      event.preventDefault();
      window.clearTimeout(releaseTimer);

      const resistance = 1 - clamp(targetPull / pullDistance) * 0.5;
      targetPull = clamp(targetPull + event.deltaY * resistance, 0, pullDistance);

      hero.classList.add("is-pulling");
      hero.classList.remove("is-docked");
      state = "pulling";
      startPullAnimation();
      schedulePullSettle();
    };

    const handleHeroScroll = () => {
      if (!stage || !hero) return;

      const nativeProgress = clamp(-stage.getBoundingClientRect().top / (window.innerHeight || 1));
      hero.style.setProperty("--hero-dim", `${0.12 + clamp((nativeProgress - 1.05) / 0.25) * 0.12}`);

      // Anyone who scrolls past the hero without the wheel narrative
      // (keyboard, scrollbar, touch) gets the identity card revealed.
      // The rift state stays untouched so the narrative remains reversible
      // after its pass-through scroll (wheel up rewinds story -> dock -> idle).
      if (window.scrollY > 2 && state !== "passed" && state !== "rift") {
        state = "passed";
        setProgress(1);
        hero.classList.add("is-docked");
      }
    };

    runTypingLoop(typingTarget, terminalLines);
    runTypingLoop(nameTarget, nameLines, 96, 46, 1500);

    const pokeAvatar = document.querySelector("[data-poke-avatar]");
    const pokeBubble = document.querySelector("[data-poke-bubble]");
    let lastPokeAt = 0;
    let bubbleTimer = 0;

    const showPokeBubble = (text) => {
      if (!pokeBubble) return;
      pokeBubble.textContent = text;
      pokeBubble.classList.add("is-visible");
      window.clearTimeout(bubbleTimer);
      bubbleTimer = window.setTimeout(() => {
        pokeBubble.classList.remove("is-visible");
      }, 1700);
    };

    const handlePokeMove = (event) => {
      const rect = pokeAvatar.getBoundingClientRect();
      const offset = ((event.clientX - rect.left) / rect.width - 0.5) * 2;
      pokeAvatar.style.setProperty("--flower-sway", `${offset * 9}deg`);
    };

    const handlePokeLeave = () => {
      pokeAvatar.style.setProperty("--flower-sway", "0deg");
    };

    const handlePokeDoubleClick = (event) => {
      event.preventDefault();
      const now = Date.now();
      if (now - lastPokeAt < 10000) {
        showPokeBubble("\u64cd\u4f5c\u592a\u5feb\u5566\uff0c\u4f11\u606f\u4e00\u4e0b\u5427");
        return;
      }

      lastPokeAt = now;
      pokeAvatar.classList.remove("is-poked");
      void pokeAvatar.offsetWidth;
      pokeAvatar.classList.add("is-poked");
      showPokeBubble("\u6233\u5230\u4e86~");
      window.setTimeout(() => pokeAvatar.classList.remove("is-poked"), 720);
    };

    const handleRiftClick = (event) => {
      if (!rift || !hero) return;
      if (state !== "rift") {
        // The rift acts as a normal link outside the wheel narrative.
        return;
      }
      if (riftNavigationArmed) return;

      event.preventDefault();
      riftNavigationArmed = true;
      riftRenderer?.execute();
      hero.classList.remove("is-rift-forming");
      hero.classList.add("is-rift-ready", "is-rift-executing");
      window.clearTimeout(riftNavigationTimer);
      riftNavigationTimer = window.setTimeout(() => {
        riftNavigationTimer = 0;
        rift.click();
      }, 340);
    };

    pokeAvatar?.addEventListener("pointermove", handlePokeMove);
    pokeAvatar?.addEventListener("pointerleave", handlePokeLeave);
    pokeAvatar?.addEventListener("dblclick", handlePokeDoubleClick);
    rift?.addEventListener("click", handleRiftClick);
    heroCleanupTasks.push(() => {
      pokeAvatar?.removeEventListener("pointermove", handlePokeMove);
      pokeAvatar?.removeEventListener("pointerleave", handlePokeLeave);
      pokeAvatar?.removeEventListener("dblclick", handlePokeDoubleClick);
      rift?.removeEventListener("click", handleRiftClick);
    });

    setProgress(0);
    setStoryProgress(0);
    handleHeroScroll();

    window.addEventListener("wheel", handleHeroWheel, { passive: false });
    window.addEventListener("scroll", handleHeroScroll, { passive: true });
    const handleHeroResize = () => {
      handleHeroScroll();
      riftRenderer?.resize();
    };
    window.addEventListener("resize", handleHeroResize);
    window.addEventListener("pageshow", handleHeroScroll);
    document.addEventListener("astro:before-swap", () => {
      heroCleanupTasks.splice(0).forEach((cleanup) => cleanup());
    }, { once: true });
    heroCleanupTasks.push(() => {
      window.clearTimeout(resetTimer);
      window.cancelAnimationFrame(pullFrame);
      pullFrame = 0;
      window.clearTimeout(releaseTimer);
      window.clearTimeout(riftTimer);
      window.clearTimeout(riftNavigationTimer);
      window.clearTimeout(bubbleTimer);
      typingTimers.forEach((timer) => window.clearTimeout(timer));
      typingTimers.clear();
      window.removeEventListener("wheel", handleHeroWheel);
      window.removeEventListener("scroll", handleHeroScroll);
      window.removeEventListener("resize", handleHeroResize);
      window.removeEventListener("pageshow", handleHeroScroll);
      riftRenderer?.destroy();
    });
    })();
  </script>

</BaseLayout>
