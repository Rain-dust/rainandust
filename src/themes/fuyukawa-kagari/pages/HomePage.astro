---
import BaseLayout from "../layouts/BaseLayout.astro";
import { kagariAssets } from "../assets";
import { profileIdentity } from "@/core/data/profile";
import { portfolioRoleLine } from "@/core/data/portfolio";
import { site } from "@/lib/site";

const forceMotionPreview = Astro.url.searchParams.get("motion") === "force";
---

<BaseLayout>
  <section
    class="hero-stage"
    data-hero-stage
    data-dev-motion-preview={forceMotionPreview ? "force" : undefined}
  >
    <div class="hero">
      <div class="hero-overlay"></div>
      <div class="hero-copy" data-hero-copy>
        <p class="eyebrow">{portfolioRoleLine}</p>
        <h1 data-title={site.name}>{site.name}</h1>
        <p class="hero-text terminal-line" aria-label="typing subtitle">
          <span class="hero-terminal-stack">
            <span class="hero-terminal-status" aria-hidden="true">
              <span></span>
              <span></span>
              <span></span>
            </span>
            <span class="hero-terminal-command">
              <span class="terminal-prefix">rain@home:~$</span>
              <span class="terminal-typing" data-terminal-typing></span>
            </span>
          </span>
          <span class="terminal-cursor" aria-hidden="true"></span>
        </p>
      </div>

      <div class="hero-profile identity-card" data-hero-profile aria-label="Profile">
        <div class="identity-avatar" data-poke-avatar>
          <img src={kagariAssets.profile} alt={`${profileIdentity.displayName} 的头像`} width="168" height="168" />
          <span class="avatar-poke-bubble" data-poke-bubble>&#x64CD;&#x4F5C;&#x592A;&#x5FEB;&#x5566;&#xFF0C;&#x4F11;&#x606F;&#x4E00;&#x4E0B;&#x5427;</span>
        </div>
        <div class="identity-terminal" aria-label="identity terminal card">
          <div class="identity-terminal-bar">
            <div class="terminal-dots" aria-hidden="true">
              <span></span>
              <span></span>
              <span></span>
            </div>
            <span class="terminal-title">rain-dust-profile.exe</span>
          </div>
          <p class="identity-path">C:\Users\Rain_dust\profile</p>
          <p class="identity-command">
            <span class="terminal-prefix">profile@rain-dust:~$</span>
            <span data-name-typing></span>
            <span class="terminal-cursor" aria-hidden="true"></span>
          </p>
          <p class="identity-caption">{profileIdentity.displayName} / {profileIdentity.handle}</p>
          <section class="identity-status" aria-labelledby="identity-status-title">
            <div class="identity-status-heading">
              <span id="identity-status-title">STATUS</span>
              <span class="identity-status-signal" aria-hidden="true">ACTIVE</span>
            </div>
            <ul>
              <li><span aria-hidden="true">›</span> 推进自瞄算法迭代</li>
              <li><span aria-hidden="true">›</span> 优化 Earth Online</li>
              <li><span aria-hidden="true">›</span> 为 AstrBot 编写插件</li>
              <li><span aria-hidden="true">›</span> 利用 Obsidian 搭建自我预测模型</li>
            </ul>
          </section>
          <div class="social-links" aria-label="Social links">
            <a href={profileIdentity.github} target="_blank" rel="noreferrer" aria-label="GitHub profile">
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path d="M12 .5C5.65.5.5 5.65.5 12c0 5.1 3.29 9.4 7.86 10.93.58.1.79-.25.79-.56v-2.16c-3.2.7-3.87-1.38-3.87-1.38-.52-1.33-1.27-1.68-1.27-1.68-1.04-.71.08-.7.08-.7 1.15.08 1.76 1.18 1.76 1.18 1.02 1.75 2.68 1.24 3.34.95.1-.74.4-1.24.72-1.53-2.56-.29-5.25-1.28-5.25-5.7 0-1.26.45-2.29 1.18-3.1-.12-.29-.51-1.47.11-3.06 0 0 .97-.31 3.16 1.18A10.9 10.9 0 0 1 12 5.98c.98 0 1.96.13 2.88.39 2.19-1.49 3.15-1.18 3.15-1.18.63 1.59.24 2.77.12 3.06.74.81 1.18 1.84 1.18 3.1 0 4.43-2.7 5.41-5.27 5.7.41.36.77 1.06.77 2.14v3.18c0 .31.21.67.8.56A11.51 11.51 0 0 0 23.5 12C23.5 5.65 18.35.5 12 .5Z" />
              </svg>
              GitHub
            </a>
            <a href={profileIdentity.email} aria-label="Email">
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path d="M3.5 5.5h17v13h-17zM4 6l8 7 8-7" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" />
              </svg>
              Email
            </a>
          </div>
          <section class="hero-story identity-terminal-extension" data-hero-story aria-hidden="true">
            <div class="identity-terminal-extension__body">
              <p class="identity-terminal-extension__command">
                <span class="terminal-prefix">profile@rain-dust:~$</span>
                <span>identify --profile</span>
              </p>
              <div class="identity-terminal-extension__output">
                <div class="identity-terminal-extension__headline">
                  <span>IDENTITY</span>
                  <strong>19-YEAR-OLD</strong>
                  <b>CREATIVE VIBECODER</b>
                </div>
                <dl class="identity-terminal-extension__facts">
                  <div>
                    <dt>ROLE</dt>
                    <dd>CREATIVE ENGINEER</dd>
                  </div>
                  <div>
                    <dt>MODE</dt>
                    <dd>INDEPENDENT BUILDER</dd>
                  </div>
                  <div>
                    <dt>MISSION</dt>
                    <dd>GUIKE HACKATHON 2026</dd>
                  </div>
                </dl>
                <p class="identity-terminal-extension__focus">
                  <span>FOCUS</span>
                  <strong>AI PROTOTYPES</strong>
                  <i aria-hidden="true">/</i>
                  <strong>INTERACTIVE WEB</strong>
                  <i aria-hidden="true">/</i>
                  <strong>AUTOMATION</strong>
                </p>
              </div>
            </div>
          </section>
        </div>
          <a
            class="identity-rift"
            data-identity-rift
            href="/projects/"
            aria-label="Execute Works"
            aria-hidden="true"
            tabindex="-1"
          >
            <span class="identity-rift__fracture" aria-hidden="true">
              <canvas class="identity-rift__canvas" data-identity-rift-canvas></canvas>
              <span class="identity-rift__fallback"></span>
            </span>
            <span class="identity-rift__prompt">
              <small>&gt; EXECUTE</small>
              <strong>/WORKS</strong>
            </span>
          </a>
      </div>

    </div>
  </section>

  <script data-astro-rerun>
    (() => {
      window.__yuimiNoticeCleanup?.();
      const noticeCleanupTasks = [];
      window.__yuimiNoticeCleanup = () => {
        noticeCleanupTasks.splice(0).forEach((cleanup) => cleanup());
      };

      const trigger = document.querySelector("[data-notice-open]");
      const backdrop = document.querySelector("[data-notice-backdrop]");
      const modal = document.querySelector("[data-notice-modal]");
      const scrollArea = document.querySelector("[data-notice-scroll-area]");
      const closeButton = document.querySelector("[data-notice-close]");
      const skipInput = document.querySelector("[data-notice-skip]");
      const titleTarget = document.querySelector("[data-notice-title]");
      const dateTarget = document.querySelector("[data-notice-date]");
      const iconTarget = document.querySelector("[data-notice-icon]");
      const bodyTarget = document.querySelector("[data-notice-body]");
      const scrollBar = document.querySelector("[data-notice-scrollbar]");
      const scrollThumb = document.querySelector("[data-notice-scroll-thumb]");
      if (!trigger || !backdrop || !modal || !scrollArea || !closeButton || !skipInput || !titleTarget || !dateTarget || !iconTarget || !bodyTarget) return;

      const noticeData = JSON.parse(document.getElementById("notice-content-data")?.textContent || "{}");
      const formatKey = (date) => `${String(date.getMonth() + 1).padStart(2, "0")}-${String(date.getDate()).padStart(2, "0")}`;
      const formatStorageKey = (date) => `${date.getFullYear()}-${formatKey(date)}`;
      const pickFrom = (items, index) => items[index % items.length];
      const today = new Date();
      const todayKey = formatKey(today);
      const storageKey = `yuimi-notice-hidden-${formatStorageKey(today)}`;
      const sessionStorageKey = `yuimi-notice-opened-session-${formatStorageKey(today)}`;
      let lockedScrollY = 0;

      const dayOfYear = Math.floor((today.getTime() - new Date(today.getFullYear(), 0, 0).getTime()) / 86400000);
      const weekSeed = Math.floor(dayOfYear / 7) + today.getFullYear() * 53;
      const solarTermEntries = (noticeData.solarTerms2026 || []).map(([date, title, text]) => ({
        date,
        icon: "🌿",
        title,
        tone: "solar",
        lines: [text]
      }));
      const historyEntries = (noticeData.histories || []).map(([date, icon, text]) => ({
        date,
        icon,
        title: "今天的趣味历史",
        tone: "history",
        lines: [text]
      }));
      const createFallbackEntry = () => {
        const themes = noticeData.fallbackThemes || [["💌", "今日小公告", "今天没有撞上特别节日，那就把普通日子当成隐藏关卡。"]];
        const actions = noticeData.fallbackActions || ["领取一份随机精神补丁。"];
        const theme = themes[(dayOfYear - 1) % themes.length];
        return {
          icon: theme[0],
          title: `第 ${dayOfYear} 号历史趣味胶囊`,
          tone: "history",
          lines: [theme[2], `今天的随机行动：${actions[(dayOfYear - 1) % actions.length]}`],
          footnote: "没有撞上固定节日时，Rain_dust 会按日期投递不同的冷知识胶囊。"
        };
      };
      const createThursdayV50Entry = () => {
        const pool = noticeData.v50;
        if (!pool || today.getDay() !== 4) return null;
        const opener = pickFrom(pool.openers, weekSeed);
        const plot = pickFrom(pool.plots, weekSeed * 3 + dayOfYear);
        const ask = pickFrom(pool.asks, weekSeed * 5 + today.getMonth());
        const ending = pickFrom(pool.endings, weekSeed * 7 + today.getDate());
        return {
          icon: "🍗",
          title: "星期四 V50 电波",
          tone: "fun",
          lines: [`${opener}${plot}。${ask}`, ending],
          footnote: "V50 文案由素材池按周组合生成，版本数很多，但钱包仍有最终解释权。"
        };
      };

      const todayEntries = [
        ...(noticeData.festivals || []).filter((item) => item.date === todayKey),
        ...solarTermEntries.filter((item) => item.date === todayKey),
        ...historyEntries.filter((item) => item.date === todayKey)
      ];
      const thursdayV50 = createThursdayV50Entry();
      if (thursdayV50) todayEntries.push(thursdayV50);

      const entries = todayEntries.length > 0 ? todayEntries : [createFallbackEntry()];

      const primary = entries[0];
      iconTarget.textContent = primary.icon;
      titleTarget.textContent = primary.title;
      dateTarget.textContent = new Intl.DateTimeFormat("zh-CN", {
        year: "numeric",
        month: "2-digit",
        day: "2-digit",
        weekday: "long"
      }).format(today);
      modal.dataset.tone = primary.tone || "soft";

      bodyTarget.innerHTML = entries.map((entry, index) => `
        <article class="home-notice-entry ${index === 0 ? "is-primary" : ""}">
          <div class="home-notice-entry-title">
            <span aria-hidden="true">${entry.icon}</span>
            <strong>${entry.title}</strong>
          </div>
          ${entry.lines.map((line) => `<p>${line}</p>`).join("")}
          ${entry.list ? `<ol>${entry.list.map((item) => `<li>${item}</li>`).join("")}</ol>` : ""}
          ${entry.footnote ? `<small>${entry.footnote}</small>` : ""}
        </article>
      `).join("");

      const updateNoticeScrollbar = () => {
        if (!scrollBar || !scrollThumb) return;
        const scrollable = scrollArea.scrollHeight - scrollArea.clientHeight;
        if (scrollable <= 2) {
          scrollBar.classList.add("is-hidden");
          scrollThumb.style.setProperty("--notice-thumb-y", "0px");
          scrollThumb.style.setProperty("--notice-thumb-height", "100%");
          return;
        }

        scrollBar.classList.remove("is-hidden");
        const trackHeight = scrollBar.clientHeight;
        const thumbHeight = Math.max(42, Math.round((scrollArea.clientHeight / scrollArea.scrollHeight) * trackHeight));
        const maxThumbY = Math.max(0, trackHeight - thumbHeight);
        const thumbY = Math.round((scrollArea.scrollTop / scrollable) * maxThumbY);
        scrollThumb.style.setProperty("--notice-thumb-height", `${thumbHeight}px`);
        scrollThumb.style.setProperty("--notice-thumb-y", `${thumbY}px`);
      };

      const openNotice = () => {
        lockedScrollY = window.scrollY || document.documentElement.scrollTop || 0;
        document.documentElement.classList.add("is-notice-open");
        document.body.classList.add("is-notice-open");
        document.body.style.top = `-${lockedScrollY}px`;
        backdrop.hidden = false;
        backdrop.classList.add("is-open");
        closeButton.focus({ preventScroll: true });
        requestAnimationFrame(updateNoticeScrollbar);
      };

      const closeNotice = () => {
        if (skipInput.checked) {
          try {
            localStorage.setItem(storageKey, "1");
          } catch {
            // Ignore storage failures; the modal can still close normally.
          }
        }
        backdrop.classList.remove("is-open");
        document.documentElement.classList.remove("is-notice-open");
        document.body.classList.remove("is-notice-open");
        document.body.style.top = "";
        window.scrollTo({ top: lockedScrollY, left: 0, behavior: "instant" });
        window.setTimeout(() => {
          backdrop.hidden = true;
        }, 180);
      };

      const openNoticeAutomatically = () => {
        try {
          if (sessionStorage.getItem(sessionStorageKey) === "1") return;
          sessionStorage.setItem(sessionStorageKey, "1");
        } catch {
          // Session storage may be blocked, but the page should still work.
        }
        openNotice();
      };

      const stopNoticeWheel = (event) => {
        if (!backdrop.classList.contains("is-open")) return;
        event.stopPropagation();
        if (!scrollArea.contains(event.target)) {
          event.preventDefault();
        }
      };

      trigger.addEventListener("click", openNotice);
      closeButton.addEventListener("click", closeNotice);
      scrollArea.addEventListener("scroll", updateNoticeScrollbar, { passive: true });
      modal.addEventListener("wheel", stopNoticeWheel, { passive: false });
      backdrop.addEventListener("wheel", stopNoticeWheel, { passive: false });
      window.addEventListener("resize", updateNoticeScrollbar);
      const onBackdropClick = (event) => {
        if (event.target === backdrop) closeNotice();
      };
      const onNoticeKeydown = (event) => {
        if (event.key === "Escape" && !backdrop.hidden) closeNotice();
      };
      backdrop.addEventListener("click", onBackdropClick);
      document.addEventListener("keydown", onNoticeKeydown);
      noticeCleanupTasks.push(() => {
        trigger.removeEventListener("click", openNotice);
        closeButton.removeEventListener("click", closeNotice);
        scrollArea.removeEventListener("scroll", updateNoticeScrollbar);
        modal.removeEventListener("wheel", stopNoticeWheel);
        backdrop.removeEventListener("wheel", stopNoticeWheel);
        window.removeEventListener("resize", updateNoticeScrollbar);
        backdrop.removeEventListener("click", onBackdropClick);
        document.removeEventListener("keydown", onNoticeKeydown);
      });

      let hiddenToday = false;
      try {
        hiddenToday = localStorage.getItem(storageKey) === "1";
      } catch {
        hiddenToday = false;
      }

      if (!hiddenToday) {
        const autoOpenTimer = window.setTimeout(openNoticeAutomatically, 520);
        noticeCleanupTasks.push(() => window.clearTimeout(autoOpenTimer));
      }
    })();
  </script>

  <script data-astro-rerun>
    (() => {
      window.__yuimiHomeRainCleanup?.();
      const cleanupTasks = [];
      window.__yuimiHomeRainCleanup = () => {
        cleanupTasks.splice(0).forEach((cleanup) => cleanup());
      };

      const stage = document.querySelector("[data-tag-rain]");
      const canvas = document.querySelector("[data-tag-rain-canvas]");
      if (!stage || !canvas) return;

      const ctx = canvas.getContext("2d");
      if (!ctx) return;

      const labels = (() => {
        try {
          const parsed = JSON.parse(stage.dataset.tags || "[]");
          return [...new Set(Array.isArray(parsed) ? parsed : [])];
        } catch {
          return [];
        }
      })();

      const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
      const performanceProfile = document.documentElement.dataset.yuimiPerformance ?? "full";
      const mobilePerformance = performanceProfile !== "full";
      const litePerformance = performanceProfile === "lite";
      const dateTarget = document.querySelector("[data-home-date]");
      const timeTarget = document.querySelector("[data-home-time]");
      const weatherTarget = document.querySelector("[data-home-weather]");
      const locationCacheKey = "yuimi-home-local-signal-v3";
      const tencentMapKey = stage.dataset.tencentMapKey || "";
      const weatherCodeText = {
        0: "晴",
        1: "大致晴朗",
        2: "少云",
        3: "阴",
        45: "雾",
        48: "霜雾",
        51: "毛毛雨",
        53: "毛毛雨",
        55: "毛毛雨",
        61: "小雨",
        63: "中雨",
        65: "大雨",
        71: "小雪",
        73: "中雪",
        75: "大雪",
        80: "阵雨",
        81: "阵雨",
        82: "强阵雨",
        95: "雷雨",
        96: "雷雨夹冰雹",
        99: "雷雨夹冰雹"
      };

      const readJsonCache = (key) => {
        try {
          return JSON.parse(localStorage.getItem(key) ?? "{}");
        } catch {
          return {};
        }
      };

      const writeJsonCache = (key, value) => {
        try {
          localStorage.setItem(key, JSON.stringify(value));
        } catch {
          // ignore storage failures in private browsing
        }
      };

      const jsonp = (url, params = {}, timeout = 7000) => {
        const callbackName = `yuimiMapCallback_${Date.now()}_${Math.random().toString(16).slice(2)}`;
        const query = new URLSearchParams({ ...params, callback: callbackName });
        const separator = url.includes("?") ? "&" : "?";
        const script = document.createElement("script");

        return new Promise((resolve, reject) => {
          const timer = window.setTimeout(() => {
            cleanup();
            reject(new Error("JSONP timeout"));
          }, timeout);

          const cleanup = () => {
            window.clearTimeout(timer);
            delete window[callbackName];
            script.remove();
          };

          window[callbackName] = (data) => {
            cleanup();
            resolve(data);
          };
          script.onerror = () => {
            cleanup();
            reject(new Error("JSONP failed"));
          };
          script.src = `${url}${separator}${query.toString()}`;
          document.head.appendChild(script);
        });
      };

      const jsonpText = (url, params = {}, timeout = 7000) => {
        const callbackName = `yuimiIpCallback_${Date.now()}_${Math.random().toString(16).slice(2)}`;
        const query = new URLSearchParams({ ...params, callback: callbackName });
        const separator = url.includes("?") ? "&" : "?";
        const script = document.createElement("script");

        return new Promise((resolve, reject) => {
          const timer = window.setTimeout(() => {
            cleanup();
            reject(new Error("JSONP timeout"));
          }, timeout);

          const cleanup = () => {
            window.clearTimeout(timer);
            delete window[callbackName];
            script.remove();
          };

          window[callbackName] = (data) => {
            cleanup();
            resolve(data);
          };
          script.onerror = () => {
            cleanup();
            reject(new Error("JSONP failed"));
          };
          script.src = `${url}${separator}${query.toString()}`;
          document.head.appendChild(script);
        });
      };

      const formatSignalLocation = (adInfo) => {
        const parts = [adInfo?.province, adInfo?.city, adInfo?.district]
          .filter(Boolean)
          .filter((item, index, list) => list.indexOf(item) === index);
        if (!parts.length) return adInfo?.nation || "本地时区";
        return parts.join(" ");
      };

      const getTencentIpLocation = async () => {
        if (!tencentMapKey) throw new Error("Tencent map key unavailable");
        const locationData = await jsonp("https://apis.map.qq.com/ws/location/v1/ip", {
          key: tencentMapKey,
          output: "jsonp"
        });
        const result = locationData?.result;
        const location = result?.location;
        if (Number(locationData?.status) !== 0 || !location) throw new Error(locationData?.message || "Tencent location failed");
        return {
          place: formatSignalLocation(result.ad_info),
          latitude: Number(location.lat),
          longitude: Number(location.lng)
        };
      };

      const getFallbackIpLocation = async () => {
        const response = await fetch("https://ipwho.is/?lang=zh-CN");
        if (!response.ok) throw new Error("Fallback location failed");
        const data = await response.json();
        if (!data?.success) throw new Error(data?.message || "Fallback location failed");
        const place = [data.region, data.city].filter(Boolean).join(" ") || data.country || "本地时区";
        return {
          place,
          latitude: Number(data.latitude),
          longitude: Number(data.longitude)
        };
      };

      const getPconlineIpLocation = async () => {
        const response = await fetch("https://whois.pconline.com.cn/ipJson.jsp?json=true");
        if (!response.ok) throw new Error("Pconline location failed");
        const text = await response.text();
        const data = JSON.parse(text.replace(/^\s*callback\(|\)\s*$/g, "").trim());
        const place = [data.pro, data.city, data.region].filter(Boolean).join(" ") || data.addr || "本地时区";
        return {
          place,
          latitude: 31.2304,
          longitude: 121.4737,
          approximate: true
        };
      };

      const getTencentNewsIpLocation = async () => {
        const data = await jsonpText("https://r.inews.qq.com/api/ip2city", {
          otype: "jsonp"
        });
        if (Number(data?.ret) !== 0) throw new Error(data?.errMsg || "Tencent news location failed");
        const place = [data.province, data.city, data.district].filter(Boolean).join(" ") || data.country || "本地时区";
        return {
          place,
          latitude: 31.2304,
          longitude: 121.4737,
          approximate: true
        };
      };

      const getIpLocation = async () => {
        try {
          return await getTencentIpLocation();
        } catch {
          try {
            return await getFallbackIpLocation();
          } catch {
            try {
              return await getTencentNewsIpLocation();
            } catch {
              return getPconlineIpLocation();
            }
          }
        }
      };

      const getTimezoneLocation = () => {
        const timezone = Intl.DateTimeFormat().resolvedOptions().timeZone || "Asia/Shanghai";
        const presets = {
          "Asia/Shanghai": { place: "本地时区", latitude: 31.2304, longitude: 121.4737 },
          "Asia/Tokyo": { place: "东京电波", latitude: 35.6762, longitude: 139.6503 },
          "Asia/Hong_Kong": { place: "香港电波", latitude: 22.3193, longitude: 114.1694 },
          "Asia/Taipei": { place: "台北电波", latitude: 25.033, longitude: 121.5654 }
        };
        return presets[timezone] ?? { place: timezone, latitude: 31.2304, longitude: 121.4737 };
      };

      const updateHomeWeather = async () => {
        if (!weatherTarget) return;
        const cached = readJsonCache(locationCacheKey);
        if (cached.label && Date.now() - Number(cached.updatedAt ?? 0) < 1000 * 60 * 60 * 3) {
          weatherTarget.textContent = cached.label;
          return;
        }
        ["yuimi-home-local-signal-v1", "yuimi-home-local-signal-v2"].forEach((oldKey) => {
          if (localStorage.getItem(oldKey)) localStorage.removeItem(oldKey);
        });
        if (cached.place === "本地时区" || cached.label?.includes("本地时区")) {
          localStorage.removeItem(locationCacheKey);
        }

        weatherTarget.textContent = "定位电波接收中...";
        let location;
        try {
          location = await getIpLocation();
        } catch {
          location = getTimezoneLocation();
        }

        try {
          if (!Number.isFinite(location.latitude) || !Number.isFinite(location.longitude)) {
            throw new Error("No location");
          }

          const weatherUrl = new URL("https://api.open-meteo.com/v1/forecast");
          weatherUrl.searchParams.set("latitude", String(location.latitude));
          weatherUrl.searchParams.set("longitude", String(location.longitude));
          weatherUrl.searchParams.set("current", "temperature_2m,weather_code");
          weatherUrl.searchParams.set("timezone", "auto");
          weatherUrl.searchParams.set("forecast_days", "1");
          const weatherResponse = await fetch(weatherUrl);
          if (!weatherResponse.ok) throw new Error("Weather failed");
          const weatherData = await weatherResponse.json();
          const current = weatherData.current ?? {};
          const temperature = Number(current.temperature_2m);
          const weatherText = weatherCodeText[current.weather_code] ?? "天气";
          const label = Number.isFinite(temperature)
            ? `${location.place} · ${Math.round(temperature)}°C ${weatherText}`
            : `${location.place} · 天气信号微弱`;
          weatherTarget.textContent = label;
          writeJsonCache(locationCacheKey, {
            label,
            place: location.place,
            latitude: location.latitude,
            longitude: location.longitude,
            updatedAt: Date.now()
          });
        } catch {
          const label = `${location.place} · 天气信号迷路中`;
          weatherTarget.textContent = label;
          writeJsonCache(locationCacheKey, {
            label,
            place: location.place,
            latitude: location.latitude,
            longitude: location.longitude,
            updatedAt: Date.now()
          });
        }
      };

      const homeDateFormatter = new Intl.DateTimeFormat("zh-CN", {
        year: "numeric",
        month: "2-digit",
        day: "2-digit",
        weekday: "long"
      });
      const homeTimeFormatter = new Intl.DateTimeFormat("zh-CN", {
        hour: "2-digit",
        minute: "2-digit",
        second: "2-digit",
        hour12: false
      });

      const updateHomeClock = () => {
        const now = new Date();
        if (dateTarget) dateTarget.textContent = homeDateFormatter.format(now);
        if (timeTarget) timeTarget.textContent = homeTimeFormatter.format(now);
      };
      updateHomeClock();
      const clockTimer = window.setInterval(updateHomeClock, 1000);
      cleanupTasks.push(() => window.clearInterval(clockTimer));
      updateHomeWeather();

      const palette = [
        { fill: "#fff5bf", stroke: "#f0c95a", ink: "#725d22" },
        { fill: "#ffddea", stroke: "#f2a8bd", ink: "#824759" },
        { fill: "#dff2ff", stroke: "#9fc8eb", ink: "#315a78" },
        { fill: "#dff5ea", stroke: "#9bd6b7", ink: "#315e49" },
        { fill: "#eee4ff", stroke: "#c9b8ef", ink: "#57467b" }
      ];

      const state = {
        bodies: [],
        queue: [],
        started: false,
        finishedDropping: false,
        fading: false,
        done: false,
        raf: 0,
        lastTime: 0,
        nextDrop: 0,
        lastDropAt: 0,
        width: 1,
        height: 1,
        stageHeight: 1,
        dpr: 1,
        fadeStart: 0,
        lastPaint: 0,
        visible: true
      };

      const random = (min, max) => min + Math.random() * (max - min);
      const clamp = (value, min, max) => Math.min(max, Math.max(min, value));

      const measureTag = (label) => {
        ctx.save();
        ctx.font = "850 18px 'Cascadia Code', 'Fira Code', Consolas, sans-serif";
        const width = clamp(ctx.measureText(label).width + 46, 96, Math.min(260, state.width * 0.76));
        ctx.restore();
        return { width, height: 44 };
      };

      const makeTag = (label, index) => {
        const size = measureTag(label);
        const color = palette[index % palette.length];
        const radius = Math.max(size.width, size.height) * 0.34;
        return {
          type: "tag",
          label,
          color,
          width: size.width,
          height: size.height,
          radius,
          x: random(radius + 12, state.width - radius - 12),
          y: -random(60, 260),
          vx: random(-1.2, 1.2),
          vy: random(0.5, 1.8),
          angle: random(-0.3, 0.3),
          spin: random(-0.018, 0.018),
          alpha: 1
        };
      };

      const resize = () => {
        const rect = stage.getBoundingClientRect();
        const dprCeiling = litePerformance ? 1 : mobilePerformance ? 1.15 : 2;
        state.dpr = clamp(window.devicePixelRatio || 1, 1, dprCeiling);
        state.width = Math.max(1, Math.floor(rect.width));
        state.stageHeight = Math.max(1, Math.floor(rect.height));
        state.height = state.stageHeight + 80;
        canvas.width = Math.floor(state.width * state.dpr);
        canvas.height = Math.floor(state.height * state.dpr);
        canvas.style.width = state.width + "px";
        canvas.style.height = state.height + "px";
        ctx.setTransform(state.dpr, 0, 0, state.dpr, 0, 0);
      };

      const prepareQueue = () => {
        state.queue = labels.map(makeTag).sort(() => Math.random() - 0.5);
      };

      const startRain = () => {
        if (state.started || state.done || labels.length === 0) return;
        resize();
        prepareQueue();
        state.started = true;
        state.lastTime = performance.now();
        state.nextDrop = 0;
        stage.classList.add("is-raining");
        window.cancelAnimationFrame(state.raf);
        state.raf = window.requestAnimationFrame(tick);
      };

      const resetRain = () => {
        if (!state.started && !state.done && state.bodies.length === 0) return;
        window.cancelAnimationFrame(state.raf);
        state.bodies = [];
        state.queue = [];
        state.started = false;
        state.finishedDropping = false;
        state.fading = false;
        state.done = false;
        state.raf = 0;
        state.lastTime = performance.now();
        state.nextDrop = 0;
        state.lastDropAt = 0;
        state.fadeStart = 0;
        stage.classList.remove("is-raining", "is-fading");
        ctx.clearRect(0, 0, state.width, state.height);
      };

      const drawCapsule = (body) => {
        const r = body.height / 2;
        ctx.save();
        ctx.globalAlpha = body.alpha;
        ctx.translate(body.x, body.y);
        ctx.rotate(body.angle);
        ctx.beginPath();
        ctx.roundRect(-body.width / 2, -body.height / 2, body.width, body.height, r);
        ctx.fillStyle = body.color.fill;
        ctx.strokeStyle = body.color.stroke;
        ctx.lineWidth = 2;
        ctx.shadowColor = "rgba(98, 111, 133, 0.16)";
        ctx.shadowBlur = 14;
        ctx.shadowOffsetY = 8;
        ctx.fill();
        ctx.shadowColor = "transparent";
        ctx.stroke();
        ctx.fillStyle = body.color.ink;
        ctx.font = "850 18px 'Cascadia Code', 'Fira Code', Consolas, sans-serif";
        ctx.textAlign = "center";
        ctx.textBaseline = "middle";
        ctx.fillText(body.label, 0, 1, body.width - 34);
        ctx.restore();
      };

      const collideBodies = () => {
        for (let i = 0; i < state.bodies.length; i += 1) {
          for (let j = i + 1; j < state.bodies.length; j += 1) {
            const a = state.bodies[i];
            const b = state.bodies[j];
            const dx = b.x - a.x;
            const dy = b.y - a.y;
            const distance = Math.hypot(dx, dy) || 0.001;
            const minDistance = a.radius + b.radius;
            if (distance >= minDistance) continue;

            const nx = dx / distance;
            const ny = dy / distance;
            const overlap = (minDistance - distance) * 0.52;
            a.x -= nx * overlap;
            a.y -= ny * overlap;
            b.x += nx * overlap;
            b.y += ny * overlap;

            const relVx = b.vx - a.vx;
            const relVy = b.vy - a.vy;
            const impulse = (relVx * nx + relVy * ny) * 0.62;
            if (impulse < 0) {
              a.vx += impulse * nx;
              a.vy += impulse * ny;
              b.vx -= impulse * nx;
              b.vy -= impulse * ny;
              a.spin *= 0.58;
              b.spin *= 0.58;
            }
          }
        }
      };

      const stepBody = (body, dt) => {
        const floor = state.stageHeight - 24;
        body.vy += 0.055 * dt;
        body.x += body.vx * dt;
        body.y += body.vy * dt;
        body.angle += body.spin * dt;

        if (body.x - body.radius < 10) {
          body.x = body.radius + 10;
          body.vx = Math.abs(body.vx) * 0.52;
          body.spin *= 0.35;
        }
        if (body.x + body.radius > state.width - 10) {
          body.x = state.width - body.radius - 10;
          body.vx = -Math.abs(body.vx) * 0.52;
          body.spin *= 0.35;
        }
        if (body.y + body.radius > floor) {
          body.y = floor - body.radius;
          body.vy *= -0.16;
          body.vx *= 0.62;
          body.spin *= 0.18;
          if (Math.abs(body.vy) < 0.72) body.vy = 0;
          if (Math.abs(body.vx) < 0.16) body.vx = 0;
          if (Math.abs(body.spin) < 0.018) body.spin = 0;
        }

        if (Math.abs(body.vx) + Math.abs(body.vy) < 0.42) {
          body.spin *= 0.72;
          if (Math.abs(body.spin) < 0.02) body.spin = 0;
        }
      };

      const maybeFade = (now) => {
        if (!state.finishedDropping || state.fading) return;
        const calm = state.bodies.every((body) => Math.abs(body.vx) + Math.abs(body.vy) < 1.15);
        if (calm || now - state.lastDropAt > 4800) {
          state.fading = true;
          state.fadeStart = now;
          stage.classList.add("is-fading");
        }
      };

      const tick = (now) => {
        if (!state.visible) {
          state.raf = 0;
          return;
        }

        const minimumFrameInterval = litePerformance
          ? 1000 / 24
          : mobilePerformance
            ? 1000 / 30
            : 0;
        if (minimumFrameInterval && state.lastPaint && now - state.lastPaint < minimumFrameInterval) {
          state.raf = window.requestAnimationFrame(tick);
          return;
        }
        state.lastPaint = now;

        const dt = clamp((now - state.lastTime) / 16.67, 0.4, 2.1);
        state.lastTime = now;
        ctx.clearRect(0, 0, state.width, state.height);

        if (!state.finishedDropping && now >= state.nextDrop) {
          const next = state.queue.shift();
          if (next) {
            state.bodies.push(next);
            state.lastDropAt = now;
            state.nextDrop = now + random(120, 220);
          } else {
            state.finishedDropping = true;
            state.lastDropAt = now;
          }
        }

        state.bodies.forEach((body) => stepBody(body, dt));
        for (let i = 0; i < (mobilePerformance ? 2 : 3); i += 1) collideBodies();

        if (state.fading) {
          const fade = clamp((now - state.fadeStart) / 5200, 0, 1);
          state.bodies.forEach((body) => {
            body.alpha = 1 - fade;
            body.y += fade * 0.05 * dt;
          });
          if (fade >= 1) {
            state.done = true;
            stage.classList.remove("is-raining", "is-fading");
            ctx.clearRect(0, 0, state.width, state.height);
            window.cancelAnimationFrame(state.raf);
            return;
          }
        }

        state.bodies.forEach(drawCapsule);

        maybeFade(now);
        state.raf = window.requestAnimationFrame(tick);
      };

      const shouldStart = () => {
        const rect = stage.getBoundingClientRect();
        const viewport = window.innerHeight || document.documentElement.clientHeight;
        return rect.top <= viewport * 0.46 && rect.bottom >= viewport * 0.34;
      };

      const isAtPageTop = () => {
        const top = window.scrollY || document.documentElement.scrollTop || document.body.scrollTop || 0;
        return top <= 4;
      };

      const onScroll = () => {
        if (isAtPageTop()) {
          resetRain();
          return;
        }
        if (shouldStart()) startRain();
      };

      resize();
      if (reduceMotion.matches) {
        stage.classList.add("is-reduced-motion");
      } else {
        const observer = "IntersectionObserver" in window
          ? new IntersectionObserver((entries) => {
            if (entries.some((entry) => entry.isIntersecting)) {
              startRain();
              observer.disconnect();
            }
          }, { rootMargin: "-34% 0px -42% 0px", threshold: 0.02 })
          : null;
        observer?.observe(stage);
        window.addEventListener("scroll", onScroll, { passive: true });
        cleanupTasks.push(() => {
          observer?.disconnect();
          window.removeEventListener("scroll", onScroll);
        });
        onScroll();
      }
      const onResize = () => {
        resize();
        state.bodies.forEach((body) => {
          body.x = clamp(body.x, body.radius + 10, state.width - body.radius - 10);
          body.y = Math.min(body.y, state.stageHeight - 24 - body.radius);
        });
      };
      const onVisibilityChange = () => {
        state.visible = document.visibilityState === "visible";
        state.lastTime = performance.now();
        if (!state.visible) {
          window.cancelAnimationFrame(state.raf);
          state.raf = 0;
        } else if (state.started && !state.done && !state.raf) {
          state.raf = window.requestAnimationFrame(tick);
        }
      };
      const onPageHide = () => {
        window.cancelAnimationFrame(state.raf);
        state.raf = 0;
      };
      window.addEventListener("resize", onResize);
      document.addEventListener("visibilitychange", onVisibilityChange);
      window.addEventListener("pagehide", onPageHide);
      cleanupTasks.push(() => {
        window.cancelAnimationFrame(state.raf);
        window.removeEventListener("resize", onResize);
        document.removeEventListener("visibilitychange", onVisibilityChange);
        window.removeEventListener("pagehide", onPageHide);
      });
    })();
  </script>

  <script data-astro-rerun>
    (() => {
    window.__yuimiHeroCleanup?.();
    const heroCleanupTasks = [];
    window.__yuimiHeroCleanup = () => {
      heroCleanupTasks.splice(0).forEach((cleanup) => cleanup());
    };

    const stage = document.querySelector("[data-hero-stage]");
    const hero = stage?.querySelector(".hero");
    const typingTarget = document.querySelector("[data-terminal-typing]");
    const nameTarget = document.querySelector("[data-name-typing]");
    const story = document.querySelector("[data-hero-story]");
    const rift = document.querySelector("[data-identity-rift]");
    const profile = document.querySelector("[data-hero-profile]");
    const avatar = profile?.querySelector(".identity-avatar");
    const terminal = profile?.querySelector(".identity-terminal");
    const riftCanvas = rift?.querySelector("[data-identity-rift-canvas]");

    const createRiftRenderer = (canvas, riftRoot, stageRoot) => {
      if (!(canvas instanceof HTMLCanvasElement) || !(riftRoot instanceof HTMLElement) || !(stageRoot instanceof HTMLElement)) {
        return null;
      }

      const context = canvas.getContext("2d", { alpha: true });
      const fallback = riftRoot.querySelector(".identity-rift__fallback");
      if (!context) {
        fallback?.classList.add("is-visible");
        return null;
      }

      const source = new Image();
      source.decoding = "async";
      source.src = "/themes/fuyukawa-kagari/assets/hero-wallpaper-20260729.png";

      let frame = 0;
      let active = false;
      let ready = false;
      let hovered = false;
      let destroyed = false;
      let formationStartedAt = 0;
      let executeStartedAt = 0;
      let glitchUntil = 0;
      let nextGlitchAt = Number.POSITIVE_INFINITY;
      let width = 0;
      let height = 0;
      let dpr = 1;

      const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
      const motionAllowed = () => !reducedMotion.matches || stageRoot.dataset.devMotionPreview === "force";
      const smoothstep = (value) => value * value * (3 - 2 * value);
      const clampUnit = (value) => Math.min(1, Math.max(0, value));
      const seeded = (seed) => {
        const value = Math.sin(seed * 12.9898 + 78.233) * 43758.5453;
        return value - Math.floor(value);
      };

      const resize = () => {
        const rect = canvas.getBoundingClientRect();
        if (!rect.width || !rect.height) return;
        dpr = Math.min(window.devicePixelRatio || 1, 2);
        width = rect.width;
        height = rect.height;
        const pixelWidth = Math.max(1, Math.round(width * dpr));
        const pixelHeight = Math.max(1, Math.round(height * dpr));
        if (canvas.width !== pixelWidth || canvas.height !== pixelHeight) {
          canvas.width = pixelWidth;
          canvas.height = pixelHeight;
        }
      };

      const crackCenter = (y) => {
        const normalized = y / Math.max(height, 1);
        return width * 0.5
          + Math.sin(normalized * 7.2 + 0.5) * 3.2
          + Math.sin(normalized * 17.4 + 1.8) * 1.6
          + Math.sin(normalized * 3.4 - 0.7) * 2.4;
      };

      const crackHalfWidth = (y, opening) => {
        const normalized = y / Math.max(height, 1);
        const taper = Math.pow(Math.max(0, Math.sin(Math.PI * normalized)), 0.58);
        const texture = 0.82 + 0.18 * Math.sin(normalized * 21 + 0.4);
        return Math.max(0.35, opening * taper * texture);
      };

      const traceCrack = (opening) => {
        context.beginPath();
        for (let y = 0; y <= height; y += 3) {
          const x = crackCenter(y) - crackHalfWidth(y, opening);
          if (y === 0) context.moveTo(x, y);
          else context.lineTo(x, y);
        }
        for (let y = height; y >= 0; y -= 3) {
          context.lineTo(crackCenter(y) + crackHalfWidth(y, opening), y);
        }
        context.closePath();
      };

      const drawWorksSliver = (opening) => {
        context.save();
        traceCrack(opening);
        context.clip();

        const wall = context.createLinearGradient(width * 0.2, 0, width * 0.8, height);
        wall.addColorStop(0, "#0d0f0e");
        wall.addColorStop(0.52, "#171713");
        wall.addColorStop(1, "#25221e");
        context.fillStyle = wall;
        context.fillRect(0, 0, width, height);

        const warmLight = context.createRadialGradient(width * 0.72, height * 0.25, 0, width * 0.72, height * 0.25, height * 0.56);
        warmLight.addColorStop(0, "rgba(151, 126, 102, 0.52)");
        warmLight.addColorStop(0.42, "rgba(102, 87, 72, 0.18)");
        warmLight.addColorStop(1, "rgba(15, 16, 14, 0)");
        context.fillStyle = warmLight;
        context.fillRect(0, 0, width, height);

        context.fillStyle = "rgba(5, 6, 6, 0.62)";
        context.beginPath();
        context.moveTo(width * 0.58, 0);
        context.lineTo(width, 0);
        context.lineTo(width * 0.46, height);
        context.lineTo(width * 0.12, height);
        context.closePath();
        context.fill();

        context.strokeStyle = "rgba(205, 190, 174, 0.12)";
        context.lineWidth = 1;
        for (let y = 20; y < height; y += 38) {
          context.beginPath();
          context.moveTo(0, y + 0.5);
          context.lineTo(width, y + 0.5);
          context.stroke();
        }
        context.restore();
      };

      const drawEdge = (opening, offset, color, alpha, lineWidth = 1) => {
        context.save();
        context.globalAlpha = alpha;
        context.strokeStyle = color;
        context.lineWidth = lineWidth;
        context.beginPath();
        for (let y = 1; y < height; y += 3) {
          const x = crackCenter(y) + crackHalfWidth(y, opening) * offset;
          if (y === 1) context.moveTo(x, y);
          else context.lineTo(x, y);
        }
        context.stroke();
        context.restore();
      };

      const drawSourceBand = (y, bandHeight, offset, tint, alpha) => {
        if (!source.complete || !source.naturalWidth) return;
        const stageRect = stageRoot.getBoundingClientRect();
        const canvasRect = canvas.getBoundingClientRect();
        const coverScale = Math.max(stageRect.width / source.naturalWidth, stageRect.height / source.naturalHeight);
        const renderedWidth = source.naturalWidth * coverScale;
        const renderedHeight = source.naturalHeight * coverScale;
        const imageLeft = stageRect.left + (stageRect.width - renderedWidth) / 2;
        const imageTop = stageRect.top + (stageRect.height - renderedHeight) / 2;
        const sampleWidth = Math.min(112, width * 0.76);
        const destinationX = (width - sampleWidth) / 2 + offset;
        const sourceX = (canvasRect.left + (width - sampleWidth) / 2 - imageLeft) / coverScale;
        const sourceY = (canvasRect.top + y - imageTop) / coverScale;
        const sourceWidth = sampleWidth / coverScale;
        const sourceHeight = bandHeight / coverScale;

        context.save();
        context.globalAlpha = alpha;
        context.drawImage(source, sourceX, sourceY, sourceWidth, sourceHeight, destinationX, y, sampleWidth, bandHeight);
        context.globalCompositeOperation = "screen";
        context.fillStyle = tint;
        context.fillRect(destinationX, y, sampleWidth, bandHeight);
        context.restore();
      };

      const drawGlitch = (now, intensity) => {
        const tick = Math.floor(now / 32);
        const colors = [
          "rgba(255, 10, 62, 0.64)",
          "rgba(0, 221, 255, 0.62)",
          "rgba(255, 28, 211, 0.56)",
          "rgba(70, 255, 139, 0.48)",
          "rgba(246, 235, 54, 0.46)"
        ];
        for (let index = 0; index < 7; index += 1) {
          const y = seeded(tick * 17 + index * 31) * height;
          const bandHeight = 1 + seeded(tick * 23 + index * 11) * 7;
          const direction = seeded(tick * 29 + index * 7) > 0.5 ? 1 : -1;
          const displacement = direction * (16 + seeded(tick * 41 + index) * 68) * intensity;
          drawSourceBand(y, bandHeight, displacement, colors[index % colors.length], 0.48 + intensity * 0.36);
        }
      };

      const render = (now) => {
        frame = 0;
        if (!active || destroyed) return;
        resize();
        context.setTransform(dpr, 0, 0, dpr, 0, 0);
        context.clearRect(0, 0, width, height);

        const formationElapsed = formationStartedAt ? now - formationStartedAt : 900;
        const formation = smoothstep(clampUnit(formationElapsed / 820));
        const executing = executeStartedAt ? smoothstep(clampUnit((now - executeStartedAt) / 320)) : 0;
        const baseOpening = (7.5 + hovered * 5.5) * formation;
        const opening = baseOpening + executing * Math.max(width * 0.48, 42);
        const glitching = now < glitchUntil;

        drawWorksSliver(opening);
        drawEdge(opening, -1, "#d6d8d3", 0.42, 0.9);
        drawEdge(opening, 1, "#aeb3b2", 0.54, 1.05);
        drawEdge(opening + 2.2, -1, "#242a2d", 0.28, 0.7);
        drawEdge(opening + 2.2, 1, "#242a2d", 0.34, 0.7);

        if (glitching) {
          const remaining = clampUnit((glitchUntil - now) / 150);
          drawGlitch(now, Math.max(0.42, remaining));
          drawEdge(opening + 3, -1, "#ff164f", 0.58, 1.4);
          drawEdge(opening + 4, 1, "#00e1ff", 0.62, 1.4);
        }

        if (motionAllowed() && ready && now >= nextGlitchAt && !hovered && !executeStartedAt) {
          glitchUntil = now + 80 + Math.random() * 80;
          nextGlitchAt = now + 2400 + Math.random() * 3400;
        }

        if (motionAllowed() && (formation < 1 || glitching || ready || executeStartedAt)) {
          frame = window.requestAnimationFrame(render);
        }
      };

      const schedule = () => {
        if (!frame && active && !destroyed) frame = window.requestAnimationFrame(render);
      };

      const startFormation = () => {
        active = true;
        ready = !motionAllowed();
        executeStartedAt = 0;
        formationStartedAt = performance.now() - (motionAllowed() ? 0 : 820);
        glitchUntil = formationStartedAt + 520;
        nextGlitchAt = formationStartedAt + 2800 + Math.random() * 2200;
        fallback?.classList.remove("is-visible");
        canvas.classList.add("is-ready");
        schedule();
      };

      const settle = () => {
        active = true;
        ready = true;
        nextGlitchAt = performance.now() + 2200 + Math.random() * 3200;
        schedule();
      };

      const reset = () => {
        active = false;
        ready = false;
        hovered = false;
        formationStartedAt = 0;
        executeStartedAt = 0;
        glitchUntil = 0;
        nextGlitchAt = Number.POSITIVE_INFINITY;
        window.cancelAnimationFrame(frame);
        frame = 0;
        context.setTransform(1, 0, 0, 1, 0, 0);
        context.clearRect(0, 0, canvas.width, canvas.height);
      };

      const execute = () => {
        executeStartedAt = performance.now();
        glitchUntil = executeStartedAt + 260;
        schedule();
      };

      const handleEnter = () => {
        hovered = true;
        glitchUntil = performance.now() + 110;
        schedule();
      };
      const handleLeave = () => {
        hovered = false;
        schedule();
      };
      const handleFocus = () => handleEnter();
      const handleBlur = () => handleLeave();

      riftRoot.addEventListener("pointerenter", handleEnter);
      riftRoot.addEventListener("pointerleave", handleLeave);
      riftRoot.addEventListener("focus", handleFocus);
      riftRoot.addEventListener("blur", handleBlur);
      source.addEventListener("load", schedule, { once: true });
      source.addEventListener("error", () => fallback?.classList.add("is-visible"), { once: true });

      return {
        startFormation,
        settle,
        reset,
        resize: schedule,
        execute,
        destroy() {
          destroyed = true;
          reset();
          riftRoot.removeEventListener("pointerenter", handleEnter);
          riftRoot.removeEventListener("pointerleave", handleLeave);
          riftRoot.removeEventListener("focus", handleFocus);
          riftRoot.removeEventListener("blur", handleBlur);
        }
      };
    };

    const riftRenderer = createRiftRenderer(riftCanvas, rift, stage);

    const clamp = (value, min = 0, max = 1) => Math.min(max, Math.max(min, value));
    const pullDistance = 260;
    const dockThreshold = 0.56;
    const resetDelay = 260;
    const releaseDelay = 120;
    const terminalLines = [
      "echo \"把模糊想法快速构建成可运行原型\"",
      "vibe --build",
      "collect \"blue moments\" && write",
      "npm run scrapbook"
    ];
    const nameLines = ["寻辰沐雨", "Rain_dust"];

    let pull = 0;
    let storyPull = 0;
    let state = "idle";
    let resetTimer = 0;
    let releaseTimer = 0;
    let riftTimer = 0;
    let riftNavigationTimer = 0;
    let riftNavigationArmed = false;
    const typingTimers = new Set();

    const setTypingTimer = (callback, delay) => {
      const timer = window.setTimeout(() => {
        typingTimers.delete(timer);
        callback();
      }, delay);
      typingTimers.add(timer);
    };

    const runTypingLoop = (target, lines, writeDelay = 58, eraseDelay = 32, holdDelay = 1250) => {
      if (!target) return;

      let lineIndex = 0;
      let charIndex = 0;
      let deleting = false;

      const tick = () => {
        const line = lines[lineIndex];
        target.textContent = line.slice(0, charIndex);

        if (!deleting && charIndex < line.length) {
          charIndex += 1;
          setTypingTimer(tick, writeDelay);
          return;
        }

        if (!deleting && charIndex === line.length) {
          deleting = true;
          setTypingTimer(tick, holdDelay);
          return;
        }

        if (deleting && charIndex > 0) {
          charIndex -= 1;
          setTypingTimer(tick, eraseDelay);
          return;
        }

        deleting = false;
        lineIndex = (lineIndex + 1) % lines.length;
        setTypingTimer(tick, 360);
      };

      tick();
    };

    if ("scrollRestoration" in history) {
      history.scrollRestoration = "manual";
    }

    if (!location.hash) {
      requestAnimationFrame(() => window.scrollTo({ top: 0, left: 0 }));
    }

    const setProgress = (progress) => {
      if (!hero) return;

      const value = clamp(progress);
      hero.style.setProperty("--avatar-y", `${(1 - value) * 56}vh`);
      hero.style.setProperty("--avatar-scale", `${0.78 + value * 0.22}`);
      hero.style.setProperty("--profile-opacity", `${clamp((value - 0.08) / 0.48)}`);
      hero.style.setProperty("--copy-opacity", `${1 - clamp((value - 0.12) / 0.42)}`);
      hero.style.setProperty("--cue-opacity", `${1 - clamp(value / 0.48)}`);
    };

    const setStoryProgress = (progress) => {
      if (!hero || !story) return;

      const value = clamp(progress);
      const extensionProgress = value;
      const identityOpacity = value;
      const concealed = 1 - extensionProgress;

      hero.style.setProperty("--story-progress", `${value}`);
      hero.style.setProperty("--story-shift", "0px");
      hero.style.setProperty("--story-extension-progress", `${extensionProgress}`);
      hero.style.setProperty("--story-extension-clip", `${concealed * 100}%`);
      hero.style.setProperty("--story-extension-y", `${concealed * -22}px`);
      hero.style.setProperty("--story-extension-scale", `${0.78 + extensionProgress * 0.22}`);
      hero.style.setProperty("--story-extension-bend", "0deg");
      hero.style.setProperty("--story-identity-opacity", `${identityOpacity}`);
      hero.classList.toggle("is-story-active", value > 0.01);
      hero.classList.toggle("is-story-identity", identityOpacity > 0.08);
      story.setAttribute("aria-hidden", value > 0.01 ? "false" : "true");
    };

    const clearRiftState = () => {
      window.clearTimeout(riftTimer);
      riftTimer = 0;
      riftRenderer?.reset();
      hero?.classList.remove("is-rift-forming", "is-rift-ready", "is-rift-executing");
      hero?.style.removeProperty("--rift-terminal-x");
      hero?.style.removeProperty("--rift-terminal-y");
      hero?.style.removeProperty("--rift-terminal-origin-y");
      hero?.style.removeProperty("--rift-avatar-x");
      hero?.style.removeProperty("--rift-avatar-y");
      rift?.setAttribute("aria-hidden", "true");
      rift?.setAttribute("tabindex", "-1");
    };

    const completeRift = () => {
      if (!hero || state !== "rift" || !hero.classList.contains("is-rift-forming")) return;
      hero.classList.remove("is-rift-forming");
      hero.classList.add("is-rift-ready");
      riftRenderer?.settle();
      window.clearTimeout(riftTimer);
      riftTimer = 0;
    };

    const handleRiftAnimationEnd = (event) => {
      if (event.target === rift && event.animationName === "identity-rift-data-form") completeRift();
    };
    rift?.addEventListener("animationend", handleRiftAnimationEnd);
    heroCleanupTasks.push(() => rift?.removeEventListener("animationend", handleRiftAnimationEnd));

    const formRift = () => {
      if (!hero || !rift || state !== "story") return;
      const heroRect = hero.getBoundingClientRect();
      const profileRect = profile?.getBoundingClientRect();
      const targetX = heroRect.left + heroRect.width * 0.5;
      const targetY = heroRect.top + heroRect.height * 0.56;
      if (terminal && profileRect) {
        const socialLinks = terminal.querySelector(".social-links");
        const mainHeight = socialLinks
          ? socialLinks.offsetTop + socialLinks.offsetHeight
          : Math.min(terminal.offsetHeight, 294);
        const originY = mainHeight / 2;
        const centerX = profileRect.left + terminal.offsetLeft + terminal.offsetWidth / 2;
        const centerY = profileRect.top + terminal.offsetTop + originY;
        hero.style.setProperty("--rift-terminal-x", `${targetX - centerX}px`);
        hero.style.setProperty("--rift-terminal-y", `${targetY - centerY}px`);
        hero.style.setProperty("--rift-terminal-origin-y", `${originY}px`);
      }
      if (avatar && profileRect) {
        const centerX = profileRect.left + avatar.offsetLeft + avatar.offsetWidth / 2;
        const centerY = profileRect.top + avatar.offsetTop + avatar.offsetHeight / 2;
        hero.style.setProperty("--rift-avatar-x", `${targetX - centerX}px`);
        hero.style.setProperty("--rift-avatar-y", `${targetY - centerY}px`);
      }
      state = "rift";
      hero.classList.remove("is-rift-ready", "is-rift-executing");
      hero.classList.add("is-rift-forming");
      riftRenderer?.startFormation();
      rift.setAttribute("aria-hidden", "false");
      rift.setAttribute("tabindex", "0");
      window.clearTimeout(riftTimer);
      riftTimer = window.setTimeout(completeRift, 900);
    };

    const resetPull = () => {
      if (state === "passed") return;
      window.clearTimeout(resetTimer);
      window.clearTimeout(releaseTimer);
      pull = 0;
      storyPull = 0;
      state = "idle";
      clearRiftState();
      hero?.classList.remove("is-docked", "is-pulling", "is-story-active", "is-story-identity");
      setProgress(0);
      setStoryProgress(0);
    };

    const settlePull = () => {
      if (state !== "pulling") return;

      if (pull / pullDistance >= dockThreshold) {
        dockProfile();
      } else {
        resetPull();
      }
    };

    const schedulePullSettle = () => {
      window.clearTimeout(resetTimer);
      resetTimer = window.setTimeout(settlePull, resetDelay);
    };

    const dockProfile = () => {
      pull = pullDistance;
      state = "docked";
      hero?.classList.remove("is-pulling");
      hero?.classList.add("is-docked");
      setProgress(1);

      window.clearTimeout(releaseTimer);
      releaseTimer = window.setTimeout(() => {
        state = "docked";
      }, releaseDelay);
    };

    const handleHeroWheel = (event) => {
      if (!stage || !hero) return;
      if (document.documentElement.classList.contains("is-notice-open")) return;

      const atHeroTop = window.scrollY <= 2 && stage.getBoundingClientRect().top >= -2;
      if (!atHeroTop) {
        return;
      }

      if (event.deltaY < 0) {
        event.preventDefault();
        window.clearTimeout(releaseTimer);

        if (state === "rift") {
          clearRiftState();
          state = "story";
          storyPull = 1;
          setStoryProgress(1);
          return;
        }

        if (storyPull > 0) {
          storyPull = 0;
          state = "docked";
          setStoryProgress(0);
          return;
        }

        if (state === "docked" || state === "story") {
          pull = 0;
          state = "idle";
          hero.classList.remove("is-docked", "is-pulling");
          setProgress(0);
          setStoryProgress(0);
          return;
        }

        pull = clamp(pull + event.deltaY * 0.82, 0, pullDistance);
        state = pull > 0 ? "pulling" : "idle";
        hero.classList.toggle("is-pulling", state === "pulling");
        hero.classList.remove("is-docked");
        setProgress(pull / pullDistance);
        if (state === "pulling") {
          schedulePullSettle();
        } else {
          window.clearTimeout(resetTimer);
        }
        return;
      }

      if (state === "docked") {
        event.preventDefault();
        storyPull = 1;
        state = "story";
        setStoryProgress(1);
        return;
      }
      if (state === "story") {
        event.preventDefault();
        formRift();
        return;
      }
      if (state === "rift") {
        event.preventDefault();
        return;
      }

      event.preventDefault();
      window.clearTimeout(releaseTimer);

      const resistance = 1 - clamp(pull / pullDistance) * 0.5;
      pull = clamp(pull + event.deltaY * resistance, 0, pullDistance);
      const progress = pull / pullDistance;

      hero.classList.add("is-pulling");
      hero.classList.remove("is-docked");
      state = "pulling";
      setProgress(progress);
      schedulePullSettle();
    };

    const handleHeroScroll = () => {
      if (!stage || !hero) return;

      const nativeProgress = clamp(-stage.getBoundingClientRect().top / (window.innerHeight || 1));
      hero.style.setProperty("--hero-dim", `${0.12 + clamp((nativeProgress - 1.05) / 0.25) * 0.12}`);
    };

    runTypingLoop(typingTarget, terminalLines);
    runTypingLoop(nameTarget, nameLines, 96, 46, 1500);

    const pokeAvatar = document.querySelector("[data-poke-avatar]");
    const pokeBubble = document.querySelector("[data-poke-bubble]");
    let lastPokeAt = 0;
    let bubbleTimer = 0;

    const showPokeBubble = (text) => {
      if (!pokeBubble) return;
      pokeBubble.textContent = text;
      pokeBubble.classList.add("is-visible");
      window.clearTimeout(bubbleTimer);
      bubbleTimer = window.setTimeout(() => {
        pokeBubble.classList.remove("is-visible");
      }, 1700);
    };

    const handlePokeMove = (event) => {
      const rect = pokeAvatar.getBoundingClientRect();
      const offset = ((event.clientX - rect.left) / rect.width - 0.5) * 2;
      pokeAvatar.style.setProperty("--flower-sway", `${offset * 9}deg`);
    };

    const handlePokeLeave = () => {
      pokeAvatar.style.setProperty("--flower-sway", "0deg");
    };

    const handlePokeDoubleClick = (event) => {
      event.preventDefault();
      const now = Date.now();
      if (now - lastPokeAt < 10000) {
        showPokeBubble("\u64cd\u4f5c\u592a\u5feb\u5566\uff0c\u4f11\u606f\u4e00\u4e0b\u5427");
        return;
      }

      lastPokeAt = now;
      pokeAvatar.classList.remove("is-poked");
      void pokeAvatar.offsetWidth;
      pokeAvatar.classList.add("is-poked");
      showPokeBubble("\u6233\u5230\u4e86~");
      window.setTimeout(() => pokeAvatar.classList.remove("is-poked"), 720);
    };

    const handleRiftClick = (event) => {
      if (!rift || !hero || state !== "rift") {
        event.preventDefault();
        return;
      }
      if (riftNavigationArmed) return;

      event.preventDefault();
      riftNavigationArmed = true;
      riftRenderer?.execute();
      hero.classList.remove("is-rift-forming");
      hero.classList.add("is-rift-ready", "is-rift-executing");
      window.clearTimeout(riftNavigationTimer);
      riftNavigationTimer = window.setTimeout(() => {
        riftNavigationTimer = 0;
        rift.click();
      }, 340);
    };

    pokeAvatar?.addEventListener("pointermove", handlePokeMove);
    pokeAvatar?.addEventListener("pointerleave", handlePokeLeave);
    pokeAvatar?.addEventListener("dblclick", handlePokeDoubleClick);
    rift?.addEventListener("click", handleRiftClick);
    heroCleanupTasks.push(() => {
      pokeAvatar?.removeEventListener("pointermove", handlePokeMove);
      pokeAvatar?.removeEventListener("pointerleave", handlePokeLeave);
      pokeAvatar?.removeEventListener("dblclick", handlePokeDoubleClick);
      rift?.removeEventListener("click", handleRiftClick);
    });

    setProgress(0);
    setStoryProgress(0);
    handleHeroScroll();
    window.addEventListener("wheel", handleHeroWheel, { passive: false });
    window.addEventListener("scroll", handleHeroScroll, { passive: true });
    const handleHeroResize = () => {
      handleHeroScroll();
      riftRenderer?.resize();
    };
    window.addEventListener("resize", handleHeroResize);
    window.addEventListener("pageshow", handleHeroScroll);
    heroCleanupTasks.push(() => {
      window.clearTimeout(resetTimer);
      window.clearTimeout(releaseTimer);
      window.clearTimeout(riftTimer);
      window.clearTimeout(riftNavigationTimer);
      window.clearTimeout(bubbleTimer);
      typingTimers.forEach((timer) => window.clearTimeout(timer));
      typingTimers.clear();
      window.removeEventListener("wheel", handleHeroWheel);
      window.removeEventListener("scroll", handleHeroScroll);
      window.removeEventListener("resize", handleHeroResize);
      window.removeEventListener("pageshow", handleHeroScroll);
      riftRenderer?.destroy();
    });
    })();
  </script>

</BaseLayout>
