---
import BaseLayout from "../layouts/BaseLayout.astro";
import { projectEntries } from "@/core/data/projects";

const projectOrder = [
  "earth-online",
  "fushenglu",
  "zhi-wei",
  "campus-reimburse-kit",
  "mindcache"
] as const;

const projects = projectOrder.flatMap((id) => {
  const project = projectEntries.find((entry) => entry.id === id);
  return project ? [project] : [];
});
const archive = projectEntries.find((entry) => entry.id === "more-projects");
---

<BaseLayout title="Projects | Rain_dust" description="Rain_dust 持续维护的个人项目与技术实验档案。">
  <section class="projects-archive" aria-labelledby="projects-title">
    <div class="projects-content">
      <header class="projects-heading">
        <h1 id="projects-title">Projects</h1>
        <p class="projects-subtitle">项目档案</p>
        <span class="projects-signal" aria-hidden="true"></span>
        <p class="projects-intro">
          这里不是严肃作品集，而是一份持续更新的个人技术档案。
          每个条目都连接到仍然真实存在的项目仓库。
        </p>
      </header>

      <ol class="project-index" aria-label="项目仓库">
        {
          projects.map((project) => (
            <li class="project-item">
              <a
                class="project-row"
                href={project.url}
                target="_blank"
                rel="noreferrer"
                aria-label={`访问 ${project.title} 的 GitHub 仓库（新标签页）`}
              >
                <span class="project-name">{project.title}</span>
                <span class="project-summary">{project.summary}</span>
                <span class="project-tech">{project.details.join(" / ")}</span>
              </a>
            </li>
          ))
        }
      </ol>

      {
        archive && (
          <a
            class="archive-link"
            href={archive.url}
            target="_blank"
            rel="noreferrer"
            aria-label="访问 Rain_dust 的 GitHub 仓库归档（新标签页）"
          >
            GitHub Archive <span aria-hidden="true">→</span>
          </a>
        )
      }
    </div>
  </section>

  <script>
    const projectInteractionStates = new WeakMap();

    const initProjectsArchive = () => {
      const root = document.querySelector(".projects-archive");
      if (!(root instanceof HTMLElement) || projectInteractionStates.has(root)) return;

      const controller = new AbortController();
      const { signal } = controller;
      const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      const precisePointer = window.matchMedia("(hover: hover) and (pointer: fine)").matches;
      const canTrackLight = precisePointer;
      let frame = 0;
      let nextLightX = 76;
      let nextLightY = 28;
      let nextReflectionX = 68;
      let nextReflectionY = 48;
      let nextLightStrength = 0.25;
      let nextReflectionStrength = 0.12;
      let pointerInside = false;

      const writeLightPosition = () => {
        frame = 0;
        root.style.setProperty("--archive-light-x", `${nextLightX}%`);
        root.style.setProperty("--archive-light-y", `${nextLightY}%`);
        root.style.setProperty("--archive-reflection-x", `${nextReflectionX}%`);
        root.style.setProperty("--archive-reflection-y", `${nextReflectionY}%`);
        root.style.setProperty("--archive-light-strength", String(nextLightStrength));
        root.style.setProperty("--archive-reflection-strength", String(nextReflectionStrength));
      };

      const scheduleLightPosition = () => {
        if (frame) return;
        frame = window.requestAnimationFrame(writeLightPosition);
      };

      const resetLightPosition = () => {
        root.classList.add("is-light-returning");
        nextLightX = 76;
        nextLightY = 28;
        nextReflectionX = 68;
        nextReflectionY = 48;
        nextLightStrength = 0.25;
        nextReflectionStrength = 0.12;
        scheduleLightPosition();
      };

      const handlePointerMove = (event) => {
        if (!(event.target instanceof Node) || !root.contains(event.target)) {
          if (pointerInside) resetLightPosition();
          pointerInside = false;
          return;
        }

        pointerInside = true;
        const rect = root.getBoundingClientRect();
        if (!rect.width || !rect.height) return;

        const horizontal = Math.min(1, Math.max(-1, ((event.clientX - rect.left) / rect.width - 0.5) * 2));
        const vertical = Math.min(1, Math.max(-1, ((event.clientY - rect.top) / rect.height - 0.5) * 2));

        root.classList.remove("is-light-returning");
        if (reducedMotion) {
          const horizontalProgress = (horizontal + 1) / 2;
          nextLightStrength = 0.08 + horizontalProgress * 0.46;
          nextReflectionStrength = 0.03 + horizontalProgress * 0.2;
        } else {
          nextLightX = 76 + horizontal * 6;
          nextLightY = 28 + vertical * 4;
          nextReflectionX = 68 + horizontal * 3.5;
          nextReflectionY = 48 + vertical * 2.5;
        }
        scheduleLightPosition();
      };

      const cleanup = () => {
        controller.abort();
        if (frame) window.cancelAnimationFrame(frame);
        frame = 0;
        root.classList.remove("is-light-returning");
        root.removeAttribute("data-light-tracking");
        root.style.removeProperty("--archive-light-x");
        root.style.removeProperty("--archive-light-y");
        root.style.removeProperty("--archive-reflection-x");
        root.style.removeProperty("--archive-reflection-y");
        root.style.removeProperty("--archive-light-strength");
        root.style.removeProperty("--archive-reflection-strength");
        projectInteractionStates.delete(root);
      };

      root.dataset.lightTracking = canTrackLight
        ? reducedMotion
          ? "reduced"
          : "active"
        : "static";
      projectInteractionStates.set(root, cleanup);

      if (canTrackLight) {
        document.addEventListener("pointermove", handlePointerMove, { passive: true, signal });
      }

      document.addEventListener("astro:before-swap", cleanup, { once: true, signal });
    };

    document.addEventListener("astro:page-load", initProjectsArchive);
    initProjectsArchive();
  </script>

  <style>
    @property --archive-light-x {
      syntax: "<percentage>";
      inherits: true;
      initial-value: 76%;
    }

    @property --archive-light-y {
      syntax: "<percentage>";
      inherits: true;
      initial-value: 28%;
    }

    @property --archive-reflection-x {
      syntax: "<percentage>";
      inherits: true;
      initial-value: 68%;
    }

    @property --archive-reflection-y {
      syntax: "<percentage>";
      inherits: true;
      initial-value: 48%;
    }

    @property --archive-light-strength {
      syntax: "<number>";
      inherits: true;
      initial-value: 0.25;
    }

    @property --archive-reflection-strength {
      syntax: "<number>";
      inherits: true;
      initial-value: 0.12;
    }

    .projects-archive {
      --archive-bg: #141512;
      --archive-bg-deep: #10110f;
      --archive-warm: #8f7a67;
      --archive-text: #ded9cf;
      --archive-secondary: #9b968e;
      --archive-muted: #74716b;
      --archive-line: rgba(222, 217, 207, 0.16);
      --archive-signal: #8b3e3c;
      --archive-light-x: 76%;
      --archive-light-y: 28%;
      --archive-reflection-x: 68%;
      --archive-reflection-y: 48%;
      --archive-light-strength: 0.25;
      --archive-reflection-strength: 0.12;
      position: relative;
      isolation: isolate;
      min-height: 100dvh;
      overflow: hidden;
      color: var(--archive-text);
      background:
        linear-gradient(90deg, rgba(16, 17, 15, 0.99) 0 41%, rgba(19, 20, 18, 0.95) 62%, rgba(25, 24, 21, 0.91) 100%),
        var(--archive-bg);
    }

    .projects-archive::before {
      position: absolute;
      inset: 0;
      z-index: -2;
      content: "";
      background:
        linear-gradient(90deg, transparent 0 76%, rgba(15, 16, 15, 0.2) 76% 77%, transparent 77%),
        linear-gradient(0deg, transparent 0 78%, rgba(199, 181, 160, 0.05) 78% 78.3%, transparent 78.3%),
        linear-gradient(128deg, transparent 0 57%, rgba(163, 139, 116, 0.2) 57.2% 75%, rgba(64, 58, 51, 0.08) 75.2%),
        radial-gradient(
          ellipse at var(--archive-light-x) var(--archive-light-y),
          rgba(159, 135, 112, var(--archive-light-strength)),
          transparent 36%
        );
      opacity: 0.92;
      transition:
        --archive-light-x 90ms linear,
        --archive-light-y 90ms linear,
        --archive-light-strength 120ms linear;
    }

    .projects-archive::after {
      position: absolute;
      right: -8%;
      bottom: -20%;
      z-index: -1;
      width: 72%;
      height: 48%;
      content: "";
      background:
        linear-gradient(168deg, transparent 0 38%, rgba(174, 151, 128, 0.12) 39%, rgba(62, 57, 51, 0.06) 61%, transparent 78%),
        radial-gradient(
          ellipse at var(--archive-reflection-x) var(--archive-reflection-y),
          rgba(158, 135, 113, var(--archive-reflection-strength)),
          transparent 52%
        );
      filter: blur(2px);
      transform: skewX(-12deg);
      transform-origin: bottom right;
      transition:
        --archive-reflection-x 110ms linear,
        --archive-reflection-y 110ms linear,
        --archive-reflection-strength 140ms linear;
    }

    .projects-archive.is-light-returning::before {
      transition-duration: 680ms;
      transition-timing-function: cubic-bezier(0.22, 0.04, 0.36, 1);
    }

    .projects-archive.is-light-returning::after {
      transition-duration: 720ms;
      transition-timing-function: cubic-bezier(0.22, 0.04, 0.36, 1);
    }

    .projects-archive[data-light-tracking="reduced"].is-light-returning::before,
    .projects-archive[data-light-tracking="reduced"].is-light-returning::after {
      transition-duration: 220ms;
      transition-timing-function: ease-out;
    }

    .projects-content {
      width: min(1120px, calc(100% - 96px));
      margin: 0 auto;
      padding: clamp(108px, 13vh, 142px) 0 78px;
    }

    .projects-heading {
      width: min(660px, 68%);
      margin-bottom: clamp(42px, 6vh, 64px);
      animation: projects-heading-reveal 760ms cubic-bezier(0.22, 0.04, 0.36, 1) both;
    }

    @keyframes projects-heading-reveal {
      from {
        opacity: 0.35;
        filter: blur(4px);
        transform: translateY(10px);
      }

      to {
        opacity: 1;
        filter: blur(0);
        transform: translateY(0);
      }
    }

    @keyframes projects-heading-reduced-reveal {
      from {
        opacity: 0.2;
      }

      to {
        opacity: 1;
      }
    }

    .projects-heading h1 {
      margin: 0;
      color: var(--archive-text);
      font-family: "Noto Serif SC", "Source Han Serif SC", "Songti SC", Georgia, serif;
      font-size: clamp(4rem, 7.4vw, 6.6rem);
      font-weight: 500;
      line-height: 0.94;
      letter-spacing: -0.045em;
    }

    .projects-subtitle {
      margin: 16px 0 0;
      color: var(--archive-secondary);
      font-family: "Noto Serif SC", "Source Han Serif SC", "Songti SC", serif;
      font-size: 1.08rem;
      font-weight: 600;
      letter-spacing: 0.22em;
    }

    .projects-signal {
      display: block;
      width: 44px;
      height: 1px;
      margin: 24px 0;
      background: var(--archive-signal);
    }

    .projects-intro {
      max-width: 610px;
      margin: 0;
      color: var(--archive-secondary);
      font-size: 0.96rem;
      font-weight: 500;
      line-height: 1.9;
    }

    .project-index {
      position: relative;
      width: min(100%, 1080px);
      margin: 0;
      padding: 0 0 0 70px;
      list-style: none;
    }

    .project-index::before {
      position: absolute;
      top: 0;
      bottom: 0;
      left: 0;
      width: 1px;
      content: "";
      background: var(--archive-line);
    }

    .project-item {
      position: relative;
      margin: 0;
    }

    .project-item::before {
      position: absolute;
      top: 50%;
      left: -74px;
      z-index: 1;
      width: 9px;
      height: 9px;
      content: "";
      background: #70716d;
      border: 2px solid var(--archive-bg);
      border-radius: 50%;
      transform: translateY(-50%);
      transition:
        background-color 200ms ease,
        box-shadow 200ms ease;
    }

    .project-row {
      position: relative;
      display: grid;
      grid-template-columns: minmax(190px, 0.82fr) minmax(340px, 1.65fr) minmax(180px, 0.9fr);
      gap: clamp(24px, 4vw, 52px);
      align-items: center;
      min-height: 92px;
      padding: 20px 6px 20px 0;
      color: inherit;
      text-decoration: none;
      border-top: 1px solid var(--archive-line);
      transition:
        border-color 200ms ease,
        background-color 200ms ease;
    }

    .project-item:last-child .project-row {
      border-bottom: 1px solid var(--archive-line);
    }

    .project-name {
      color: #d6d1c8;
      font-family: "Noto Serif SC", "Source Han Serif SC", "Songti SC", Georgia, serif;
      font-size: clamp(1rem, 1.4vw, 1.18rem);
      font-weight: 600;
      line-height: 1.35;
      letter-spacing: 0.025em;
      transition: color 200ms ease;
    }

    .project-summary {
      color: var(--archive-secondary);
      font-size: 0.89rem;
      font-weight: 500;
      line-height: 1.72;
      transition:
        color 200ms ease,
        transform 200ms ease;
    }

    .project-tech {
      color: var(--archive-muted);
      font-size: 0.78rem;
      font-weight: 550;
      line-height: 1.55;
    }

    .project-item:has(.project-row:hover)::before,
    .project-item:has(.project-row:focus-visible)::before {
      background: var(--archive-signal);
      box-shadow: 0 0 0 5px rgba(139, 62, 60, 0.14);
    }

    .project-row:hover,
    .project-row:focus-visible {
      background: linear-gradient(90deg, rgba(139, 62, 60, 0.045), transparent 72%);
      border-color: rgba(139, 62, 60, 0.45);
      outline: none;
    }

    .project-row:hover .project-name,
    .project-row:focus-visible .project-name {
      color: #f0ece4;
    }

    .project-row:hover .project-summary,
    .project-row:focus-visible .project-summary {
      color: #b9b3a9;
      transform: translateX(6px);
    }

    .project-row:focus-visible {
      box-shadow: inset 3px 0 0 var(--archive-signal);
    }

    .archive-link {
      display: inline-flex;
      gap: 10px;
      align-items: center;
      margin: 30px 0 0 70px;
      padding: 8px 0;
      color: var(--archive-secondary);
      font-size: 0.83rem;
      font-weight: 650;
      letter-spacing: 0.04em;
      text-decoration: none;
      border-bottom: 1px solid transparent;
      transition:
        color 200ms ease,
        border-color 200ms ease;
    }

    .archive-link:hover,
    .archive-link:focus-visible {
      color: var(--archive-text);
      border-color: var(--archive-signal);
      outline: none;
    }

    .archive-link:focus-visible {
      box-shadow: 0 3px 0 rgba(139, 62, 60, 0.22);
    }

    :global(body:has(.projects-archive) .site-footer) {
      color: #9b968e;
      border-top: 1px solid rgba(222, 217, 207, 0.14);
      background:
        linear-gradient(128deg, transparent 0 54%, rgba(143, 122, 103, 0.13) 54.5% 72%, transparent 72.5%),
        radial-gradient(ellipse at 78% 18%, rgba(159, 135, 112, 0.16), transparent 38%),
        linear-gradient(90deg, #10110f 0 48%, #151512 100%);
    }

    :global(body:has(.projects-archive) .footer-inner) {
      border-top: 1px solid rgba(222, 217, 207, 0.15);
      text-shadow: none;
    }

    :global(body:has(.projects-archive) .footer-inner p),
    :global(body:has(.projects-archive) .footer-signature-line) {
      color: #a7a198;
      font-weight: 650;
    }

    @media (max-width: 900px) {
      .projects-content {
        width: min(100% - 48px, 760px);
      }

      .projects-heading {
        width: min(100%, 620px);
      }

      .project-row {
        grid-template-columns: minmax(150px, 0.8fr) minmax(260px, 1.4fr);
        gap: 10px 30px;
      }

      .project-tech {
        grid-column: 2;
      }
    }

    @media (max-width: 620px) {
      .projects-archive::before {
        background:
          linear-gradient(132deg, transparent 0 60%, rgba(142, 121, 101, 0.12) 60.5% 78%, transparent 78.5%),
          radial-gradient(ellipse at 92% 18%, rgba(147, 126, 105, 0.16), transparent 40%);
      }

      .projects-archive::after {
        display: none;
      }

      .projects-content {
        width: min(100% - 34px, 520px);
        padding: 88px 0 56px;
      }

      .projects-heading {
        margin-bottom: 38px;
      }

      .projects-heading h1 {
        font-size: clamp(3.35rem, 17vw, 4.4rem);
      }

      .projects-subtitle {
        margin-top: 12px;
        font-size: 0.96rem;
      }

      .projects-signal {
        margin: 20px 0;
      }

      .projects-intro {
        font-size: 0.9rem;
        line-height: 1.75;
      }

      .project-index {
        padding-left: 32px;
      }

      .project-item::before {
        left: -36px;
        width: 8px;
        height: 8px;
      }

      .project-row {
        grid-template-columns: 1fr;
        gap: 9px;
        min-height: 0;
        padding: 22px 2px 22px 0;
      }

      .project-name {
        font-size: 1.08rem;
      }

      .project-summary {
        font-size: 0.87rem;
        line-height: 1.65;
      }

      .project-tech {
        grid-column: auto;
        font-size: 0.75rem;
      }

      .project-row:hover .project-summary,
      .project-row:focus-visible .project-summary {
        transform: translateX(4px);
      }

      .archive-link {
        margin: 26px 0 0 32px;
      }
    }

    @media (prefers-reduced-motion: reduce) {
      .projects-archive::before,
      .projects-archive::after {
        transition:
          --archive-light-strength 120ms linear,
          --archive-reflection-strength 140ms linear;
      }

      .projects-heading {
        animation: projects-heading-reduced-reveal 420ms ease-out both;
      }

      .project-item::before,
      .project-row,
      .project-name,
      .project-summary,
      .archive-link {
        transition: none;
      }

      .project-row:hover .project-summary,
      .project-row:focus-visible .project-summary {
        transform: none;
      }
    }
  </style>
</BaseLayout>
