---
import BaseLayout from "../layouts/BaseLayout.astro";
import { projectEntries } from "@/core/data/projects";

const vaultProjects = projectEntries.filter((entry) => entry.id !== "more-projects");
const archive = projectEntries.find((entry) => entry.id === "more-projects");
const tunnelFrames = Array.from({ length: 11 }, (_, index) => index);
const cellarSteps = Array.from({ length: 34 }, (_, index) => index);
---

<BaseLayout title="Projects | Rain_dust" description="Rain_dust 持续维护的个人项目与技术实验档案。">
  <section class="vault" data-vault data-vault-booting="true" aria-labelledby="vault-title">
    <script is:inline>
      (() => {
        const root = document.currentScript?.closest("[data-vault]");
        if (!(root instanceof HTMLElement)) return;
        const fine = matchMedia("(hover: hover) and (pointer: fine)").matches;
        if (fine) root.dataset.vaultBooting = "true";
        else delete root.dataset.vaultBooting;
      })();
    </script>
    <div class="vault-viewport">
      <canvas class="vault-webgl" data-vault-webgl aria-hidden="true"></canvas>
      <div class="vault-boot-screen" data-vault-boot-screen role="status" aria-live="polite">
        <span>RAIN_DUST PRIVATE CELLAR</span>
        <i aria-hidden="true"></i>
        <small>CALIBRATING SPATIAL ARCHIVE</small>
      </div>
      <div class="vault-webgl-hud" aria-hidden="true">
        <span>RAIN_DUST CELLAR / SPATIAL STUDY 01</span>
        <small>SCROLL · DESCEND · HOLD BOTTLE TO INSPECT</small>
      </div>
      <aside class="vault-focus-card" data-vault-focus-card aria-live="polite" aria-hidden="true">
        <i class="vault-focus-label-art" aria-hidden="true"></i>
        <span data-vault-focus-kicker>PRIVATE RESERVE</span>
        <h2 data-vault-focus-name></h2>
        <p data-vault-focus-summary></p>
        <small data-vault-focus-details></small>
      </aside>
      <button class="vault-focus-exit" type="button" data-vault-focus-close aria-label="退出项目视角">
        <span aria-hidden="true">←</span> CELLAR <kbd>ESC</kbd>
      </button>
      <div class="vault-focus-intent" data-vault-focus-intent aria-hidden="true">
        <i aria-hidden="true"></i>
        <span>HOLD TO INSPECT</span>
      </div>
      <div class="vault-grain" aria-hidden="true"></div>
      <div class="vault-vignette" aria-hidden="true"></div>

      <div class="vault-world" data-vault-world aria-hidden="true">
        <div class="vault-backwall"><span></span></div>
        <div class="vault-ceiling"><i></i><i></i><i></i><i></i></div>
        <div class="vault-side vault-side--left"></div>
        <div class="vault-side vault-side--right"></div>
        {tunnelFrames.map((index) => (
          <div class="vault-arch" data-tunnel-frame={index}>
            <i class="vault-arch__left"></i>
            <i class="vault-arch__right"></i>
          </div>
        ))}
      </div>

      <div class="vault-foreground" data-vault-foreground aria-hidden="true">
        <div class="vault-rail vault-rail--left"><i></i><i></i><i></i></div>
        <div class="vault-rail vault-rail--right"><i></i><i></i><i></i></div>
        <div class="vault-steps" data-vault-steps>
          {cellarSteps.map((index) => <i data-cellar-step={index}></i>)}
        </div>
        <div class="vault-doorframe vault-doorframe--left"></div>
        <div class="vault-doorframe vault-doorframe--right"></div>
      </div>

      <header class="vault-heading">
        <p>Rain_dust / private reserve</p>
        <h1 id="vault-title">Projects</h1>
        <span>向下进入酒窖。每一瓶，保存一个仍在陈化的项目。</span>
      </header>

      <div class="vault-depth-meter" aria-hidden="true">
        <span></span><i>GROUND</i><i>RESERVE I</i><i>RESERVE II</i>
      </div>

      <div class="vault-scenes">
        {
          vaultProjects.map((project, index) => (
            <article
              class:list={["vault-bay", "vault-bay--" + project.id]}
              data-vault-bay={project.id}
            >
              <div class="vault-bay__stone" aria-hidden="true">
                <span class="vault-bay__recess"></span>
                <span class="vault-bay__lintel"></span>
              </div>
              <div class="wine-rack" aria-hidden="true">
                <span class="wine-rack__post wine-rack__post--left"></span>
                <span class="wine-rack__post wine-rack__post--right"></span>
                <span class="wine-rack__shelf wine-rack__shelf--top"></span>
                <span class="wine-rack__shelf wine-rack__shelf--bottom"></span>
                <span class="rack-bottle rack-bottle--a"></span>
                <span class="rack-bottle rack-bottle--b"></span>
                <span class="rack-bottle rack-bottle--c"></span>
                <span class="rack-bottle rack-bottle--d"></span>
              </div>

              <button
                class:list={["project-bottle", "project-bottle--" + project.id]}
                type="button"
                data-project-bottle={project.id}
                aria-expanded="false"
                aria-controls="vault-project-drawer"
                aria-label={"打开 " + project.title + " 项目档案"}
              >
                <span class="project-bottle__cork" aria-hidden="true"></span>
                <span class="project-bottle__lip" aria-hidden="true"></span>
                <span class="project-bottle__neck" aria-hidden="true"></span>
                <span class="project-bottle__shoulder" aria-hidden="true"></span>
                <span class="project-bottle__body" aria-hidden="true">
                  <span class="project-bottle__wine"></span>
                  <span class="project-bottle__glass"></span>
                  <span class="project-bottle__shine"></span>
                </span>
                <span class="wine-label">
                  <span class="wine-label__patina" aria-hidden="true"></span>
                  <span class="wine-label__series">RAIN_DUST PRIVATE RESERVE</span>
                  {project.id === "earth-online" ? (
                    <span class="wine-label__emblem wine-label__emblem--orbit" aria-hidden="true"><i></i><i></i><i></i></span>
                  ) : (
                    <span class="wine-label__emblem wine-label__emblem--index" aria-hidden="true"><i></i><i></i><i></i></span>
                  )}
                  <strong>{project.title}</strong>
                  <span class="wine-label__type">{project.type}</span>
                  <span class="wine-label__rule" aria-hidden="true"></span>
                  <span class="wine-label__state">{project.status}</span>
                </span>
                <span class="project-bottle__base" aria-hidden="true"></span>
              </button>

              <div class="vault-bay__caption">
                <span>{"RESERVE " + String(index + 1).padStart(2, "0")}</span>
                <strong>{project.title}</strong>
                <small>{project.details.join(" / ")}</small>
              </div>
            </article>
          ))
        }
      </div>

      <p class="vault-instruction"><span aria-hidden="true">↓</span> SCROLL TO DESCEND</p>

      <aside class="vault-drawer" id="vault-project-drawer" data-vault-drawer aria-label="项目档案抽屉" aria-hidden="true">
        <button class="vault-drawer__close" type="button" data-drawer-close aria-label="关闭项目档案">×</button>
        {
          vaultProjects.map((project, index) => (
            <section class="vault-drawer__sheet" data-drawer-sheet={project.id} hidden>
              <div class="vault-drawer__folio">
                <span>{"PRIVATE RESERVE / " + String(index + 1).padStart(2, "0")}</span>
                <span>{project.status}</span>
              </div>
              <h2>{project.title}</h2>
              <p>{project.summary}</p>
              <dl>
                <div><dt>FORM</dt><dd>{project.type}</dd></div>
                <div><dt>STACK</dt><dd>{project.details.join(" / ")}</dd></div>
                <div><dt>STATE</dt><dd>{project.status}</dd></div>
              </dl>
              <a href={project.url} target="_blank" rel="noreferrer">View source <span aria-hidden="true">↗</span></a>
            </section>
          ))
        }
      </aside>

      {archive && (
        <a class="vault-archive-link" href={archive.url} target="_blank" rel="noreferrer">
          GitHub Archive <span aria-hidden="true">↗</span>
        </a>
      )}
    </div>
  </section>

  <script>
    type ProjectVault3D = { destroy: () => void };

    type VaultWindow = Window & {
      __rainDustVaultCleanup?: () => void;
      __rainDustVaultBinding?: AbortController;
      __rainDustVault3D?: ProjectVault3D;
      __rainDustVaultLoadId?: number;
    };

    const vaultWindow = window as VaultWindow;
    vaultWindow.__rainDustVaultBinding?.abort();
    const vaultBinding = new AbortController();
    vaultWindow.__rainDustVaultBinding = vaultBinding;

    const clamp = (value: number, min = 0, max = 1) => Math.min(max, Math.max(min, value));
    const smoother = (value: number) => value * value * value * (value * (value * 6 - 15) + 10);

    const initVault = async () => {
      vaultWindow.__rainDustVaultCleanup?.();
      const root = document.querySelector<HTMLElement>("[data-vault]");
      if (!root) return;
      const viewport = root.querySelector<HTMLElement>(".vault-viewport");
      const world = root.querySelector<HTMLElement>("[data-vault-world]");
      const foreground = root.querySelector<HTMLElement>("[data-vault-foreground]");
      const drawer = root.querySelector<HTMLElement>("[data-vault-drawer]");
      const closeButton = root.querySelector<HTMLButtonElement>("[data-drawer-close]");
      const bottles = Array.from(root.querySelectorAll<HTMLButtonElement>("[data-project-bottle]"));
      const bays = Array.from(root.querySelectorAll<HTMLElement>("[data-vault-bay]"));
      const arches = Array.from(root.querySelectorAll<HTMLElement>("[data-tunnel-frame]"));
      const steps = Array.from(root.querySelectorAll<HTMLElement>("[data-cellar-step]"));
      if (!viewport || !world || !foreground || !drawer) return;

      const controller = new AbortController();
      const signal = controller.signal;
      const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      const fine = window.matchMedia("(hover: hover) and (pointer: fine)").matches;
      const forced = new URLSearchParams(location.search).get("motion") === "force" && fine;
      const immersive = fine;
      const webglCanvas = root.querySelector<HTMLCanvasElement>("[data-vault-webgl]");
      vaultWindow.__rainDustVault3D?.destroy();
      vaultWindow.__rainDustVault3D = undefined;
      const loadId = (vaultWindow.__rainDustVaultLoadId ?? 0) + 1;
      vaultWindow.__rainDustVaultLoadId = loadId;
      let cleanupActive = () => {};
      const cleanup = () => {
        controller.abort();
        if (vaultWindow.__rainDustVaultLoadId === loadId) vaultWindow.__rainDustVaultLoadId = loadId + 1;
        cleanupActive();
        vaultWindow.__rainDustVaultCleanup = undefined;
      };
      vaultWindow.__rainDustVaultCleanup = cleanup;
      document.addEventListener("astro:before-swap", cleanup, { once: true, signal });
      if (immersive && webglCanvas) {
        root.dataset.vaultBooting = "true";
        try {
          await new Promise<void>((resolve) => requestAnimationFrame(() => requestAnimationFrame(() => resolve())));
          const { mountProjectVault3D } = await import("../scripts/project-vault-3d");
          if (!signal.aborted && vaultWindow.__rainDustVaultLoadId === loadId) {
            vaultWindow.__rainDustVault3D = mountProjectVault3D(root, webglCanvas) ?? undefined;
          }
        } catch (error) {
          root.dataset.vaultError = error instanceof Error ? error.name : "load-failed";
        }
      }
      if (signal.aborted || vaultWindow.__rainDustVaultLoadId !== loadId) return;
      const webglActive = Boolean(vaultWindow.__rainDustVault3D);
      const fallbackMotion = fine && !webglActive && (!reduced || forced);
      if (!webglActive) {
        delete root.dataset.vaultBooting;
        root.dataset.vaultRenderer = "fallback";
      }
      const stationGap = 930;
      const firstStation = 760;
      const cameraLimit = firstStation + Math.max(0, bays.length - 1) * stationGap + 520;
      let targetProgress = 0;
      let progress = 0;
      let velocity = 0;
      let sceneFrame = 0;
      let openProject = "";
      let targetX = 0;
      let targetY = 0;
      let pointerX = 0;
      let pointerY = 0;
      let lastScrollAt = performance.now();

      const readProgress = () => {
        const rect = root.getBoundingClientRect();
        targetProgress = clamp(-rect.top / Math.max(1, rect.height - innerHeight));
        lastScrollAt = performance.now();
        if (!fallbackMotion) progress = targetProgress;
      };

      const visualTarget = () => {
        if (performance.now() - lastScrollAt < 115) return targetProgress;
        const rawCamera = targetProgress * cameraLimit;
        const nearest = Math.round((rawCamera - firstStation) / stationGap);
        const station = firstStation + clamp(nearest, 0, bays.length - 1) * stationGap;
        const distance = Math.abs(rawCamera - station);
        if (distance > stationGap * 0.28) return targetProgress;
        return station / cameraLimit;
      };

      const renderScene = () => {
        sceneFrame = 0;
        const destination = visualTarget();
        if (fallbackMotion) {
          const force = (destination - progress) * 0.032;
          velocity = (velocity + force) * 0.82;
          progress += velocity;
          pointerX += (targetX - pointerX) * 0.055;
          pointerY += (targetY - pointerY) * 0.055;
        }
        progress = clamp(progress);
        const eased = smoother(progress);
        const camera = eased * cameraLimit;
        const stride = camera / 148;
        const turn = Math.sin(camera / 720) * 1.75 + Math.sin(camera / 310) * .34;
        const sway = Math.sin(camera / 205) * Math.min(1, Math.abs(velocity) * 190) * 1.35;
        const bob = Math.sin(stride * Math.PI) * Math.min(8, Math.abs(velocity) * 720);
        const activeIndex = clamp(Math.round((camera - firstStation) / stationGap), 0, bays.length - 1);

        root.style.setProperty("--vault-progress", progress.toFixed(4));
        root.style.setProperty("--camera-turn", turn.toFixed(3));
        root.style.setProperty("--camera-bob", bob.toFixed(2) + "px");
        root.style.setProperty("--observer-x", pointerX.toFixed(4));
        root.style.setProperty("--observer-y", pointerY.toFixed(4));
        root.dataset.activeReserve = String(activeIndex + 1);

        if (fallbackMotion) {
          world.style.transform = `translate3d(${(-turn * 8 - pointerX * 2).toFixed(2)}px,${(bob * .28 - pointerY * 1.5).toFixed(2)}px,0) rotateZ(${(-turn * .045).toFixed(3)}deg)`;
          foreground.style.transform = `translate3d(${(turn * 4 + sway).toFixed(2)}px,${bob.toFixed(2)}px,0) rotateZ(${(-turn * 0.07).toFixed(3)}deg)`;

          steps.forEach((step, index) => {
            const stepDepth = 110 + index * 158;
            const distance = stepDepth - camera;
            const approach = 1 - clamp((distance + 220) / 1850);
            const y = 18 + Math.pow(approach, 1.62) * 99 + bob * .12;
            const scale = .18 + approach * 1.64;
            const x = -50 - turn * approach * 1.15;
            const opacity = clamp((distance + 300) / 260) * clamp((1700 - distance) / 420);
            step.style.transform = `translate3d(${x.toFixed(2)}%,${y.toFixed(2)}vh,0) scale(${scale.toFixed(3)}) rotateX(${(55 - approach * 20).toFixed(2)}deg)`;
            step.style.opacity = opacity.toFixed(3);
          });

          bays.forEach((bay, index) => {
            const depth = firstStation + index * stationGap;
            const side = index % 2 === 0 ? -1 : 1;
            const distance = depth - camera;
            const focus = Math.exp(-Math.pow(distance / 255, 2));
            const visibility = clamp(1 - Math.max(0, Math.abs(distance) - 470) / 520);
            const corridor = clamp(distance / 900, -1, 1);
            const x = side * (31 - focus * 4 + Math.max(0, corridor) * -10) - turn * 0.72;
            const y = 6 + corridor * 5.5;
            const yaw = side * (-57 + focus * 18);
            bay.style.transform = `translate3d(calc(-50% + ${x.toFixed(2)}vw),${y.toFixed(2)}vh,${(-distance).toFixed(2)}px) rotateY(${yaw.toFixed(2)}deg) rotateX(${(-2.5 + focus * 2.5).toFixed(2)}deg)`;
            bay.style.opacity = visibility.toFixed(3);
            bay.style.filter = `brightness(${(0.43 + focus * 0.78).toFixed(3)}) saturate(${(0.55 + focus * 0.36).toFixed(3)}) blur(${(Math.max(0, Math.abs(distance) - 620) / 300).toFixed(2)}px)`;
            bay.style.setProperty("--bay-focus", focus.toFixed(4));
            bay.toggleAttribute("data-station-active", focus > 0.72);
          });

          arches.forEach((arch, index) => {
            const depth = 250 + index * 510;
            const distance = depth - camera;
            const projected = 760 / Math.max(300, 760 + distance);
            const proximity = clamp(1 - Math.abs(distance) / 960);
            const visibility = clamp((distance + 430) / 180) * clamp((2100 - distance) / 430);
            const pathX = Math.sin(depth / 720) * 5.4 + Math.sin(depth / 310) * 1.2;
            const cameraX = Math.sin(camera / 720) * 5.4 + Math.sin(camera / 310) * 1.2;
            const x = (pathX - cameraX) * projected - pointerX * proximity * .22;
            const y = -4 + Math.max(0, projected - .4) * 7 + bob * proximity * .16;
            arch.style.transform = `translate3d(calc(-50% + ${x.toFixed(2)}vw),${y.toFixed(2)}vh,0) scale(${projected.toFixed(3)})`;
            arch.style.opacity = visibility.toFixed(3);
            arch.style.filter = `brightness(${(.34 + proximity * .74).toFixed(2)}) blur(${Math.max(0, distance - 1200) / 520}px)`;
            arch.style.zIndex = String(10 + index);
          });
        }

        const pending = Math.abs(destination - progress) > 0.00012 || Math.abs(velocity) > 0.00004 || Math.abs(targetX - pointerX) > 0.0008 || Math.abs(targetY - pointerY) > 0.0008;
        if (fallbackMotion && pending && !document.hidden) sceneFrame = requestAnimationFrame(renderScene);
      };

      const scheduleScene = () => {
        readProgress();
        if (!sceneFrame) sceneFrame = requestAnimationFrame(renderScene);
      };

      const closeDrawer = (restore = true) => {
        if (!openProject) return;
        const previous = bottles.find((bottle) => bottle.dataset.projectBottle === openProject);
        openProject = "";
        root.classList.remove("is-drawer-open");
        drawer.setAttribute("aria-hidden", "true");
        bottles.forEach((bottle) => bottle.setAttribute("aria-expanded", "false"));
        root.querySelectorAll<HTMLElement>("[data-drawer-sheet]").forEach((sheet) => { sheet.hidden = true; });
        if (restore) previous?.focus({ preventScroll: true });
      };
      const openDrawer = (id: string, trigger: HTMLButtonElement) => {
        if (openProject === id) return closeDrawer();
        openProject = id;
        root.classList.add("is-drawer-open");
        drawer.setAttribute("aria-hidden", "false");
        bottles.forEach((bottle) => bottle.setAttribute("aria-expanded", String(bottle === trigger)));
        root.querySelectorAll<HTMLElement>("[data-drawer-sheet]").forEach((sheet) => { sheet.hidden = sheet.dataset.drawerSheet !== id; });
        setTimeout(() => closeButton?.focus({ preventScroll: true }), reduced && !forced ? 0 : 420);
      };

      bottles.forEach((bottle) => bottle.addEventListener("click", () => openDrawer(bottle.dataset.projectBottle || "", bottle), { signal }));
      closeButton?.addEventListener("click", () => closeDrawer(), { signal });
      document.addEventListener("keydown", (event) => { if (event.key === "Escape") closeDrawer(); }, { signal });
      if (fallbackMotion) addEventListener("scroll", scheduleScene, { passive: true, signal });
      if (fallbackMotion) {
        viewport.addEventListener("pointermove", (event) => {
          const rect = viewport.getBoundingClientRect();
          targetX = clamp((event.clientX - rect.left) / rect.width) * 2 - 1;
          targetY = clamp((event.clientY - rect.top) / rect.height) * 2 - 1;
          if (!sceneFrame) sceneFrame = requestAnimationFrame(renderScene);
        }, { passive: true, signal });
        viewport.addEventListener("pointerleave", () => {
          targetX = 0;
          targetY = 0;
          if (!sceneFrame) sceneFrame = requestAnimationFrame(renderScene);
        }, { signal });
      }

      readProgress();
      renderScene();
      root.dataset.vaultMotion = webglActive
        ? forced ? "forced-depth" : reduced ? "reduced-depth" : "depth"
        : fallbackMotion ? "fallback-depth" : reduced ? "reduced" : "static";

      cleanupActive = () => {
        if (sceneFrame) cancelAnimationFrame(sceneFrame);
        vaultWindow.__rainDustVault3D?.destroy();
        vaultWindow.__rainDustVault3D = undefined;
        closeDrawer(false);
      };
    };

    const startVault = () => { void initVault(); };
    document.addEventListener("astro:page-load", startVault, { signal: vaultBinding.signal });
    startVault();
  </script>

  <style>
    .vault {
      --vault-progress: 0;
      --camera-turn: 0;
      --camera-bob: 0px;
      --observer-x: 0;
      --observer-y: 0;
      --void: #0b0d0b;
      --signal: #8a3434;
      --ink: #26221c;
      position: relative;
      height: 840dvh;
      color: #d1ccc0;
      background: var(--void);
    }
    .vault-viewport {
      position: sticky;
      top: 0;
      isolation: isolate;
      width: 100%;
      height: 100dvh;
      overflow: hidden;
      perspective: 760px;
      perspective-origin: 50% 58%;
      background: radial-gradient(ellipse at 50% 42%, rgba(120,84,46,.14), transparent 31%), linear-gradient(180deg, #191c17, #0d100d 68%, #080a08);
    }
    .vault-webgl { position: absolute; inset: 0; z-index: 0; width: 100%; height: 100%; display: block; opacity: 0; transition: opacity .45s ease; }
    .vault-boot-screen {
      position: absolute;
      inset: 0;
      z-index: 32;
      display: grid;
      place-content: center;
      gap: 14px;
      color: #b9b0a0;
      background:
        radial-gradient(ellipse at 50% 48%, rgba(126, 83, 52, .18), transparent 32%),
        linear-gradient(180deg, #17130f, #0b0d0b 72%);
      font: 600 clamp(.62rem, 1vw, .78rem)/1.2 ui-monospace, "Cascadia Mono", Consolas, monospace;
      letter-spacing: .2em;
      text-align: center;
      opacity: 0;
      visibility: hidden;
      pointer-events: none;
      transition: opacity .36s ease, visibility 0s linear .36s;
    }
    .vault-boot-screen i {
      width: min(260px, 54vw);
      height: 1px;
      overflow: hidden;
      background: rgba(185, 176, 160, .16);
    }
    .vault-boot-screen i::after {
      content: "";
      display: block;
      width: 42%;
      height: 100%;
      background: linear-gradient(90deg, transparent, #9a4b48, transparent);
      animation: vault-calibrate 1.1s cubic-bezier(.4, 0, .2, 1) infinite;
    }
    .vault-boot-screen small { color: #6f685d; font-size: .5rem; letter-spacing: .17em; }
    .vault[data-vault-booting="true"] .vault-boot-screen {
      opacity: 1;
      visibility: visible;
      transition-delay: 0s;
    }
    @keyframes vault-calibrate { from { transform: translateX(-110%); } to { transform: translateX(340%); } }
    .vault[data-vault-booting="true"] :is(.vault-world,.vault-foreground,.vault-scenes,.vault-heading,.vault-depth-meter,.vault-instruction,.vault-archive-link) { visibility: hidden; pointer-events: none; }
    .vault-webgl-hud { position: absolute; z-index: 9; right: clamp(18px,3vw,48px); bottom: clamp(22px,4vh,50px); display: none; color: #aaa28e; font-family: ui-monospace,"Cascadia Mono",Consolas,monospace; text-align: right; letter-spacing: .12em; pointer-events: none; }
    .vault-webgl-hud span,.vault-webgl-hud small { display: block; } .vault-webgl-hud span { font-size: .65rem; } .vault-webgl-hud small { margin-top: 7px; color: #6f6c61; font-size: .48rem; }
    .vault-focus-card {
      --lens-u: 0;
      --lens-v: 0;
      position: fixed;
      z-index: 28;
      top: var(--lens-y, -240px);
      left: var(--lens-x, -240px);
      display: flex;
