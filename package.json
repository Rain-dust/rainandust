{
  "name": "rain-dust-portfolio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "npm run generate:assets && npm run check && astro build && node scripts/prepare-sites.mjs",
    "check": "astro check --tsconfig tsconfig.check.json --minimumSeverity error",
    "test": "node --test tests/*.test.ts",
    "preview": "astro preview",
    "blog:new": "node scripts/new-blog-post.mjs",
    "generate:assets": "node scripts/generate-assets.mjs",
    "optimize:images": "node scripts/optimize-images.mjs",
    "upload:images": "node scripts/upload-images-to-scdn.mjs"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.2",
    "@iconify-json/simple-icons": "^1.2.83",
    "@iconify-json/tabler": "^1.2.35",
    "astro": "^6.3.3",
    "astro-expressive-code": "^0.42.0",
    "astro-icon": "^1.1.5",
    "pagefind": "^1.5.2",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "three": "0.184.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "typescript": "5.9.2",
    "sharp": "^0.34.5"
  }
}
